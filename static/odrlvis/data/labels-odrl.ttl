odrl:systemDevice             rdfs:label "systeem of apparaat"@nl , "system device"@en .
odrl:timeInterval             rdfs:label "tijdsinterval"@nl , "time interval"@en .
odrl:unitOfCount              rdfs:label "teleenheid"@nl , "unit of count"@en .
