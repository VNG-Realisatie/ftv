# --- Operatoren --------------------------------------------------------------
# Letterlijk de zinwoorden uit viewer-bevroren/assets/i18n.js (`op.*`), zodat een
# operator in een voorwaarde-zin en als losse term hetzelfde woord krijgt.

odrl:eq                 rdfs:label "is gelijk aan"@nl , "equals"@en .
odrl:neq                rdfs:label "is niet gelijk aan"@nl , "does not equal"@en .
odrl:gt                 rdfs:label "is groter dan"@nl , "is greater than"@en .
odrl:gteq               rdfs:label "is groter dan of gelijk aan"@nl , "is greater than or equal to"@en .
odrl:lt                 rdfs:label "is kleiner dan"@nl , "is less than"@en .
odrl:lteq               rdfs:label "is kleiner dan of gelijk aan"@nl , "is less than or equal to"@en .
odrl:isA                rdfs:label "is een"@nl , "is a"@en .
odrl:hasPart            rdfs:label "bevat"@nl , "has part"@en .
odrl:isPartOf           rdfs:label "maakt deel uit van"@nl , "is part of"@en .
odrl:isAllOf            rdfs:label "is alle van"@nl , "is all of"@en .
odrl:isAnyOf            rdfs:label "is één van"@nl , "is any of"@en .
odrl:isNoneOf           rdfs:label "is geen van"@nl , "is none of"@en .

# Logische operatoren — de kopwoorden uit i18n.js (`logicalHead.*`).
odrl:and                rdfs:label "alle van"@nl , "all of"@en .
odrl:andSequence        rdfs:label "alle van, in volgorde"@nl , "all of, in order"@en .
odrl:or                 rdfs:label "één van"@nl , "any of"@en .
odrl:xone               rdfs:label "precies één van"@nl , "exactly one of"@en .

