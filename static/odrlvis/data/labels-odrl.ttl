odrl:virtualLocation          rdfs:label "virtuele locatie"@nl , "virtual location"@en .

# --- Conflict-, undefined- en statustermen -----------------------------------

odrl:perm               rdfs:label "toestemming gaat voor"@nl , "permission overrides"@en .
odrl:prohibit           rdfs:label "verbod gaat voor"@nl , "prohibition overrides"@en .
odrl:invalid            rdfs:label "beleid is ongeldig"@nl , "policy is void"@en .
odrl:support            rdfs:label "onbekende termen ondersteunen"@nl , "support undefined terms"@en .
