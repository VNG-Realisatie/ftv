odrl:count                    rdfs:label "aantal"@nl , "count"@en .
odrl:dateTime                 rdfs:label "tijdstip"@nl , "date and time"@en .
odrl:delayPeriod              rdfs:label "wachttijd"@nl , "delay period"@en .
odrl:deliveryChannel          rdfs:label "verstrekkingskanaal"@nl , "delivery channel"@en .
odrl:elapsedTime              rdfs:label "verstreken tijd"@nl , "elapsed time"@en .
odrl:event                    rdfs:label "gebeurtenis"@nl , "event"@en .
odrl:fileFormat               rdfs:label "bestandsformaat"@nl , "file format"@en .
odrl:industry                 rdfs:label "bedrijfstak"@nl , "industry"@en .
odrl:language                 rdfs:label "taal"@nl , "language"@en .
odrl:media                    rdfs:label "medium"@nl , "medium"@en .
odrl:meteredTime              rdfs:label "gemeten gebruiksduur"@nl , "metered time"@en .
odrl:payAmount                rdfs:label "bedrag"@nl , "pay amount"@en .
odrl:percentage               rdfs:label "percentage"@nl , "percentage"@en .
odrl:product                  rdfs:label "product"@nl , "product"@en .
odrl:purpose                  rdfs:label "doel"@nl , "purpose"@en .
odrl:recipient                rdfs:label "ontvanger"@nl , "recipient"@en .
odrl:relativePosition         rdfs:label "relatieve positie"@nl , "relative position"@en .
odrl:relativeSize             rdfs:label "relatieve grootte"@nl , "relative size"@en .
odrl:relativeSpatialPosition  rdfs:label "relatieve geografische positie"@nl , "relative spatial position"@en .
odrl:relativeTemporalPosition rdfs:label "relatieve tijdstip"@nl , "relative temporal position"@en .
odrl:resolution               rdfs:label "resolutie"@nl , "resolution"@en .
