            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain glo:waardedomein-naamtekst ;
    gd:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

glo:waardedomein-naamtekst a cdi:SubstantiveValueDomain ;
    rdfs:label "Waardedomein naamtekst"@nl , "Value domain name text"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "String" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Vrije tekst, ten hoogste 200 tekens, zoals in de registratie vastgelegd; diakritische tekens blijven staan." ;
              cdi:LanguageString-language "nl" ] ] ] .

glo:gegevensveld-voornamen a gd:Gegevensveld ;
    rdfs:label "veld voornamen"@nl , "field given names"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/gegevensveld-voornamen"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "voornamen" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout glo:tgm-brp-antwoord ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-maximumLength 200 ] .

glo:mapping-voornamen a cdi:VariableRelationship ;
    rdfs:label "Gegevenstypemapping voornamen"@nl , "Data type mapping given names"@en ;
