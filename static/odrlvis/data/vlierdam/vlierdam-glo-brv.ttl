        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 10: bouwjaar -------------------------------------------------------

globrv:gegevenstype-bouwjaar a gd:Gegevenstype ;
    rdfs:label "bouwjaar"@nl , "year of construction"@en ;
    skos:scopeNote "NOODZAAK — het bouwjaar geeft aan hoe lang een voertuig naar verwachting nog in de straat staat en of het tot een oudere generatie behoort met een lager laadvermogen; de raming loopt over een planhorizon van vijf jaar en moet die vervanging meenemen. Het jaartal is grof genoeg om over een adreseenheid niets te verraden."@nl ,
                   "NECESSITY — the year of construction indicates how long a vehicle is expected to remain in the street and whether it belongs to an older generation with lower charging power; the estimate runs over a five-year planning horizon and must take that replacement into account. The year is coarse enough to reveal nothing about an address unit."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-bouwjaar"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-BOUWJAAR-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "bouwjaar" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het jaar waarin het voertuig is gebouwd; alleen het jaartal, geen datum." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Integer" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-bouwjaar ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

globrv:waardedomein-bouwjaar a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein bouwjaar"@nl , "value domain of the year of construction"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Integer" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Vier cijfers, niet vóór 1990. Bewust alleen het jaartal: een datum van eerste toelating zou het voertuig binnen een adreseenheid vrijwel uniek maken." ;
              cdi:LanguageString-language "nl" ] ] ;
        cdi:ValueAndConceptDescription-regularExpression [
            cdi:TypedString-content "(199[0-9]|2[0-9]{3})" ;
            cdi:TypedString-typeOfContent [ cdi:ControlledVocabularyEntry-entryValue "XSD regular expression" ] ] ] .

globrv:gegevensveld-bouwjaar a gd:Gegevensveld ;
    rdfs:label "bouwjaar (veld)"@nl , "bouwjaar (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-bouwjaar"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "bouwjaar" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "integer" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-length 4 ] .

globrv:mapping-bouwjaar a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping bouwjaar"@nl ,
               "data type mapping of the year of construction"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-bouwjaar ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-bouwjaar ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- 6c. De tien mappingen in één structuur ---------------------------------

globrv:variabelestructuur-laadcapaciteit a cdi:VariableStructure ;
    rdfs:label "Variabelenstructuur leverset laadcapaciteit"@nl ,
               "Variable structure of the charging capacity delivery set"@en ;
    cdi:VariableStructure-purpose [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De gegevenstypemappingen tussen het logisch en het technisch gegevensmodel van de leverset." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:VariableStructure_structures_VariableCollection globrv:gegevensset-laadcapaciteit ;
    cdi:VariableStructure_has_VariableRelationship
        globrv:mapping-verblijfsobject , globrv:mapping-volgnummer ,
        globrv:mapping-aandrijving , globrv:mapping-batterijcapaciteit ,
        globrv:mapping-laadvermogen , globrv:mapping-aansluittype ,
        globrv:mapping-massa , globrv:mapping-lengte , globrv:mapping-breedte ,
        globrv:mapping-bouwjaar .

# -----------------------------------------------------------------------------
# 7. Weergavelabels voor de metadata-properties die dit bestand gebruikt en die
#    het gedeelde corpus nog niet benoemt (Visualisatie-note §1: labels horen in
#    dezelfde dataset als de data).
# -----------------------------------------------------------------------------

skos:scopeNote rdfs:label "noodzaak van dit gegevenstype"@nl ,
                          "necessity of this data type"@en .

# Het IANA-mediatype dat het gegevensmiddel aanhaalt, met een label zodat de
# viewer een naam kan tonen in plaats van de IRI.
<https://www.iana.org/assignments/media-types/text/csv>
    rdfs:label "text/csv"@nl , "text/csv"@en .

# WAT HIER BEWUST NIET STAAT. De labels van odrl:derive, odrl:anonymize,
# odrl:hasPolicy en dcat:distribution staan al in labels-odrl.ttl respectievelijk
# glo-vocabulaire.ttl, en de twee subklasse-axioma's van de DDI-CDI-componentrollen
# (cdi:IdentifierComponent en cdi:MeasureComponent onder
# cdi:DataStructureComponent) staan in glo-vocabulaire.ttl. Een tweede,
# afwijkende vertaling van dezelfde term is erger dan geen: zij laat twee koppen
# voor één begrip zien zonder te zeggen welke geldt.
