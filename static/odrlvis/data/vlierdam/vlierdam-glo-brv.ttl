# =============================================================================
# 5. De gegevensleveringsspecificatie — datasetniveau
# =============================================================================

globrv:gls-laadcapaciteit a gd:Gegevensleveringsspecificatie ;
    dct:identifier "GLS-RDW-VLD-2026-002" ;
    dct:title "GLS voertuigkenmerken laadcapaciteit Vlierdam"@nl ,
              "GLS vehicle characteristics for charging capacity Vlierdam"@en ;
    dct:description "De technische en semantische beschrijving van de kwartaallevering: populatie, begrippenkader en gegevenstypen, leverkanaal en bestandsvorm."@nl ,
                    "The technical and semantic description of the quarterly delivery: population, terminology and data types, delivery channel and file format."@en ;
    gd:populatiebeschrijving """Per kwartaal één regel voor elk stekkervoertuig
waarvan de houder op de peildatum staat ingeschreven op een verblijfsobject in
de gemeente Vlierdam. Stekkervoertuig betekent hier: een voertuig met een
aandrijving die aan een laadpunt kan worden opgeladen — volledig elektrisch of
plug-in hybride. Voertuigen zonder stekker vallen buiten de levering; zij
leggen geen beslag op laadcapaciteit en zijn voor het doel niet nodig.

De regel draagt het verblijfsobject en een volgnummer binnen dat
verblijfsobject, zodat meerdere voertuigen op één adreseenheid uit elkaar te
houden zijn. Het volgnummer wordt bij elke levering opnieuw toegekend en is
géén persistente voertuigidentificatie: twee leveringen zijn op voertuigniveau
niet aan elkaar te koppelen. Het aantal voertuigen per verblijfsobject volgt
uit het tellen van de regels en is daarom geen apart gegevenstype.

Wat er NIET in zit: kenteken, burgerservicenummer, naam, geboortedatum en elk
ander gegeven over de houder. De koppeling kenteken–houder–verblijfsobject is
bij de verstrekker gelegd en daarna losgelaten."""@nl ,
        """One row per quarter for each plug-in vehicle whose keeper is
registered on the reference date at a dwelling unit in the municipality of
Vlierdam. Plug-in vehicle here means: a vehicle with a drivetrain that can be
charged at a charging point — fully electric or plug-in hybrid. Vehicles
without a plug fall outside the delivery; they place no demand on charging
capacity and are not needed for the purpose.

The row carries the dwelling unit and a sequence number within that dwelling
unit, so that several vehicles at one address can be told apart. The sequence
number is reassigned with every delivery and is NOT a persistent vehicle
identification: two deliveries cannot be linked at vehicle level. The number of
vehicles per dwelling unit follows from counting the rows and is therefore not
a separate data type.

What is not in it: licence plate, citizen service number, name, date of birth
and any other datum about the keeper. The licence plate–keeper–dwelling unit
linkage is made at the provider and then released."""@en ;
    dct:conformsTo globrv:begrippenkader-laadcapaciteit , globrv:lgm-laadcapaciteit ;
    dprod:outputDataset globrv:leverset-laadcapaciteit ;
    gd:heeftAfspraak globrv:glsafspraak-herleidbaarheid ,
        globrv:glsafspraak-kwaliteit ;
    odrl:hasPolicy globrv:glo-brv-vlierdam-2026 ;
    gd:contactpersoon globrv:pif-okonkwo .

# De leverset: wat als één geheel wordt geleverd, en tegelijk het voorwerp van
# de regels hierboven (odrl:target). Één knoop, twee rollen — zoals het
# neutrale vocabulaire het bedoelt.
globrv:leverset-laadcapaciteit a gd:Gegevensleversetspecificatie , odrl:Asset ;
    rdfs:label "Leverset voertuigkenmerken laadcapaciteit Vlierdam"@nl ,
               "Delivery set of vehicle characteristics for charging capacity Vlierdam"@en ;
    dct:title "Leverset voertuigkenmerken laadcapaciteit Vlierdam"@nl ,
              "Delivery set of vehicle characteristics for charging capacity Vlierdam"@en ;
    dct:description "De kwartaalset: per stekkervoertuig op een Vlierdams verblijfsobject de tien technische kenmerken die de capaciteitsraming nodig heeft, zonder kenteken en zonder burgerservicenummer."@nl ,
                    "The quarterly set: for each plug-in vehicle at a Vlierdam dwelling unit, the ten technical characteristics the capacity estimate requires, without licence plate and without citizen service number."@en ;
    dct:conformsTo globrv:gls-laadcapaciteit ;
    dcat:distribution globrv:middel-csv ;
    # De gegevensfilterregel die de populatie afbakent, als verwijzing naar het
    # gegevenstype waarop wordt gefilterd; de regel zelf staat in de
    # populatiebeschrijving hierboven.
    gd:filtertOpGegevenstype globrv:gegevenstype-aandrijving ;
    gd:heeftAfspraak globrv:leversetafspraak-bewaartermijn ,
        globrv:leversetafspraak-toegangsgerechtigden ;
    # DE CLASSIFICATIE IS BEWUST DE VOORZICHTIGE. Geen enkel gegevenstype in
    # deze leverset is op zichzelf een persoonsgegeven — dat staat hieronder op
    # de gegevenstypen zelf. De SET is wel als "bevat persoonsgegevens"
    # geclassificeerd, omdat de combinatie van een adreseenheid met een klein
    # aantal voertuigkenmerken naar een huishouden kan wijzen. Dat contrast is
    # geen slordigheid maar de kern van de afweging: minimalisatie verplaatst
    # het risico van het veld naar de combinatie, en daarom hangt aan deze set
    # een herleidingsverbod, een bewaartermijn en een kring van
    # toegangsgerechtigden. Wat er níét bij staat is
    # bevat-nationale-identificatienummers: het burgerservicenummer is er
    # nadrukkelijk uit gelaten.
    gd:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens ,
        gdc:biv-beschikbaarheid\/laag ,
        gdc:biv-integriteit\/midden ,
        gdc:biv-vertrouwelijkheid\/midden ,
        gdc:bbn\/bbn2 ,
        gdc:verantwoordingsbelang\/ja-moet-tijdelijk-worden-bewaard ;
    dct:accessRights gdc:rubriceringsniveau\/intern .

# HET GEGEVENSMIDDEL EN DE FYSIEKE DATASET ZIJN ÉÉN KNOOP: aan de DPROD-kant
# de distributie van de leverset, aan de DDI-CDI-kant het bestand dat de
# gegevensvelden draagt. Zo vult de veldenrij van het gegevensmiddelformulier
# zich, en hoeft een lezer niet eerst te raden dat twee IRI's hetzelfde bestand
# beschrijven.
globrv:middel-csv a gd:Gegevensmiddelspecificatie , cdi:PhysicalDataSet ;
    rdfs:label "Kwartaalbestand (CSV)"@nl , "Quarterly file (CSV)"@en ;
    dct:title "Kwartaalbestand voertuigkenmerken (CSV)"@nl ,
              "Quarterly file of vehicle characteristics (CSV)"@en ;
    dct:identifier "GM-LAADCAPACITEIT-CSV-001" ;
    dct:description "Eén CSV-bestand per kwartaal, met een regel per stekkervoertuig en tien kolommen; geen kolom draagt een persoonsidentificator."@nl ,
                    "One CSV file per quarter, with a row per plug-in vehicle and ten columns; no column carries a personal identifier."@en ;
    dct:format "text/csv" ;
    # dcat:mediaType wijst naar een IANA-mediatype als IRI, niet naar de
    # tekenreeks: DCAT geeft de eigenschap het bereik dct:MediaType. Tot deze
    # ronde stond hier een letterlijke "text/csv", terwijl vlierdam-glo.ttl
    # voor JSON al de IRI gebruikte — twee schrijfwijzen voor hetzelfde
    # kenmerk in twee bestanden van dezelfde set. Dit is geen conformiteitseis
    # (deze bestanden claimen geen toepassingsprofiel) maar kale DCAT, en de
    # viewer kan de IRI van een label voorzien waar zij een tekenreeks alleen
    # kan afdrukken.
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dct:conformsTo globrv:tgm-laadcapaciteit ;
    cdi:PhysicalDataSet-physicalFileName "laadcapaciteit-vlierdam-JJJJKK.csv" ;
    cdi:PhysicalDataSet_has_InstanceVariable
        globrv:gegevensveld-verblijfsobject ,
        globrv:gegevensveld-volgnummer ,
        globrv:gegevensveld-aandrijving ,
        globrv:gegevensveld-batterijcapaciteit ,
        globrv:gegevensveld-laadvermogen ,
        globrv:gegevensveld-aansluittype ,
        globrv:gegevensveld-massa ,
        globrv:gegevensveld-lengte ,
        globrv:gegevensveld-breedte ,
        globrv:gegevensveld-bouwjaar ;
    gd:heeftAfspraak globrv:middelafspraak-initiatie ,
        globrv:middelafspraak-frequentie ,
        globrv:middelafspraak-wijze-van-leveren .

# --- De afspraken op de drie niveaus -----------------------------------------

globrv:glsafspraak-herleidbaarheid a odrl:Duty , gd:glsafspraak ;
    dct:title "Maatregelen tegen herleidbaarheid"@nl ,
              "Measures against re-identification"@en ;
    dct:description "De verstrekker laat kenteken en burgerservicenummer uit de leverset voordat zij wordt verstuurd, en kent het voertuigvolgnummer per levering opnieuw toe. De ontvanger bewaart de leverset gescheiden van de basisregistratie personen en van het zaaksysteem, en publiceert uitkomsten niet fijner dan op buurtniveau."@nl ,
                    "The provider drops the licence plate and citizen service number from the delivery set before it is sent, and reassigns the vehicle sequence number for each delivery. The recipient keeps the delivery set separate from the population register and from the case system, and publishes results at no finer level than the neighbourhood."@en ;
    dct:subject gdglsonderwerp:maatregelen-herleidbaarheid ;
    odrl:assignee vlierdam:RDW , vlierdam:GemeenteVlierdam ;
    odrl:action odrl:anonymize .

globrv:glsafspraak-kwaliteit a odrl:Duty , gd:glsafspraak ;
    dct:title "Gegevenskwaliteit"@nl , "Data quality"@en ;
    dct:description "Een voertuigkenmerk dat bij de verstrekker niet bekend is blijft leeg; de verstrekker vult geen geschatte waarde in. De ontvanger telt een lege waarde niet als nul mee in de raming."@nl ,
                    "A vehicle characteristic that is unknown at the provider is left empty; the provider does not fill in an estimated value. The recipient does not count an empty value as zero in the estimate."@en ;
    dct:subject gdglsonderwerp:gegevenskwaliteit ;
    odrl:assignee vlierdam:RDW , vlierdam:GemeenteVlierdam ;
    odrl:action odrl:inform .

globrv:leversetafspraak-bewaartermijn a odrl:Duty , gd:leversetafspraak ;
    dct:title "Bewaartermijn van de leverset"@nl ,
              "Retention period of the delivery set"@en ;
    dct:description "Een leverset wordt achttien maanden bewaard, of korter als de raming van de planronde eerder is vastgesteld. De uitkomst van de raming valt buiten deze termijn."@nl ,
                    "A delivery set is retained for eighteen months, or less if the estimate for the planning round has been adopted earlier. The outcome of the estimate falls outside this period."@en ;
    dct:subject gdglsonderwerp:bewaartermijnen ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    odrl:action odrl:delete .

globrv:leversetafspraak-toegangsgerechtigden a odrl:Duty , gd:leversetafspraak ;
    dct:title "Toegangsgerechtigden"@nl , "Authorised users"@en ;
    dct:description "Alleen de medewerkers van het team Mobiliteit die aan de capaciteitsraming werken hebben toegang tot de leverset. Toegang wordt per planronde verleend en daarna ingetrokken."@nl ,
                    "Only the employees of the Mobility team working on the capacity estimate have access to the delivery set. Access is granted per planning round and withdrawn afterwards."@en ;
    dct:subject gdglsonderwerp:toegangsgerechtigden ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    odrl:action odrl:inform .

# DE LEVERINGSVORM, neutraal gespiegeld. Het informatiemodel kent de initiatie
# en de frequentie als onderwerpen van een gegevensmiddelafspraak, niet als een
# eigen klasse — dus staan zij hier als afspraak en niet als nieuw begrip.
#
# PUSH OF PULL IS EEN EIGENSCHAP VAN DE AFSPRAAK, NIET VAN DE KLASSEN. Geen van
# de klassen van het gespiegelde vocabulaire veronderstelt een bevraging: een
# overeenkomst, een specificatie, een leverset en een veldenlaag zien er bij een
# push net zo uit als bij een pull. Dat is in dit corpus nu ook aantoonbaar —
# vlierdam-glo.ttl beschrijft met dezelfde klassen een bevraging per aanvraag,
# dit bestand een periodieke levering, en het verschil zit uitsluitend in
# gdglsonderwerp:gegevensleveringsinitiatie hieronder.
globrv:middelafspraak-initiatie a odrl:Duty , gd:middelafspraak ;
    dct:title "Levering op initiatief van de verstrekker (push)"@nl ,
              "Delivery on the provider's initiative (push)"@en ;
    dct:description "De verstrekker stelt de leverset uit eigen beweging samen en verstuurt haar; de ontvanger doet geen bevraging. Er is voor deze levering dus ook geen verzoek waarin de ontvanger een zoeksleutel of een doel meegeeft."@nl ,
                    "The provider compiles and sends the delivery set on its own initiative; the recipient does not query. For this delivery there is therefore no request in which the recipient supplies a search key or a purpose."@en ;
    dct:subject gdglsonderwerp:gegevensleveringsinitiatie ;
    odrl:assignee vlierdam:RDW ;
    odrl:action odrl:distribute .

globrv:middelafspraak-frequentie a odrl:Duty , gd:middelafspraak ;
    dct:title "Leverfrequentie: elk kwartaal"@nl ,
              "Delivery frequency: quarterly"@en ;
    dct:description "Vier leveringen per jaar, met de eerste dag van het kwartaal als peildatum. Periodiek en niet gebeurtenisgedreven: een capaciteitsraming volgt de beleidscyclus, en een levering per voertuigmutatie zou zowel meer gegevens opleveren als een tijdlijn per adreseenheid tekenen."@nl ,
                    "Four deliveries a year, with the first day of the quarter as reference date. Periodic rather than event-driven: a capacity estimate follows the policy cycle, and a delivery per vehicle change would both yield more data and draw a timeline per dwelling unit."@en ;
    dct:subject gdglsonderwerp:gegevensleveringsfrequentie ;
    odrl:assignee vlierdam:RDW ;
    odrl:action odrl:distribute ;
    dprod:recurrence "FREQ=YEARLY;BYMONTH=1,4,7,10;BYMONTHDAY=1" .

globrv:middelafspraak-wijze-van-leveren a odrl:Duty , gd:middelafspraak ;
    dct:title "Wijze van leveren"@nl , "Method of delivery"@en ;
    dct:description "Het kwartaalbestand gaat als CSV over het koppelvlak van het afsprakenstelsel naar de inway van de gemeente; de levering draagt dezelfde trace-identificatie als elke andere uitwisseling over dat koppelvlak."@nl ,
                    "The quarterly file is sent as CSV over the interface of the agreement framework to the municipality's inway; the delivery carries the same trace identifier as any other exchange over that interface."@en ;
    dct:subject gdglsonderwerp:wijze-van-leveren ;
    odrl:assignee vlierdam:RDW ;
    odrl:action odrl:distribute .

# =============================================================================
# 6. De gegevensleveringsspecificatie — veldenlaag (DDI-CDI)
#
# HIER IS DE MINIMALISATIE TE ZIEN IN PLAATS VAN TE LEZEN. Tien gegevenstypen,
# en geen ervan is een persoonsidentificator. Wie in de viewer de GLS-vouw
# openklapt en doorloopt naar de gegevensset, ziet de hele leverset op een rij
# staan: een verblijfsobject, een volgnummer, en acht technische kenmerken van
# een auto.
#
# Elk gegevenstype draagt een NOODZAAK in skos:scopeNote: waarom is dít veld
# nodig voor een capaciteitsraming. Dat is geen profieleis maar een keuze van
# dit voorbeeld — de noodzaakbeoordeling van de overeenkomst krijgt zo een
# tegenhanger per veld, op de korrel waar de discussie werkelijk wordt gevoerd.
#
# De opzet volgt de cascade van het informatiemodel: gegevenstype
# (cdi:RepresentedVariable) met waardedomein, gegevensveld
# (cdi:InstanceVariable) met de fysieke vorm, en de gegevenstypemapping
# (cdi:VariableRelationship) ertussen. De structuurlaag eromheen is een brede
# datastructuur met een component per gegevenstype.
# =============================================================================

# --- 6a. Structuur -----------------------------------------------------------

globrv:lgm-laadcapaciteit a gd:LogischGegevensmodel , cdi:WideDataStructure ;
    rdfs:label "Logisch gegevensmodel leverset laadcapaciteit"@nl ,
               "Logical data model of the charging capacity delivery set"@en ;
    cdi:DataStructure_has_DataStructureComponent
        globrv:component-verblijfsobject ,
        globrv:component-volgnummer ,
        globrv:component-aandrijving ,
        globrv:component-batterijcapaciteit ,
        globrv:component-laadvermogen ,
        globrv:component-aansluittype ,
        globrv:component-massa ,
        globrv:component-lengte ,
        globrv:component-breedte ,
        globrv:component-bouwjaar .

# De twee identificerende componenten: samen sleutelen zij de regel. Dat de
# sleutel uit een adreseenheid en een leveringsgebonden volgnummer bestaat — en
# niet uit een kenteken — is de hele casus in één regel.
globrv:component-verblijfsobject a cdi:IdentifierComponent ;
    cdi:DataStructureComponent-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/component-verblijfsobject"^^xsd:anyURI ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-verblijfsobject .

globrv:component-volgnummer a cdi:IdentifierComponent ;
    cdi:DataStructureComponent-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/component-volgnummer"^^xsd:anyURI ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-volgnummer .

globrv:component-aandrijving a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "aandrijving" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-aandrijving .

globrv:component-batterijcapaciteit a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "batterijcapaciteitKwh" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-batterijcapaciteit .

globrv:component-laadvermogen a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "maximaalLaadvermogenKw" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-laadvermogen .

globrv:component-aansluittype a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "aansluittype" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-aansluittype .

globrv:component-massa a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "massaRijklaarKg" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-massa .

globrv:component-lengte a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "lengteMm" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-lengte .

globrv:component-breedte a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "breedteMm" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-breedte .

globrv:component-bouwjaar a cdi:MeasureComponent ;
    cdi:MeasureComponent-name [ cdi:ObjectName-name "bouwjaar" ] ;
    cdi:DataStructureComponent_isDefinedBy_RepresentedVariable globrv:gegevenstype-bouwjaar .

globrv:gegevensset-laadcapaciteit a gd:Gegevensset ;
    rdfs:label "Gegevensset voertuigkenmerken laadcapaciteit"@nl ,
               "Data set of vehicle characteristics for charging capacity"@en ;
    cdi:VariableCollection-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensset-laadcapaciteit"^^xsd:anyURI ] ;
    cdi:VariableCollection-name [ cdi:ObjectName-name "GST-LAADCAPACITEIT-001" ] ;
    cdi:VariableCollection-purpose [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De tien gegevenstypen die samen een regel van de kwartaallevering vormen. Geen ervan identificeert een persoon." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:VariableCollection_has_ConceptualVariable
        globrv:gegevenstype-verblijfsobject ,
        globrv:gegevenstype-volgnummer ,
        globrv:gegevenstype-aandrijving ,
        globrv:gegevenstype-batterijcapaciteit ,
        globrv:gegevenstype-laadvermogen ,
        globrv:gegevenstype-aansluittype ,
        globrv:gegevenstype-massa ,
        globrv:gegevenstype-lengte ,
        globrv:gegevenstype-breedte ,
        globrv:gegevenstype-bouwjaar .

globrv:record-voertuig a cdi:LogicalRecord ;
    rdfs:label "Regel: één stekkervoertuig op een verblijfsobject"@nl ,
               "Row: one plug-in vehicle at a dwelling unit"@en ;
    cdi:LogicalRecord-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/record-voertuig"^^xsd:anyURI ] ;
    cdi:LogicalRecord_has_InstanceVariable
        globrv:gegevensveld-verblijfsobject ,
        globrv:gegevensveld-volgnummer ,
        globrv:gegevensveld-aandrijving ,
        globrv:gegevensveld-batterijcapaciteit ,
        globrv:gegevensveld-laadvermogen ,
        globrv:gegevensveld-aansluittype ,
        globrv:gegevensveld-massa ,
        globrv:gegevensveld-lengte ,
        globrv:gegevensveld-breedte ,
        globrv:gegevensveld-bouwjaar .

globrv:tgm-laadcapaciteit a gd:TechnischGegevensmodel , cdi:PhysicalSegmentLayout ;
    rdfs:label "Technisch gegevensmodel kwartaalbestand"@nl ,
               "Technical data model of the quarterly file"@en ;
    cdi:PhysicalSegmentLayout-name [ cdi:ObjectName-name "TGM-LAADCAPACITEIT-001" ] ;
    cdi:PhysicalSegmentLayout-encoding "UTF-8" ;
    cdi:PhysicalSegmentLayout_formats_LogicalRecord globrv:record-voertuig .

# DE EENHEID WAAROVER GEMETEN WORDT is het voertuig, niet de houder. Dat is bij
# een DDI-CDI-cascade een verplichte keuze op het conceptuele niveau, en zij
# valt hier precies samen met de minimalisatie: er is in deze leverset geen
# natuurlijk persoon om over te meten.
globrv:unittype-voertuig a cdi:UnitType ;
    rdfs:label "stekkervoertuig op een verblijfsobject"@nl ,
               "plug-in vehicle at a dwelling unit"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "stekkervoertuig" ] ;
    cdi:UnitType-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het voertuig waarover de regel gaat, geplaatst op de adreseenheid van zijn houder. De houder zelf is geen eenheid in deze levering." ;
          cdi:LanguageString-language "nl" ] ] .

globrv:begrippenkader-laadcapaciteit a gd:Begrippenkader ;
    rdfs:label "Begrippenkader laadcapaciteit"@nl ,
               "Terminology for charging capacity"@en ;
    dct:title "Begrippenkader van de leverset laadcapaciteit"@nl ,
              "Terminology of the charging capacity delivery set"@en ;
    skos:hasTopConcept globrv:term-verblijfsobject , globrv:term-stekkervoertuig .

globrv:term-verblijfsobject a gd:Term ;
    skos:inScheme globrv:begrippenkader-laadcapaciteit ;
    skos:prefLabel "verblijfsobject"@nl , "dwelling unit"@en ;
    rdfs:label "verblijfsobject"@nl , "dwelling unit"@en ;
    skos:definition "De kleinste binnen één of meer panden gelegen eenheid die functioneel zelfstandig is en een eigen toegang heeft; in dit voorbeeld de adreseenheid waarop een voertuig wordt geplaatst."@nl ,
                    "The smallest functionally independent unit within one or more buildings, with its own entrance; in this example the address unit at which a vehicle is placed."@en .

globrv:term-stekkervoertuig a gd:Term ;
    skos:inScheme globrv:begrippenkader-laadcapaciteit ;
    skos:prefLabel "stekkervoertuig"@nl , "plug-in vehicle"@en ;
    rdfs:label "stekkervoertuig"@nl , "plug-in vehicle"@en ;
    skos:definition "Een voertuig dat aan een laadpunt kan worden opgeladen: volledig elektrisch of plug-in hybride."@nl ,
                    "A vehicle that can be charged at a charging point: fully electric or plug-in hybrid."@en .

# --- 6b. De tien gegevenstypen, elk met hun veld en hun mapping --------------
#
# De rdfs:label op deze knopen is een weergavelabel voor de viewer: naam en
# beschrijving zitten in DDI-CDI achter een gestructureerd datatype en zijn
# daarmee één hop te diep voor het formulier. Zonder label toont de kaart een
# IRI-staart; met label toont zij waar het veld over gaat. Het label vervangt
# de cdi:Concept-name niet, het staat ernaast.
#
# ELK GEGEVENSTYPE DRAAGT "bevat geen persoonsgegevens", DE SET DRAAGT "bevat
# persoonsgegevens". Dat is geen tegenspraak maar de hele afweging in twee
# regels: los is een batterijcapaciteit of een voertuigbreedte geen gegeven
# over een persoon, en de verblijfsobject-identificatie is een gegeven over een
# gebouw. Wat er wél is, ontstaat pas in de combinatie — en die staat op de
# leverset geclassificeerd, met het herleidingsverbod ernaast. Minimalisatie
# haalt het risico uit de velden; zij haalt het niet uit de samenstelling.
#
# Waar de noodzaak van een veld staat: in skos:scopeNote op het gegevenstype,
# beginnend met "NOODZAAK —". Het gespiegelde vocabulaire kent daar geen eigen
# term voor (de noodzaakbeoordeling hangt in het model aan de overeenkomst, niet
# aan een gegevenstype), en een eigen term munten zou dit voorbeeld tot
# vocabulaire-uitbreiding maken. skos:scopeNote zegt precies wat het is: de
# reikwijdte waarbinnen dit begrip in deze deling gebruikt wordt.

# --- veld 1: verblijfsobject-identificatie ----------------------------------

globrv:gegevenstype-verblijfsobject a gd:Gegevenstype ;
    rdfs:label "verblijfsobject-identificatie"@nl , "dwelling unit identification"@en ;
    skos:scopeNote "NOODZAAK — de laadbehoefte wordt per straatsegment geraamd en de netaansluiting wordt per adreseenheid aangelegd; zonder deze identificatie is de raming alleen op gemeenteniveau te maken en daarmee onbruikbaar voor de plaatsing."@nl ,
                   "NECESSITY — charging demand is estimated per street segment and the grid connection is installed per address unit; without this identification the estimate can only be made at municipal level and is therefore useless for installation."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-verblijfsobject"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-VBO-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "verblijfsobject-identificatie" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De identificatie van de adreseenheid waarop het voertuig staat, volgens de basisregistratie adressen en gebouwen." ;
          cdi:LanguageString-language "nl" ] ] ;
    # Twee keer dezelfde verwijzing: als DDI-CDI-referentiedatatype (zoals de
    # serialisatie het bedoelt) en als rechtstreekse IRI, zodat de
    # termverwijzing in de weergave een doorklikbare rij wordt — de blanke
    # referentieknoop ligt daarvoor één hop te diep.
    cdi:Concept-externalDefinition [ cdi:Reference-uri "https://vlierdam.example/glo/brv/term-verblijfsobject"^^xsd:anyURI ] ,
        globrv:term-verblijfsobject ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "String" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-verblijfsobject .

globrv:waardedomein-verblijfsobject a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein verblijfsobject-identificatie"@nl ,
               "value domain of the dwelling unit identification"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "String" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Zestien cijfers: vier cijfers gemeentecode, twee cijfers objecttype, tien cijfers volgnummer." ;
              cdi:LanguageString-language "nl" ] ] ;
        cdi:ValueAndConceptDescription-regularExpression [
            cdi:TypedString-content "[0-9]{16}" ;
            cdi:TypedString-typeOfContent [ cdi:ControlledVocabularyEntry-entryValue "XSD regular expression" ] ] ] .

globrv:gegevensveld-verblijfsobject a gd:Gegevensveld ;
    rdfs:label "verblijfsobjectIdentificatie (veld)"@nl ,
               "verblijfsobjectIdentificatie (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-verblijfsobject"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "verblijfsobjectIdentificatie" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired true ;
        cdi:ValueMapping-length 16 ;
        cdi:ValueMapping-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ] .

globrv:mapping-verblijfsobject a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping verblijfsobject-identificatie"@nl ,
               "data type mapping of the dwelling unit identification"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-verblijfsobject ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-verblijfsobject ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 2: voertuigvolgnummer ---------------------------------------------

globrv:gegevenstype-volgnummer a gd:Gegevenstype ;
    rdfs:label "voertuigvolgnummer binnen het verblijfsobject"@nl ,
               "vehicle sequence number within the dwelling unit"@en ;
    skos:scopeNote "NOODZAAK — op een adreseenheid kunnen meerdere stekkervoertuigen staan; zonder volgnummer zouden hun kenmerken in één regel samenvallen en zou de gelijktijdige laadvraag niet te berekenen zijn. Het nummer wordt per levering opnieuw toegekend en is daarom géén persistente voertuigidentificatie — het kenteken, dat dat wél zou zijn, wordt juist niet geleverd."@nl ,
                   "NECESSITY — several plug-in vehicles may be present at one address unit; without a sequence number their characteristics would collapse into a single row and simultaneous charging demand could not be calculated. The number is reassigned for each delivery and is therefore NOT a persistent vehicle identification — the licence plate, which would be one, is deliberately not delivered."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-volgnummer"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-VOLGNR-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "voertuigvolgnummer" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Een nummer dat de voertuigen op één verblijfsobject binnen dezelfde levering onderscheidt; bij elke levering opnieuw toegekend." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Integer" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-volgnummer .

globrv:waardedomein-volgnummer a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein voertuigvolgnummer"@nl ,
               "value domain of the vehicle sequence number"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Integer" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Een geheel getal vanaf 1, oplopend binnen het verblijfsobject." ;
              cdi:LanguageString-language "nl" ] ] ] .

globrv:gegevensveld-volgnummer a gd:Gegevensveld ;
    rdfs:label "voertuigVolgnummer (veld)"@nl , "voertuigVolgnummer (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-volgnummer"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "voertuigVolgnummer" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "integer" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired true ;
        cdi:ValueMapping-maximumLength 2 ] .

globrv:mapping-volgnummer a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping voertuigvolgnummer"@nl ,
               "data type mapping of the vehicle sequence number"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-volgnummer ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-volgnummer ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 3: aandrijving (categorisch, en tevens de filtergrootheid) --------

globrv:gegevenstype-aandrijving a gd:GegevenstypeCategorisch ;
    rdfs:label "aandrijving"@nl , "drivetrain"@en ;
    skos:scopeNote "NOODZAAK — een volledig elektrisch voertuig en een plug-in hybride vragen een verschillende hoeveelheid energie per etmaal en laden met verschillende profielen; de raming telt ze niet als gelijk. Dit gegevenstype is bovendien de grootheid waarop de populatie is gefilterd: voertuigen zonder stekker worden niet geleverd."@nl ,
                   "NECESSITY — a fully electric vehicle and a plug-in hybrid require different amounts of energy per day and charge with different profiles; the estimate does not count them as equal. This data type is also the variable on which the population is filtered: vehicles without a plug are not delivered."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-aandrijving"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-AANDRIJVING-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "aandrijving" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De wijze waarop het voertuig wordt aangedreven, voor zover die bepaalt hoe het aan een laadpunt laadt." ;
          cdi:LanguageString-language "nl" ] ] ;
    # Twee keer dezelfde verwijzing: als DDI-CDI-referentiedatatype (zoals de
    # serialisatie het bedoelt) en als rechtstreekse IRI, zodat de
    # termverwijzing in de weergave een doorklikbare rij wordt — de blanke
    # referentieknoop ligt daarvoor één hop te diep.
    cdi:Concept-externalDefinition [ cdi:Reference-uri "https://vlierdam.example/glo/brv/term-stekkervoertuig"^^xsd:anyURI ] ,
        globrv:term-stekkervoertuig ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Categorical" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-aandrijving .

globrv:waardedomein-aandrijving a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein aandrijving"@nl , "value domain of the drivetrain"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "String" ] ;
    cdi:SubstantiveValueDomain_takesValuesFrom_EnumerationDomain globrv:codelijst-aandrijving .

globrv:codelijst-aandrijving a cdi:CodeList ;
    rdfs:label "codelijst aandrijving"@nl , "drivetrain code list"@en ;
    cdi:EnumerationDomain-name [ cdi:ObjectName-name "aandrijvingen" ] ;
    cdi:CodeList_has_Code globrv:code-bev , globrv:code-phev ;
    cdi:EnumerationDomain_references_CategorySet globrv:categorieen-aandrijving .

globrv:code-bev a cdi:Code ;
    rdfs:label "code BEV"@nl , "code BEV"@en ;
    cdi:Code_denotes_Category globrv:categorie-bev ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "BEV" ] ] .

globrv:code-phev a cdi:Code ;
    rdfs:label "code PHEV"@nl , "code PHEV"@en ;
    cdi:Code_denotes_Category globrv:categorie-phev ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "PHEV" ] ] .

globrv:categorieen-aandrijving a cdi:CategorySet ;
    rdfs:label "categorieën aandrijving"@nl , "drivetrain categories"@en ;
    cdi:ConceptSystem-name [ cdi:ObjectName-name "aandrijvingCategorieen" ] ;
    cdi:CategorySet_has_Category globrv:categorie-bev , globrv:categorie-phev .

globrv:categorie-bev a cdi:Category ;
    rdfs:label "volledig elektrisch"@nl , "fully electric"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "volledigElektrisch" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het voertuig rijdt uitsluitend op elektriciteit uit de accu." ; cdi:LanguageString-language "nl" ] ] .

globrv:categorie-phev a cdi:Category ;
    rdfs:label "plug-in hybride"@nl , "plug-in hybrid"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "plugInHybride" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het voertuig heeft naast de accu een verbrandingsmotor en kan aan een laadpunt worden opgeladen." ; cdi:LanguageString-language "nl" ] ] .

globrv:gegevensveld-aandrijving a gd:Gegevensveld ;
    rdfs:label "aandrijving (veld)"@nl , "aandrijving (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-aandrijving"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "aandrijving" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired true ;
        cdi:ValueMapping-maximumLength 4 ] .

globrv:mapping-aandrijving a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping aandrijving"@nl ,
               "data type mapping of the drivetrain"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-aandrijving ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-aandrijving ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 4: batterijcapaciteit ---------------------------------------------

globrv:gegevenstype-batterijcapaciteit a gd:Gegevenstype ;
    rdfs:label "batterijcapaciteit (kWh)"@nl , "battery capacity (kWh)"@en ;
    skos:scopeNote "NOODZAAK — de energie die een voertuig per laadsessie afneemt is rechtstreeks een functie van de accu-inhoud; zonder dit gegevenstype is de energievraag per adreseenheid niet te ramen en blijft alleen een telling van voertuigen over."@nl ,
                   "NECESSITY — the energy a vehicle draws per charging session is a direct function of the battery size; without this data type the energy demand per address unit cannot be estimated and only a count of vehicles remains."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-batterijcapaciteit"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-ACCU-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "batterijcapaciteit" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De bruikbare energie-inhoud van de tractiebatterij, in kilowattuur." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Decimal" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-batterijcapaciteit ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

globrv:waardedomein-batterijcapaciteit a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein batterijcapaciteit"@nl ,
               "value domain of the battery capacity"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Decimal" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Kilowattuur, één decimaal, groter dan nul." ; cdi:LanguageString-language "nl" ] ] ;
        cdi:ValueAndConceptDescription-formatPattern [ cdi:ControlledVocabularyEntry-entryValue "###0.0" ] ] .

# Eén sentinel-domein voor alle kenmerken die bij de verstrekker kunnen
# ontbreken. De scheiding substantive/sentinel is de kern van de
# DDI-CDI-waardetypering: geldige waarden en ontbrekendwaarden zijn twee
# domeinen, niet één lijst met uitzonderingen.
globrv:waardedomein-onbekend a cdi:SentinelValueDomain ;
    rdfs:label "waardedomein voor ontbrekende kenmerken"@nl ,
               "value domain for missing characteristics"@en ;
    cdi:SentinelValueDomain_takesValuesFrom_EnumerationDomain globrv:codelijst-onbekend .

globrv:codelijst-onbekend a cdi:CodeList ;
    rdfs:label "codelijst ontbrekendwaarden"@nl , "missing value code list"@en ;
    cdi:EnumerationDomain-name [ cdi:ObjectName-name "ontbrekendwaarden" ] ;
    cdi:CodeList_has_Code globrv:code-onbekend ;
    cdi:EnumerationDomain_references_CategorySet globrv:categorieen-onbekend .

globrv:code-onbekend a cdi:Code ;
    rdfs:label "code onbekend"@nl , "code unknown"@en ;
    cdi:Code_denotes_Category globrv:categorie-onbekend ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "" ] ] .

globrv:categorieen-onbekend a cdi:CategorySet ;
    rdfs:label "categorieën ontbrekendwaarde"@nl , "missing value categories"@en ;
    cdi:ConceptSystem-name [ cdi:ObjectName-name "ontbrekendwaardeCategorieen" ] ;
    cdi:CategorySet_has_Category globrv:categorie-onbekend .

globrv:categorie-onbekend a cdi:Category ;
    rdfs:label "onbekend"@nl , "unknown"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "onbekend" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het kenmerk is bij de verstrekker niet bekend; het veld blijft leeg en telt in de raming niet als nul mee." ;
          cdi:LanguageString-language "nl" ] ] .

globrv:gegevensveld-batterijcapaciteit a gd:Gegevensveld ;
    rdfs:label "batterijcapaciteitKwh (veld)"@nl , "batterijcapaciteitKwh (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-batterijcapaciteit"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "batterijcapaciteitKwh" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "decimal" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-format [ cdi:ControlledVocabularyEntry-entryValue "###0.0" ] ] .

globrv:mapping-batterijcapaciteit a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping batterijcapaciteit"@nl ,
               "data type mapping of the battery capacity"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-batterijcapaciteit ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-batterijcapaciteit ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 5: maximaal laadvermogen ------------------------------------------

globrv:gegevenstype-laadvermogen a gd:Gegevenstype ;
    rdfs:label "maximaal laadvermogen (kW)"@nl , "maximum charging power (kW)"@en ;
    skos:scopeNote "NOODZAAK — de capaciteit van een netaansluiting wordt bepaald door het gelijktijdige VERMOGEN, niet door de energie per etmaal; dit is daarmee de maatgevende grootheid van de hele raming. Het gaat om het wisselstroomvermogen aan een laadpunt, niet om snelladen."@nl ,
                   "NECESSITY — the capacity of a grid connection is determined by simultaneous POWER, not by energy per day; this is therefore the decisive variable of the whole estimate. It concerns alternating current power at a charging point, not fast charging."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-laadvermogen"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-LAADVERMOGEN-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "maximaal laadvermogen" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het hoogste wisselstroomvermogen waarmee het voertuig aan een laadpunt kan laden, in kilowatt." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Decimal" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-laadvermogen ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

globrv:waardedomein-laadvermogen a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein laadvermogen"@nl , "value domain of the charging power"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Decimal" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Kilowatt, één decimaal; in de praktijk tussen 2,3 en 22,0." ; cdi:LanguageString-language "nl" ] ] ;
        cdi:ValueAndConceptDescription-formatPattern [ cdi:ControlledVocabularyEntry-entryValue "##0.0" ] ] .

globrv:gegevensveld-laadvermogen a gd:Gegevensveld ;
    rdfs:label "maximaalLaadvermogenKw (veld)"@nl , "maximaalLaadvermogenKw (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-laadvermogen"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "maximaalLaadvermogenKw" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "decimal" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-format [ cdi:ControlledVocabularyEntry-entryValue "##0.0" ] ] .

globrv:mapping-laadvermogen a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping laadvermogen"@nl ,
               "data type mapping of the charging power"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-laadvermogen ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-laadvermogen ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 6: aansluittype (categorisch) -------------------------------------

globrv:gegevenstype-aansluittype a gd:GegevenstypeCategorisch ;
    rdfs:label "aansluittype"@nl , "connector type"@en ;
    skos:scopeNote "NOODZAAK — een laadpaal moet een stekker hebben die op de voertuigen in de straat past; zonder dit gegevenstype kan de gemeente wel het vermogen ramen maar niet bepalen welke uitvoering zij aanbesteedt."@nl ,
                   "NECESSITY — a charging point must have a connector that fits the vehicles in the street; without this data type the municipality can estimate the power but cannot determine which type to procure."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-aansluittype"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-AANSLUITING-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "aansluittype" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Het type laadaansluiting waarmee het voertuig aan een laadpunt wordt gekoppeld." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Categorical" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-aansluittype ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

globrv:waardedomein-aansluittype a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein aansluittype"@nl , "value domain of the connector type"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "String" ] ;
    cdi:SubstantiveValueDomain_takesValuesFrom_EnumerationDomain globrv:codelijst-aansluittype .

globrv:codelijst-aansluittype a cdi:CodeList ;
    rdfs:label "codelijst aansluittypen"@nl , "connector type code list"@en ;
    cdi:EnumerationDomain-name [ cdi:ObjectName-name "aansluittypen" ] ;
    cdi:CodeList_has_Code globrv:code-type2 , globrv:code-ccs , globrv:code-chademo ;
    cdi:EnumerationDomain_references_CategorySet globrv:categorieen-aansluittype .

globrv:code-type2 a cdi:Code ;
    rdfs:label "code Type 2"@nl , "code Type 2"@en ;
    cdi:Code_denotes_Category globrv:categorie-type2 ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "TYPE2" ] ] .

globrv:code-ccs a cdi:Code ;
    rdfs:label "code CCS"@nl , "code CCS"@en ;
    cdi:Code_denotes_Category globrv:categorie-ccs ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "CCS" ] ] .

globrv:code-chademo a cdi:Code ;
    rdfs:label "code CHAdeMO"@nl , "code CHAdeMO"@en ;
    cdi:Code_denotes_Category globrv:categorie-chademo ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "CHADEMO" ] ] .

globrv:categorieen-aansluittype a cdi:CategorySet ;
    rdfs:label "categorieën aansluittype"@nl , "connector type categories"@en ;
    cdi:ConceptSystem-name [ cdi:ObjectName-name "aansluittypeCategorieen" ] ;
    cdi:CategorySet_has_Category globrv:categorie-type2 , globrv:categorie-ccs ,
        globrv:categorie-chademo .

globrv:categorie-type2 a cdi:Category ;
    rdfs:label "Type 2"@nl , "Type 2"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "type2" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Wisselstroomaansluiting, de gangbare vorm aan een openbare laadpaal." ; cdi:LanguageString-language "nl" ] ] .

globrv:categorie-ccs a cdi:Category ;
    rdfs:label "CCS"@nl , "CCS"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "ccs" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Gecombineerde aansluiting die naast wisselstroom ook gelijkstroom aankan." ; cdi:LanguageString-language "nl" ] ] .

globrv:categorie-chademo a cdi:Category ;
    rdfs:label "CHAdeMO"@nl , "CHAdeMO"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "chademo" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Oudere gelijkstroomaansluiting; komt in de Vlierdamse populatie nog in kleine aantallen voor." ; cdi:LanguageString-language "nl" ] ] .

globrv:gegevensveld-aansluittype a gd:Gegevensveld ;
    rdfs:label "aansluittype (veld)"@nl , "aansluittype (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-aansluittype"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "aansluittype" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-maximumLength 7 ] .

globrv:mapping-aansluittype a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping aansluittype"@nl ,
               "data type mapping of the connector type"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-aansluittype ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-aansluittype ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 7: massa rijklaar --------------------------------------------------

globrv:gegevenstype-massa a gd:Gegevenstype ;
    rdfs:label "massa rijklaar (kg)"@nl , "mass in running order (kg)"@en ;
    skos:scopeNote "NOODZAAK — de massa bepaalt het energieverbruik per kilometer en daarmee hoe vaak een voertuig moet laden; zij is bovendien maatgevend voor de draagkracht van de parkeervakken waarin een laadpaal wordt geplaatst."@nl ,
                   "NECESSITY — mass determines energy consumption per kilometre and thus how often a vehicle needs to charge; it also determines the load-bearing requirements of the parking bays in which a charging point is installed."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-massa"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-MASSA-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "massa rijklaar" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De massa van het voertuig in rijklare toestand, in kilogram." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Integer" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-massa ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

globrv:waardedomein-massa a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein massa"@nl , "value domain of the mass"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Integer" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Kilogram, geheel getal." ; cdi:LanguageString-language "nl" ] ] ] .

globrv:gegevensveld-massa a gd:Gegevensveld ;
    rdfs:label "massaRijklaarKg (veld)"@nl , "massaRijklaarKg (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-massa"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "massaRijklaarKg" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "integer" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-maximumLength 5 ] .

globrv:mapping-massa a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping massa"@nl , "data type mapping of the mass"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-massa ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable globrv:gegevensveld-massa ;
    cdi:VariableRelationship-semantics [
        cdi:ControlledVocabularyEntry-entryValue "Gegevenstypemapping" ] .

# --- veld 8 en 9: lengte en breedte -----------------------------------------

globrv:gegevenstype-lengte a gd:Gegevenstype ;
    rdfs:label "lengte (mm)"@nl , "length (mm)"@en ;
    skos:scopeNote "NOODZAAK — een laadvak moet passen bij de voertuigen die er staan; de lengteverdeling in een straat bepaalt de maatvoering van de vakken en het aantal vakken dat op een strook past."@nl ,
                   "NECESSITY — a charging bay must fit the vehicles parked there; the length distribution in a street determines the dimensions of the bays and how many fit along a stretch."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-lengte"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-LENGTE-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "lengte" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De lengte van het voertuig, in millimeter." ; cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Integer" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-afmeting ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

globrv:gegevenstype-breedte a gd:Gegevenstype ;
    rdfs:label "breedte (mm)"@nl , "width (mm)"@en ;
    skos:scopeNote "NOODZAAK — samen met de lengte bepaalt de breedte of een laadvak met een paal ertussen op de bestaande parkeerstrook past; zonder dit gegevenstype is de inpassing van de palen niet te toetsen."@nl ,
                   "NECESSITY — together with the length, the width determines whether a charging bay with a post between bays fits the existing parking strip; without this data type the fit of the posts cannot be checked."@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevenstype-breedte"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-BREEDTE-001" ] ;
    cdi:Concept-displayLabel [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "breedte" ; cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De breedte van het voertuig zonder spiegels, in millimeter." ; cdi:LanguageString-language "nl" ] ] ;
    cdi:ConceptualVariable_measures_UnitType globrv:unittype-voertuig ;
    gd:classificatie gdc:persoonsgegevens-aanwezig\/bevat-geen-persoonsgegevens ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Integer" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain globrv:waardedomein-afmeting ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain globrv:waardedomein-onbekend .

# Eén waardedomein voor beide afmetingen: dezelfde eenheid, hetzelfde bereik.
# Hergebruikt in plaats van overgeschreven, zodat een lezer ziet dat het om
# dezelfde grootheid gaat (Visualisatie-note §2).
globrv:waardedomein-afmeting a cdi:SubstantiveValueDomain ;
    rdfs:label "waardedomein afmeting"@nl , "value domain of the dimensions"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Integer" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Millimeter, geheel getal." ; cdi:LanguageString-language "nl" ] ] ] .

globrv:gegevensveld-lengte a gd:Gegevensveld ;
    rdfs:label "lengteMm (veld)"@nl , "lengteMm (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-lengte"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "lengteMm" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "integer" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-maximumLength 5 ] .

globrv:gegevensveld-breedte a gd:Gegevensveld ;
    rdfs:label "breedteMm (veld)"@nl , "breedteMm (field)"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/brv/gegevensveld-breedte"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "breedteMm" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "integer" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout globrv:tgm-laadcapaciteit ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired false ;
        cdi:ValueMapping-maximumLength 5 ] .

globrv:mapping-lengte a cdi:VariableRelationship ;
    rdfs:label "gegevenstypemapping lengte"@nl , "data type mapping of the length"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable globrv:gegevenstype-lengte ;
