# -----------------------------------------------------------------------------
# De partij en de twee relatiesoorten.
#
# HIER ZIT HET SCHERPSTE VERSCHIL MET DE GEPUBLICEERDE STAPEL. `mim:Relatierol`
# typeert de rol van een OBJECT in een relatie tussen objecten. De rollaag van
# de gepubliceerde overeenkomst (`gd:heeftRol` naar rol-objecten met elk hun
# eigen doel, grondslag, akkoordverklaring en eindverantwoordelijke functie)
# typeert de rol van een PARTIJ IN EEN AFSPRAAK, met eigenschappen die aan die
# rol hangen. Dat is een ander soort ding; "partij" komt in MIM 1.2 vijfmaal
# voor en geen van die vijf keer in deze betekenis.
#
# Wat hieronder staat is dus het maximum: dat een overeenkomst een verstrekker
# en een ontvanger heeft, elk precies één. Waarom die verstrekker mag
# verstrekken, en op welke grondslag de ontvanger ontvangt, staat niet in dit
# model en kan er niet in.
# -----------------------------------------------------------------------------

vlmim:objecttype-partij a mim:Objecttype ;
    rdfs:label "Partij"@nl , "Party"@en ;
    mim:identificatie "https://vlierdam.example/mim/objecttype-partij"^^xsd:anyURI ;
    mim:naam "Partij"@nl ;
    mim:definitie "Een organisatie die een gegevensleveringsovereenkomst aangaat."@nl ;
    mim:herkomst "Overeenkomstenadministratie gegevensdeling"@nl ;
    mim:herkomstDefinitie "Model gegevensleveringsovereenkomst v2"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:indicatieAbstractObject false ;
    mim:populatie "Organisaties die in de overeenkomstenadministratie als verstrekkende of ontvangende partij zijn opgenomen." ;
    mim:attribuut vlmim:attribuutsoort-partijnaam .

vlmim:attribuutsoort-partijnaam a mim:Attribuutsoort ;
    rdfs:label "partijnaam"@nl , "party name"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-partijnaam"^^xsd:anyURI ;
    mim:naam "partijnaam"@nl ;
    mim:definitie "De naam waaronder de organisatie in het handelsverkeer en in de overeenkomst optreedt."@nl ;
    mim:herkomst "Overeenkomstenadministratie gegevensdeling"@nl ;
    mim:herkomstDefinitie "Model gegevensleveringsovereenkomst v2"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-organisatienaam ;
    mim:lengte "200" ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend false ;
    mim:authentiek mim:OverigeAuthenticiteit ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

vlmim:datatype-organisatienaam a mim:PrimitiefDatatype ;
    rdfs:label "Organisatienaam"@nl , "Organisation name"@en ;
    mim:identificatie "https://vlierdam.example/mim/datatype-organisatienaam"^^xsd:anyURI ;
    mim:naam "Organisatienaam"@nl ;
