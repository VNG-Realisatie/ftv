# 7 — gemeente van inschrijving. CATEGORISCH, met een codelijst.
#
# MIM kent drie gradaties waar de eis er één vraagt (E89): enumeratie (de lijst
# staat in het model), referentielijst (de lijst wordt buiten het model beheerd
# maar haar structuur staat er wel), en codelijst (de lijst wordt buiten het
# model beheerd en haar structuur ook). De gemeentelijst is een landelijk
# beheerde lijst, dus een codelijst.
#
# De PRIJS van die keuze staat hieronder in de toelichting: een codelijst heeft
# in MIM per definitie geen waarde-items in het model, dus de twee waarden die
# de gepubliceerde veldlaag met twee `cdi:Code`-knopen toont — en de reden dat
# de tweede in een antwoord niet voorkomt — zijn hier proza en geen structuur.
vlmim:attribuutsoort-gemeente-van-inschrijving a mim:Attribuutsoort ;
    rdfs:label "gemeente van inschrijving"@nl , "municipality of registration"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-gemeente-van-inschrijving"^^xsd:anyURI ;
    mim:naam "gemeente van inschrijving"@nl ;
    mim:definitie "De gemeente waar de bevraagde persoon als ingezetene staat ingeschreven."@nl ;
    mim:begrip glo:term-gemeente-van-inschrijving ;
    mim:begripsterm "gemeente van inschrijving"@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:herkomstDefinitie "Begrippenkader BRP-bevraging laadpalen, BK-VLD-BRP-001"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:codelijst-gemeenten ;
    mim:lengte "4" ;
    mim:patroon "Viercijferige gemeentecode." ;
    mim:formeelPatroon "[0-9]{4}" ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend false ;
    mim:authentiek mim:Authentiek ;
    mim:indicatieAfleidbaar false ;
    # DIT IS HET GEGEVEN WAAROP DE POPULATIE IS AFGEBAKEND. `beleid.ttl` eist op
    # de inway van de verstrekker dat de bevraagde persoon ingezetene van
    # Vlierdam is; `mim:indicatieClassificerend` is het dichtstbijzijnde
    # MIM-metagegeven voor "dit gegeven deelt de populatie in".
    mim:indicatieClassificerend true ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

vlmim:codelijst-gemeenten a mim:Codelijst ;
    rdfs:label "Gemeenten"@nl , "Municipalities"@en ;
    mim:identificatie "https://vlierdam.example/mim/codelijst-gemeenten"^^xsd:anyURI ;
    mim:naam "Gemeenten"@nl ;
    mim:definitie "De landelijk beheerde lijst van gemeentecodes, zoals gebruikt in de basisregistratie personen."@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:locatie "https://vlierdam.example/glo/codelijst-gemeenten" ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:toelichting "In deze bevraging komen twee waarden voor: 0001 (Vlierdam) en 9999 (buiten Vlierdam). Alleen de eerste komt in een antwoord terecht; de tweede staat in het model om zichtbaar te maken dat dat een beslissing van de verstrekker is en geen onmogelijkheid. Een codelijst draagt die twee waarden niet als modelelement — dat is per MIM 1.2 het onderscheid met een enumeratie — dus deze zin is de enige plaats waar zij staan."@nl .

# =============================================================================
# B. HET ADMINISTRATIEMODEL VAN DE OVEREENKOMST
#
# WAAROM DIT BLOK ER STAAT. Het antwoord op de eigenaarsvraag is dat MIM de
# gegevensleveringsovereenkomst niet kan dragen. Dat is met een lege plek
# slecht te tonen en met dit blok goed: hier staat wat MIM van de
# overeenkomstlaag WEL levert — het FORMULIER. Een objecttype met een
# statusattribuut uit vijf waarden, een geldigheidsduur en twee relatiesoorten
# naar partijen is keurig MIM-conform en volstrekt bruikbaar.
#
# WAT ER NIET STAAT, EN NIET KAN STAAN: dat RvIG en gemeente Vlierdam op 14
# september 2026 déze levering zijn overeengekomen, dat de overeenkomst de
# status "akkoord" heeft, dat zij van 1 oktober 2026 tot 30 september 2029
# geldt, en wie namens wie heeft getekend. Dat zijn uitspraken over één geval.
# Hoofdstuk 2 van MIM 1.2 noemt zo'n geval een OBJECT en zegt er in één zin bij
# dat een object "geen modelelement" is; de scope-uitspraak in de spec is
# even bondig: "Het MIM is niet bedoeld om vervolgens in termen van dit
# informatiemodel een concrete dataset te vormen."
#
# De overeenkomst zelf staat dus in `vlierdam-glo.ttl`, als
# `glo:glo-rvig-vlierdam-2026`, en zij komt in `vlierdam-mim-afleiding.ttl`
# niet voor — er is niets om haar van af te leiden.
# =============================================================================

vlmim:objecttype-gegevensleveringsovereenkomst a mim:Objecttype ;
    rdfs:label "Gegevensleveringsovereenkomst"@nl , "Data delivery agreement"@en ;
    mim:identificatie "https://vlierdam.example/mim/objecttype-gegevensleveringsovereenkomst"^^xsd:anyURI ;
    mim:naam "Gegevensleveringsovereenkomst"@nl ;
    mim:definitie "De vastlegging van de afspraak tussen een verstrekkende en een ontvangende partij over het leveren van een omschreven verzameling gegevens voor een omschreven doel."@nl ;
    mim:herkomst "Overeenkomstenadministratie gegevensdeling"@nl ;
    mim:herkomstDefinitie "Model gegevensleveringsovereenkomst v2"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:indicatieAbstractObject false ;
    mim:populatie "Alle gegevensleveringsovereenkomsten die in de overeenkomstenadministratie zijn opgenomen, ongeacht hun status." ;
    mim:toelichting "Dit objecttype is het FORMULIER van een overeenkomst. Eén ingevulde overeenkomst is een object in het beschouwde domein en daarmee geen modelelement; zij staat in vlierdam-glo.ttl."@nl ;
    mim:attribuut
        vlmim:attribuutsoort-overeenkomstcode ,
        vlmim:attribuutsoort-overeenkomststatus ,
        vlmim:attribuutsoort-ingangsdatum ,
        vlmim:attribuutsoort-einddatum .

vlmim:attribuutsoort-overeenkomstcode a mim:Attribuutsoort ;
    rdfs:label "overeenkomstcode"@nl , "agreement code"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-overeenkomstcode"^^xsd:anyURI ;
    mim:naam "overeenkomstcode"@nl ;
    mim:definitie "De code waarmee de overeenkomst in de administratie wordt aangeduid."@nl ;
    mim:herkomst "Overeenkomstenadministratie gegevensdeling"@nl ;
    mim:herkomstDefinitie "Model gegevensleveringsovereenkomst v2"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-code ;
    mim:lengte "24" ;
    mim:patroon "GLO-<verstrekker>-<ontvanger>-<jaar>-<volgnummer>" ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend true ;
    mim:authentiek mim:OverigeAuthenticiteit ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

vlmim:attribuutsoort-overeenkomststatus a mim:Attribuutsoort ;
    rdfs:label "status"@nl , "status"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-overeenkomststatus"^^xsd:anyURI ;
    mim:naam "status"@nl ;
    mim:definitie "De stand van de overeenkomst in haar levensloop."@nl ;
    mim:herkomst "Overeenkomstenadministratie gegevensdeling"@nl ;
    mim:herkomstDefinitie "Model gegevensleveringsovereenkomst v2"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:enumeratie-overeenkomststatus ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend false ;
    mim:authentiek mim:OverigeAuthenticiteit ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    # De statuswisseling zelf — wanneer een overeenkomst van concept naar
    # akkoord ging — is een gebeurtenis, en het proces is per paragraaf 1.5.2
    # van MIM 1.2 buiten scope. De tijdlijn-metagegevens kunnen wel zeggen DAT
    # er historie wordt bijgehouden, niet wat er gebeurde.
    mim:heeftTijdlijnGeldigheid true ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie true ;
    mim:indicatieFormeleHistorie false .

vlmim:enumeratie-overeenkomststatus a mim:Enumeratie ;
    rdfs:label "Overeenkomststatus"@nl , "Agreement status"@en ;
    mim:identificatie "https://vlierdam.example/mim/enumeratie-overeenkomststatus"^^xsd:anyURI ;
    mim:naam "Overeenkomststatus"@nl ;
    mim:definitie "De limitatief opgesomde standen die een gegevensleveringsovereenkomst in haar levensloop kan hebben."@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:waarde
        vlmim:enumeratiewaarde-status-concept ,
        vlmim:enumeratiewaarde-status-akkoord ,
        vlmim:enumeratiewaarde-status-opgeschort ,
        vlmim:enumeratiewaarde-status-opgezegd ,
        vlmim:enumeratiewaarde-status-verlopen .

