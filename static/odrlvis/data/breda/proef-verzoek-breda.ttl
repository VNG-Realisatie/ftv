apvz:2024-0000351115 a odrl:Request ;
    odrl:uid apvz:2024-0000351115 ;
    dct:title "Autorisatieverzoek het gemeentebestuur van de gemeente Breda (29 mei 2024)"@nl ;
    dct:description "Verzoek van het gemeentebestuur van de gemeente Breda, gedagtekend 29 mei 2024, om autorisatie voor de systematische verstrekking van gegevens uit de basisregistratie personen (kenmerk 2024-0000351115). Op dit verzoek is beslist in het autorisatiebesluit met kenmerk 2024-0000366479."@nl ;
    dct:identifier "2024-0000351115" ;
    skos:notation "2024-0000351115" ;
    dct:issued "2024-05-29"^^xsd:date ;
    dct:publisher brpafn:510149 ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    odrl:profile apnl:profiel ;
    prov:hadPrimarySource apdoc:2024-0000366479 ;
    skos:editorialNote "Mini-Request: uit het besluit zijn alleen de datum, het kenmerk en de indienertekst van het verzoek herleidbaar — de verzoekbrief zelf is niet gepubliceerd. Wélke gegevens, kanalen, doelen of voorwaarden zijn gevraagd, staat er niet in en is daarom niet gemodelleerd."@nl ,
        "De permission is de minimale regel die ODRL voor een geldige policy vereist: odrl:distribute ('verstrekken'), de profielactie waaronder de BRP-verstrekkingsvormen vallen (odrl:includedIn). Er wordt géén verstrekkingskanaal geclaimd: het verzoek vraagt om autorisatie voor de systematische verstrekking en noemt de vorm niet."@nl ,
        "De indienertekst is herleid tot de afnemer van het besluit (brpafn:510149); de letterlijke tekst in het besluit luidt: “het gemeentebestuur van de gemeente Breda”."@nl ;
    odrl:permission apper:verzoek-2024-0000351115 .

brpafn:510149 rdfs:label "Gemeente Breda/Algemene gemeentetaken"@nl .

apper:verzoek-2024-0000351115 a odrl:Permission ;
    odrl:uid apper:verzoek-2024-0000351115 ;
    dct:title "Verstrekking uit de basisregistratie personen"@nl ;
    odrl:action odrl:distribute ;
    odrl:target apb:gbav ;
    odrl:assignee brpafn:510149 ;
    rdfs:comment "Minimale regel van het verzoek: verstrekking uit de BRP aan de indiener. Kanaal, gegevens en doel zijn niet uit de besluittekst af te leiden en worden niet geclaimd."@nl .
