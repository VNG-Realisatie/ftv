apset:gaba-set19 a prov:Entity ;
    dct:title "Gegevensset 19 (ad hoc)"@nl ;
    rdfs:comment "Versieloze identiteit van de gegevensset; de versies verwijzen hierheen met prov:specializationOf."@nl ;
    dct:hasVersion apset:gaba-set19-v11 .

apset:gaba-set19-v11 a odrl:AssetCollection ;
    dct:title "Gegevensset 19 (ad hoc) — Gegevensoverzicht gemeenten v1.1"@nl ;
    dct:description "De 68 rubrieken van gegevensset 19 uit het Gegevensoverzicht gemeenten, tabblad (2) Gegevens per set. Deze set is voor alle gemeentelijke GABA-autorisatiebesluiten dezelfde: de besluiten verwijzen er met het nummer naar (\"een gegeven in gegevensset 19\")."@nl ;
    skos:editorialNote "Verstrekkingsvorm zit in de setdefinitie zelf: het Gegevensoverzicht typeert set 19 als 'ad hoc'. Deze set hoort daarom bij kanaal apkan:adhoc."@nl ;
    prov:specializationOf apset:gaba-set19 ;
    prov:wasDerivedFrom apdoc:gegevensoverzicht-gemeenten-v11 ;
    dct:source <https://www.rvig.nl/sites/default/files/2026-03/GABA%20Matrix.xlsx> ;
    dct:isVersionOf apset:gaba-set19 .

