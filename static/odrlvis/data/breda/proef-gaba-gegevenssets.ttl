# =============================================================================
# PROEF-TTL (B) — DE GEGEVENSSETS ALS EXTERN GEDEFINIEERDE REGISTERENTITEITEN
#
# De 22 genummerde gegevenssets uit het Gegevensoverzicht gemeenten / de GABA
# Matrix, elk als EEN benoemde, herbruikbare IRI met bronverwijzing en versie —
# in plaats van per besluit herhaalde collecties (apset:<ai>-v<n>-<kanaal>).
#
# Grondslag voor het hergebruik staat in het besluit zelf:
#   art. 1, onder r: "het Gegevensoverzicht gemeenten: het overzicht dat als
#     bijlage bij dit besluit is opgenomen en waarin alle gegevens worden
#     weergegeven die aan de gemeente worden verstrekt";
#   art. 1, onder s: "een gegevensset: een gegevensset die is opgenomen in het
#     gegevensoverzicht gemeenten";
#   toelichting par. 6: "De bijlagen met de verschillende gegevenssets behorende
#     bij de verschillende taken zijn vervangen door het Gegevensoverzicht
#     gemeenten."
#
# Versionering volgt het bestaande temporele-containerpatroon van de besluiten
# (apovk:510149 / apovk:510149-v13): apset:gaba-set<n> is de versieloze
# identiteit (prov:Entity), apset:gaba-set<n>-v11 de collectie zoals die luidt
# in versie 1.1 van de Matrix (documentversie "1.1", tabblad 1).
#
# Handmatig proefmateriaal voor de koppelvlak-refinement-analyse.
# =============================================================================

apdoc:gegevensoverzicht-gemeenten a prov:Entity ;
    dct:title "Gegevensoverzicht gemeenten (bijlage bij het GABA-autorisatiebesluit)"@nl ;
    dct:description "Het overzicht waarnaar artikel 1, onder r en s, van elk gemeentelijk GABA-autorisatiebesluit verwijst en waarin de genummerde gegevenssets zijn vastgelegd. Openbaar beschikbaar als 'Matrix taken, doelgroepen en gegevenssets GABA' (xlsx) op rvig.nl, met de Aanvullende toelichting autorisatie gemeenten als begeleidend document."@nl ;
    dct:publisher oorg:oorg10103 ;
    dct:hasVersion apdoc:gegevensoverzicht-gemeenten-v11 .

apdoc:gegevensoverzicht-gemeenten-v11 a prov:Entity ;
    dct:title "Matrix taken, doelgroepen en gegevenssets GABA, versie 1.1"@nl ;
    dct:identifier "1.1" ;
    dct:modified "2026-02-25"^^xsd:date ;
    dct:issued "2026-03-01"^^xsd:date ;
    prov:specializationOf apdoc:gegevensoverzicht-gemeenten ;
    dct:hasFormat <https://www.rvig.nl/sites/default/files/2026-03/GABA%20Matrix.xlsx> ;
    rdfs:seeAlso <https://publicaties.rvig.nl/sites/default/files/2025-05/Aanvullende%20toelichting%20autorisatie%20gemeenten.pdf> ;
    rdfs:comment "Tabblad (1) Toelichting document geeft 'Versie document 1.1'; de laatste wijzigingsdatum in de bestandseigenschappen is 2026-02-25, publicatiepad /2026-03/."@nl .


apset:gaba-set1 a prov:Entity ;
    dct:title "Gegevensset 1 (ad hoc)"@nl ;
    rdfs:comment "Versieloze identiteit van de gegevensset; de versies verwijzen hierheen met prov:specializationOf."@nl ;
    dct:hasVersion apset:gaba-set1-v11 .

apset:gaba-set1-v11 a odrl:AssetCollection ;
    dct:title "Gegevensset 1 (ad hoc) — Gegevensoverzicht gemeenten v1.1"@nl ;
    dct:description "De 10 rubrieken van gegevensset 1 uit het Gegevensoverzicht gemeenten, tabblad (2) Gegevens per set. Deze set is voor alle gemeentelijke GABA-autorisatiebesluiten dezelfde: de besluiten verwijzen er met het nummer naar (\"een gegeven in gegevensset 1\")."@nl ;
    skos:editorialNote "Verstrekkingsvorm zit in de setdefinitie zelf: het Gegevensoverzicht typeert set 1 als 'ad hoc'. Deze set hoort daarom bij kanaal apkan:adhoc."@nl ;
    prov:specializationOf apset:gaba-set1 ;
    prov:wasDerivedFrom apdoc:gegevensoverzicht-gemeenten-v11 ;
    dct:source <https://www.rvig.nl/sites/default/files/2026-03/GABA%20Matrix.xlsx> ;
    dct:isVersionOf apset:gaba-set1 .

