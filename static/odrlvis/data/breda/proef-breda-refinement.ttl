# =============================================================================
# PROEF-TTL (C) — BREDA 510149 IN REFINEMENT-VORM
#
# Uittreksel: 10 permissions over 4 taken, gekozen zodat alle vier de
# verstrekkingsvormen, de plaatsingshandeling, de voorwaardelijke ('v') sets en
# een burgerzakentaak erin voorkomen. Het volledige besluit telt 33 taken.
#
# Nesting per permission: WAAROM (odrl:purpose) -> HOE (odrl:deliveryChannel)
# -> OVER WIE (doelgroep) -> WAT (odrl:target = gedeelde gegevensset-IRI).
#
# Handmatig proefmateriaal voor de koppelvlak-refinement-analyse.
# Valideer samen met proef-aanbod-refinement.ttl, proef-gaba-gegevenssets.ttl
# en ttl/offers.ttl (voor de vier duties en apaanbod:doelgroepbeginsel).
# =============================================================================

apovk:510149-r-v13 a odrl:Agreement ;
    odrl:uid apovk:510149-r-v13 ;
    dct:title "Gemeente Breda/Algemene gemeentetaken (proef: refinement-vorm)"@nl ;
    dct:description "Regelt de systematische verstrekking van BRP-gegevens aan de gemeente Breda. Elke permission bindt een taak (doel) aan een verstrekkingsvorm (kanaal), een doelgroep en de gegevensset die het besluitartikel voor die combinatie noemt. Afnemersindicatie 510149, besluitversie 13."@nl ;
    skos:editorialNote "PROEFMODELLERING, geen productiedata. IRI apovk:510149-r-v13 wijkt bewust af van de productie-IRI apovk:510149-v13 zodat beide naast elkaar geladen kunnen worden."@nl ,
        "Uittreksel: 10 van de circa 55 (taak, kanaal)-cellen van dit besluit."@nl ;
    dct:publisher oorg:oorg10103 ;
    dct:issued "2026-01-01"^^xsd:date ;
    odrl:profile apnl:profiel ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ,
        brpaut:510149-v13 ,
        <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf> ,
        apdoc:2024-0000366479 ,
        apdoc:gegevensoverzicht-gemeenten-v11 ,
        apvz:2024-0000351115 ;
    dct:valid "2026-01-01/.." ;
    prov:specializationOf apovk:510149 ;
    odrl:assigner oorg:oorg10103 ;
    odrl:assignee brpafn:510149 ;
    odrl:obligation
        apaanbod:duty-inlichtingenplicht ,
        apaanbod:duty-aansluitvoorwaarden ,
        apaanbod:duty-protocollering ,
        apaanbod:duty-geheimhouding ;
    odrl:permission
        apper:510149-v13-r-belastingen-belastingplichtige-adhoc ,
        apper:510149-v13-r-belastingen-belastingplichtige-adhoc-overleden ,
        apper:510149-v13-r-belastingen-erfgenaam-adhoc ,
        apper:510149-v13-r-belastingen-belastingplichtige-spontaan ,
        apper:510149-v13-r-belastingen-belastingplichtige-plaatsing ,
        apper:510149-v13-r-huisvesting-houder-adhoc ,
        apper:510149-v13-r-huisvesting-houder-adres ,
        apper:510149-v13-r-handhaving-betrokkene-adhoc ,
        apper:510149-v13-r-handhaving-nietingezetene-adres-tijdelijk ,
        apper:510149-v13-r-burgerlijke-stand-adhoc .

# --- voorwaarde bij de 'v'-sets ----------------------------------------------

apcon:510149-v13-r-ingeschrevene-overleden a odrl:Constraint ;
    rdfs:label "De ingeschrevene is overleden"@nl ;
    rdfs:comment "Artikel 3, tweede lid, van het besluit. In de Matrix is deze inperking alleen zichtbaar als de markering 'v' in plaats van 'x'; de Matrix zegt niet welke voorwaarde het is."@nl ;
    odrl:leftOperand brprub:datumOverlijdenOverlijden ;
    odrl:operator brp:kv ;
    prov:wasDerivedFrom <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=2> .


apper:510149-v13-r-belastingen-belastingplichtige-adhoc a odrl:Permission ;
    odrl:uid apper:510149-v13-r-belastingen-belastingplichtige-adhoc ;
    dct:title "Belastingplichtige — verstrekking op verzoek"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0005416> ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=2> ;
    rdfs:comment "Grondslag in het besluit: artikel 3, eerste lid — \"De gemeente mag verzoeken om een gegeven in gegevensset 1, 2, 3, 5, 6, 13, 14 of 15\"."@nl ;
    skos:editorialNote "Doorsnede doel x kanaal x gegevensset komt rechtstreeks uit de bron: het besluitartikel noemt de gegevenssets binnen een artikel dat de verstrekkingsvorm benoemt (\"Verzoek verstrekking gegevens ingeschrevene\"). De GABA Matrix, tabblad (3), geeft voor de rij Gemeentelijke belastingen - Belastingplichtige dezelfde sets 1, 2, 3, 5 en 6 met een x en 13, 14 en 15 met een v (onder voorwaarden)."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:gemeentelijke-belastingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; geen aparte bevoegdheid maar een uitvoeringsvorm van dezelfde systematische verstrekking."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhoc ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:belastingplichtige ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAARLANGS — de machine-uitvoerbare toets: het verwerkingsverzoek moet voldoen aan de module die deze regels afdwingt. De module verklaart zelf (prov:wasDerivedFrom, zie proef-dekking-breda.ttl) welke regels zij uitwerkt."@nl ;
            odrl:leftOperand apnl:verwerkingsverzoek ;
            odrl:operator apnl:conformsToPolicy ;
            odrl:rightOperand apart:authz-gaba-belastingen ] ] ;
    odrl:target apset:gaba-combi-01-02-03-05-06-v11 ;
    odrl:duty applicht:510149-v13-d-doeladministratie ,
        applicht:510149-v13-d-vernietigen-na-afhandeling .

apper:510149-v13-r-belastingen-belastingplichtige-adhoc-overleden a odrl:Permission ;
    odrl:uid apper:510149-v13-r-belastingen-belastingplichtige-adhoc-overleden ;
    dct:title "Overleden belastingplichtige — verstrekking op verzoek (aanvullende sets)"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0005416> ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=2> ;
    rdfs:comment "Grondslag in het besluit: artikel 3, tweede lid — \"Onverminderd het eerste lid mag de gemeente slechts om een gegeven verzoeken in gegevensset 13, 14 of 15 als de ingeschrevene [...] is overleden\"."@nl ;
    skos:editorialNote "Dit is de 'v'-markering uit de Matrix expliciet gemaakt: sets 13, 14 en 15 staan bij deze rij als v (onder voorwaarden), niet als x. De voorwaarde zelf staat alleen in het besluit; de Matrix zegt niet welke voorwaarde het is."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:gemeentelijke-belastingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; geen aparte bevoegdheid maar een uitvoeringsvorm van dezelfde systematische verstrekking."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhoc ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:belastingplichtige ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAARLANGS — de machine-uitvoerbare toets: het verwerkingsverzoek moet voldoen aan de module die deze regels afdwingt. De module verklaart zelf (prov:wasDerivedFrom, zie proef-dekking-breda.ttl) welke regels zij uitwerkt."@nl ;
            odrl:leftOperand apnl:verwerkingsverzoek ;
            odrl:operator apnl:conformsToPolicy ;
            odrl:rightOperand apart:authz-gaba-belastingen ] ] ;
    odrl:target apset:gaba-combi-13-14-15-v11 ;
    odrl:constraint apcon:510149-v13-r-ingeschrevene-overleden ;
    odrl:duty applicht:510149-v13-d-doeladministratie ,
        applicht:510149-v13-d-vernietigen-na-afhandeling .

apper:510149-v13-r-belastingen-erfgenaam-adhoc a odrl:Permission ;
    odrl:uid apper:510149-v13-r-belastingen-erfgenaam-adhoc ;
    dct:title "Erfgenaam belastingplichtige — verstrekking op verzoek"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0005416> ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=3> ;
    rdfs:comment "Grondslag in het besluit: artikel 3, derde lid — \"De gemeente mag verzoeken om een gegeven in gegevensset 1, 2, 3, 5 of 6 [...] over de ingeschrevene die een erfgenaam is\"."@nl ;
    skos:editorialNote "AFWIJKING BESLUIT vs MATRIX: het besluit (18 juni 2024) kent deze doelgroep de sets 1, 2, 3, 5 en 6 toe; de GABA Matrix v1.1 (februari 2026) markeert voor de rij Gemeentelijke belastingen - Erfgenaam belastingplichtige alleen de sets 1, 2 en 3. Hier is het BESLUIT gevolgd, want dat is de rechtsgrond; de afwijking is een versieverschil dat moet worden opgelost voordat de Matrix als normatieve bron wordt gebruikt."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:gemeentelijke-belastingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; geen aparte bevoegdheid maar een uitvoeringsvorm van dezelfde systematische verstrekking."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhoc ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:erfgenaam-belastingplichtige ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAARLANGS — de machine-uitvoerbare toets: het verwerkingsverzoek moet voldoen aan de module die deze regels afdwingt. De module verklaart zelf (prov:wasDerivedFrom, zie proef-dekking-breda.ttl) welke regels zij uitwerkt."@nl ;
            odrl:leftOperand apnl:verwerkingsverzoek ;
            odrl:operator apnl:conformsToPolicy ;
            odrl:rightOperand apart:authz-gaba-belastingen ] ] ;
    odrl:target apset:gaba-combi-01-02-03-05-06-v11 ;
    odrl:duty applicht:510149-v13-d-doeladministratie ,
        applicht:510149-v13-d-vernietigen-na-afhandeling .

apper:510149-v13-r-belastingen-belastingplichtige-spontaan a odrl:Permission ;
    odrl:uid apper:510149-v13-r-belastingen-belastingplichtige-spontaan ;
    dct:title "Belastingplichtige — spontane verstrekking"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0005416> ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=25> ;
    rdfs:comment "Grondslag in het besluit: artikel 59 — \"Zodra de afnemersindicatie [...] is opgenomen worden aan de gemeente eenmaal de gegevens verstrekt die zijn opgenomen in gegevensset 22\"."@nl ;
    skos:editorialNote "Gegevensset 22 is niet doelspecifiek: het besluit kent EEN spontane set toe voor alle taken samen, en de Matrix heeft voor set 22 geen kolom per taak+doelgroep maar alleen een ja/nee-vlag 'Spontaan'. De doelbinding is hier dus een echte inperking van het gebruik, geen inperking van de gegevens."@nl ;
    skos:editorialNote "De Matrix markeert 'Spontaan' voor 21 van de 68 taak+doelgroep-rijen; Gemeentelijke belastingen - Belastingplichtige is er een van, Erfgenaam belastingplichtige niet."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:gemeentelijke-belastingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; geen aparte bevoegdheid maar een uitvoeringsvorm van dezelfde systematische verstrekking."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:spontaan ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:belastingplichtige ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAARLANGS — de machine-uitvoerbare toets: het verwerkingsverzoek moet voldoen aan de module die deze regels afdwingt. De module verklaart zelf (prov:wasDerivedFrom, zie proef-dekking-breda.ttl) welke regels zij uitwerkt."@nl ;
            odrl:leftOperand apnl:verwerkingsverzoek ;
            odrl:operator apnl:conformsToPolicy ;
            odrl:rightOperand apart:authz-gaba-belastingen ] ] ;
    odrl:target apset:gaba-set22-v11 ;
    odrl:duty applicht:510149-v13-d-indicatie-verwijderen .

apper:510149-v13-r-belastingen-belastingplichtige-plaatsing a odrl:Permission ;
    odrl:uid apper:510149-v13-r-belastingen-belastingplichtige-plaatsing ;
    dct:title "Belastingplichtige — verzoek tot plaatsen afnemersindicatie"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0005416> ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=2> ;
    rdfs:comment "Grondslag in het besluit: artikel 2 — \"De gemeente mag verzoeken om de afnemersindicatie bij de persoonslijst van een ingeschrevene op te nemen\"."@nl ;
    skos:editorialNote "GEEN gegevensset: het plaatsingsartikel kent geen gegevens toe. De gegevens volgen uit artikel 59 (gegevensset 22, spontane verstrekking). Het huidige model hangt hier de volledige rubriekenset van de autorisatietabelregel onder (66 leden voor Breda); dat is een technisch feit uit Tabel 35, geen toekenning uit het besluit."@nl ;
    skos:editorialNote "Geen odrl:deliveryChannel-refinement: plaatsing is in het BRP-domeinprofiel een odrl:use-actie, geen verstrekking."@nl ;
    odrl:action [ rdf:value brp:adHocPlaatsing ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:gemeentelijke-belastingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:belastingplichtige ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAARLANGS — de machine-uitvoerbare toets: het verwerkingsverzoek moet voldoen aan de module die deze regels afdwingt. De module verklaart zelf (prov:wasDerivedFrom, zie proef-dekking-breda.ttl) welke regels zij uitwerkt."@nl ;
            odrl:leftOperand apnl:verwerkingsverzoek ;
            odrl:operator apnl:conformsToPolicy ;
            odrl:rightOperand apart:authz-gaba-belastingen ] ] ;
    odrl:target apb:gbav ;
    odrl:duty applicht:510149-v13-d-indicatie-verwijderen .

