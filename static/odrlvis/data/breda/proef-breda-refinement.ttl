        applicht:510149-v13-d-vernietigen-na-afhandeling .

apper:510149-v13-r-huisvesting-houder-adres a odrl:Permission ;
    odrl:uid apper:510149-v13-r-huisvesting-houder-adres ;
    dct:title "Houder huisvestingsvergunning — adresverstrekking op verzoek"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0034569> ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/Besluit/GABA%20BRP/510149%20Autorisatiebesluit%20Gemeente%20Breda%20BRP%20%28GABA%202024%29%2001-07-2024.pdf#page=7> ;
    rdfs:comment "Grondslag in het besluit: artikel 12 — \"Verzoek verstrekking gegevens ingeschrevenen op adres [...] gegevensset 20\"."@nl ;
    skos:editorialNote "AFWIJKING BESLUIT vs MATRIX: 329 van de 336 besluiten kennen bij Huisvestingsvergunningen de ad-hoc-adresverstrekking (gegevensset 20) toe; de GABA Matrix v1.1 markeert voor GEEN ENKELE huisvestingsdoelgroep de kolom 'Gegevensset 20 (ad hoc adres)'. De Matrix is op dit punt onvolledig ten opzichte van de besluiten."@nl ;
    skos:editorialNote "Enkelvoudige set: geen composiet nodig, de permission wijst rechtstreeks naar apset:gaba-set20-v11."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:huisvestingsvergunningen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; geen aparte bevoegdheid maar een uitvoeringsvorm van dezelfde systematische verstrekking."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhocAdres ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:houder-huisvestingsvergunning ] ] ;
    odrl:target apset:gaba-set20-v11 .

