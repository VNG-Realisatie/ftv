# Het ketenvoorbeeld uit de Visualisatie-note, §4 "Links between policies".
#
# Drie beleidsstukken en drie prov:wasDerivedFrom-links die door de TYPERING
# van hun uiteinden elk iets anders betekenen (de betekenistabel van §4):
#
#   Agreement -> Offer     de overeenkomst accepteert het aanbod
#   Agreement -> Request   de overeenkomst beantwoordt het verzoek
#   Request   -> Offer     het verzoek vraagt het aanbod aan
#
# Plus, als afbakening, een VIERDE wasDerivedFrom vanaf hetzelfde verzoek naar
# een gewoon document (geen policy): die blijft generieke herkomst en hoort in
# "Afgeleid van" te blijven staan.
#
# Buiten de note (bewust toegevoegd): een TWEEDE verzoek dat nog niet
# beantwoord is. Een verzoek waar een overeenkomst naar wijst toont de viewer
# als compacte Verzoek-REGEL onder die overeenkomst; een verzoek zonder
# overeenkomst krijgt een eigen KAART. De aanvraag-zin "vraagt … aan" hoort op
# allebei te staan, en met dit verzoek erbij laat één pagina beide zien.
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/keten/> .

ex:offer1 a odrl:Offer ;
    dct:title "Streaminglicentie voor de catalogus 2026"@nl ,
              "Streaming licence for the 2026 catalogue"@en ;
    odrl:assigner ex:omroep ;
    odrl:permission [ a odrl:Permission ;
        odrl:action odrl:play ;
        odrl:target ex:catalogus2026 ] .

ex:request1 a odrl:Request ;
    dct:title "Verzoek van Radio Alpha, 12 maart 2026"@nl ,
              "Request by Radio Alpha, 12 March 2026"@en ;
    dct:identifier "RA-2026-0312" ;
    dct:issued "2026-03-12"^^xsd:date ;
    prov:wasDerivedFrom ex:offer1 , <https://example.org/docs/aanvraagformulier.pdf> ;
    odrl:permission [ a odrl:Permission ;
        odrl:action odrl:play ;
        odrl:target ex:catalogus2026 ;
        odrl:assignee ex:radioAlpha ] .

ex:agreement1 a odrl:Agreement ;
    dct:title "Streaminglicentie voor Radio Alpha"@nl ,
              "Streaming licence for Radio Alpha"@en ;
    odrl:assigner ex:omroep ;
    odrl:assignee ex:radioAlpha ;
    prov:wasDerivedFrom ex:offer1 , ex:request1 ;
    odrl:permission [ a odrl:Permission ;
        odrl:action odrl:play ;
        odrl:target ex:catalogus2026 ;
        odrl:assignee ex:radioAlpha ] .

# Nog niet beantwoord: geen overeenkomst wijst hiernaar, dus dit verzoek houdt
# een eigen kaart — met dezelfde betekenis-zin.
ex:request2 a odrl:Request ;
    dct:title "Verzoek van Radio Beta, 4 april 2026"@nl ,
              "Request by Radio Beta, 4 April 2026"@en ;
    dct:identifier "RB-2026-0404" ;
    dct:issued "2026-04-04"^^xsd:date ;
    prov:wasDerivedFrom ex:offer1 , <https://example.org/docs/aanvraagformulier.pdf> ;
    odrl:permission [ a odrl:Permission ;
        odrl:action odrl:play ;
        odrl:target ex:catalogus2026 ;
        odrl:assignee ex:radioBeta ] .
ex:radioBeta rdfs:label "Radio Beta"@nl , "Radio Beta"@en .

ex:catalogus2026 a odrl:Asset ;
    rdfs:label "Catalogus 2026"@nl , "2026 catalogue"@en .
ex:omroep rdfs:label "Voorbeeldomroep"@nl , "Example Broadcaster"@en .
ex:radioAlpha rdfs:label "Radio Alpha"@nl , "Radio Alpha"@en .
