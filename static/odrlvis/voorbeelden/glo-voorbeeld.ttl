glo:mapping-geslachtsnaam a cdi:VariableRelationship ;
    rdfs:label "Gegevenstypemapping geslachtsnaam"@nl , "Data type mapping surname"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable vlierdam:veld-brp-naam-geslachtsnaam ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable glo:gegevensveld-geslachtsnaam .

# 4 en 5 — de twee adresregels. Zij delen hun begrip en hun waardedomein; wat ze
# onderscheidt is hun plaats in het bericht.
vlierdam:veld-brp-adressering-adresregel1 a gd:Gegevenstype ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/odrl/veld-brp-adressering-adresregel1"^^xsd:anyURI ] ;
