glo:code-gemeente-elders a cdi:Code ;
    rdfs:label "9999 — buiten Vlierdam"@nl , "9999 — outside Vlierdam"@en ;
    cdi:Code_denotes_Category glo:categorie-gemeente-elders ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "9999" ] ] .

glo:categorieen-gemeente a cdi:CategorySet ;
    rdfs:label "Categorieën gemeente van inschrijving"@nl ,
               "Categories for municipality of registration"@en ;
    cdi:ConceptSystem-name [ cdi:ObjectName-name "gemeenteCategorieen" ] ;
    cdi:CategorySet_has_Category glo:categorie-gemeente-vlierdam , glo:categorie-gemeente-elders .

glo:categorie-gemeente-vlierdam a cdi:Category ;
    rdfs:label "ingezetene van Vlierdam"@nl , "resident of Vlierdam"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "vlierdam" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De persoon staat in Vlierdam ingeschreven; dit is de enige waarde die in een antwoord voorkomt." ;
          cdi:LanguageString-language "nl" ] ] .

glo:categorie-gemeente-elders a cdi:Category ;
    rdfs:label "ingezetene van een andere gemeente"@nl , "resident of another municipality"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "elders" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De persoon staat elders ingeschreven; de verstrekker laat zo iemand buiten het antwoord, en deze waarde komt in een levering dus niet voor." ;
          cdi:LanguageString-language "nl" ] ] .

glo:gegevensveld-gemeente-van-inschrijving a gd:Gegevensveld ;
    rdfs:label "veld gemeente van inschrijving"@nl , "field municipality of registration"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/gegevensveld-gemeente-van-inschrijving"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "gemeenteVanInschrijving" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout glo:tgm-brp-antwoord ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired true ;
        cdi:ValueMapping-length 4 ] .

glo:mapping-gemeente-van-inschrijving a cdi:VariableRelationship ;
    rdfs:label "Gegevenstypemapping gemeente van inschrijving"@nl ,
               "Data type mapping municipality of registration"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable vlierdam:veld-brp-gemeenteVanInschrijving ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable glo:gegevensveld-gemeente-van-inschrijving .

# De zeven mappings in één structuur.
glo:variabelestructuur-brp-laadpalen a cdi:VariableStructure ;
    rdfs:label "Variabelenstructuur BRP-bevraging laadpalen"@nl ,
               "Variable structure for charging-station population register queries"@en ;
    cdi:VariableStructure-purpose [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De gegevenstypemappingen tussen het logisch en het technisch gegevensmodel van de leverset." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:VariableStructure_structures_VariableCollection glo:gegevensset-brp-laadpalen ;
    cdi:VariableStructure_has_VariableRelationship
        glo:mapping-bsn , glo:mapping-voornamen , glo:mapping-geslachtsnaam ,
        glo:mapping-adresregel1 , glo:mapping-adresregel2 ,
        glo:mapping-geboortedatum , glo:mapping-gemeente-van-inschrijving .

# =============================================================================
# 9. WAT DIT BESTAND AAN BESTAANDE KNOPEN TOEVOEGT
#
# De aanvullingen staan hierboven op hun inhoudelijke plaats; deze lijst maakt
# in één oogopslag zichtbaar welke knopen uit de andere vlierdam-bestanden er
# tripels bij krijgen. Geen van die bestanden is gewijzigd.
#
#   vlierdam:brp-velden-laadpalen  (velden.ttl)
#       + gd:Gegevensleversetspecificatie met code, beschrijving, populatie,
#         logisch gegevensmodel, filtergegevenstype, gegevensmiddel,
#         classificaties, rubricering en drie leversetafspraken (sectie 7).
#   vlierdam:doelbinding-registratie-laadpalen  (vocabulaire.ttl)
#       + dpv:Purpose met beschrijving en twee grondslagen (sectie 5).
#   vlierdam:gemeentesecretaris  (vocabulaire.ttl)
#       + org:Role, zodat de functie als eindverantwoordelijke kan dienen
#         (sectie 6).
#   de zeven veldknopen  (velden.ttl)
#       + gd:Gegevenstype respectievelijk gd:GegevenstypeCategorisch, met
#         begrip, waardetype, waardedomein en classificaties (sectie 8c).
#
# Alleen aangehaald, niet aangevuld: vlierdam:RvIG, vlierdam:GemeenteVlierdam,
# vlierdam:set-rvig-inway, vlierdam:plicht-vernietiging,
# vlierdam:plicht-traceparent en vlierdam:medewerkers-burgerzaken.
# =============================================================================

## --- data/vlierdam/vlierdam-glo-brv.ttl ---
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dpv:    <https://w3id.org/dpv#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix dprod:  <https://www.omg.org/spec/DPROD/dprod/> .
@prefix cdi:    <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix apnl:   <https://standaarden.overheid.nl/odrl-ap-nl/> .

# Het NEUTRALE vocabulaire van vlierdam-glo.ttl / glo-shapes.ttl — gespiegeld
# informatiemodel, generiek gehost. Dit bestand definieert er niets van; het
# gebruikt het.
@prefix gd:         <https://gegevensdeling.example/def/> .
@prefix gdstatus:   <https://gegevensdeling.example/def/status/> .
@prefix gdonderwerp: <https://gegevensdeling.example/def/afspraak/onderwerp/> .
@prefix gdglsonderwerp: <https://gegevensdeling.example/def/glsonderwerp/> .
@prefix gdgrondslag: <https://gegevensdeling.example/def/grondslag/> .
@prefix gdvrijwillig: <https://gegevensdeling.example/def/grondslag/Vrijwillig/> .
@prefix gdnamens:   <https://gegevensdeling.example/def/namens/> .
@prefix gdc:        <https://gegevensdeling.example/def/classificatie/> .

# Het bestaande Vlierdam-corpus (beleid.ttl, vocabulaire.ttl, velden.ttl):
# partijen en begrippen komen daar vandaan en worden hier hergebruikt.
@prefix vlierdam: <https://vlierdam.example/odrl/> .
# De instanties van DEZE levering.
@prefix globrv: <https://vlierdam.example/glo/brv/> .

# =============================================================================
# Gemeente Vlierdam (FICTIEF) — de gegevensleveringsovereenkomst voor de
# PUSH-levering van voertuigkenmerken door de RDW (BRV) aan de gemeente, voor
# de inventarisatie van de benodigde laadcapaciteit.
#
# DIT IS DE TWEEDE GLO IN DIT CORPUS. De eerste (vlierdam-glo.ttl) formaliseert
# de bestaande PULL-levering: de laadpalenapplicatie bevraagt de BRP per
# aanvraag. Deze GLO staat daar los van en gaat over iets anders: niet een
# bevraging per aanvraag, maar een periodieke levering van een hele gemeente
# in één keer, voor beleidsvoorbereiding in plaats van voor een individuele
# aanvraag. Zij deelt met de eerste alleen het neutrale vocabulaire, de
# partijen en de begrippen — geen enkele regelknoop.
#
# WAT DEZE CASUS LAAT ZIEN IS DATAMINIMALISATIE BIJ EEN PUSH.
# Bij een bevraging is minimalisatie een zaak van de vraag: je vraagt één
# persoon op, met één zoeksleutel, met één doel (beleid.ttl). Bij een push is
# er geen vraag om te beperken — er gaat een hele populatie de deur uit. De
# minimalisatie moet dan in de SAMENSTELLING van de leverset zitten, en die
# samenstelling gebeurt AAN DE BRON:
#
#   1. de RDW koppelt kenteken -> houder -> verblijfsobject in eigen huis;
#   2. de RDW laat vervolgens het kenteken en het burgerservicenummer VALLEN;
#   3. wat de gemeente ontvangt zijn technische voertuigkenmerken met een
#      verblijfsobject-identificatie ernaast, en verder niets.
#
# De gemeente krijgt dus nooit te zien wélk voertuig van wélke inwoner is. Zij
# krijgt wat zij voor een capaciteitsraming nodig heeft: hoeveel stekker-
# voertuigen er op een adreseenheid staan, hoeveel energie zij vragen en met
# welk vermogen zij laden. Die keuze is in dit bestand op drie plaatsen
# zichtbaar, en dat is opzet:
#
#   - NORMATIEF, als odrl:Prohibition: het verbod op herleiding tot personen
#     (globrv:verbod-herleiding) en het verbod op doorlevering;
#   - TECHNISCH, als dpv:TechnicalMeasure: het anker
#     globrv:anker-samenstelling-bij-de-bron, dat de samenstelling aan de bron
#     als de borging van dat verbod aanwijst (hetzelfde anker-idioom als
#     beleid.ttl);
#   - FEITELIJK, in de veldenlaag van de gegevensleveringsspecificatie: de
#     leverset heeft tien gegevenstypen en geen daarvan is een
#     persoonsidentificator. Wie de GLS-vouw in de viewer openklapt, ziet dat
#     — en ziet ook dat het bewijs niet uit een belofte in proza komt maar uit
#     de opsomming zelf.
#
# EERLIJK OVER WAT ER OVERBLIJFT. Een verblijfsobject-identificatie is in dit
# voorbeeld geen persoonsgegeven-identificator, maar de COMBINATIE kan dat
# naderen: op een adreseenheid met precies één voertuig is de stap naar een
# huishouden klein, en wie de BRP ernaast legt zet die stap. Daarom is het
# verbod op herleiding geen sierregel maar de kern van deze overeenkomst, en
# daarom draagt de leverset een bewaartermijn en een kring van
# toegangsgerechtigden. De proportionaliteit zit in de aard van de velden: zij
# beschrijven een voertuig als technisch object en zeggen niets over een
# persoon, en zonder de koppeling aan een adreseenheid is een capaciteits-
# raming per straat of wijk niet te maken.
#
# Alle partijen, gegevens en afspraken zijn FICTIEF. Of de BRV deze velden
# werkelijk houdt doet in dit voorbeeld niet ter zake.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. De overeenkomst
# -----------------------------------------------------------------------------

globrv:glo-brv-vlierdam-2026 a odrl:Agreement , gd:Gegevensleveringsovereenkomst ;
    odrl:uid globrv:glo-brv-vlierdam-2026 ;
    odrl:profile gd:profiel , apnl:profiel ;
    dct:identifier "GLO-RDW-VLD-2026-002" ;
    dct:title "GLO voertuigkenmerken laadcapaciteit RDW – gemeente Vlierdam"@nl ,
              "GLO vehicle characteristics for charging capacity RDW – municipality of Vlierdam"@en ;
    dct:description "Gegevensleveringsovereenkomst voor de periodieke levering door de RDW van technische voertuigkenmerken, gekoppeld aan een verblijfsobject, aan de gemeente Vlierdam, ten behoeve van de inventarisatie van de benodigde laadcapaciteit. De levering bevat geen burgerservicenummer en geen kenteken."@nl ,
                    "Data delivery agreement for the periodic delivery by the RDW of technical vehicle characteristics, linked to a dwelling unit, to the municipality of Vlierdam, for the purpose of surveying the required charging capacity. The delivery contains no citizen service number and no licence plate."@en ;
    dct:issued "2026-09-08"^^xsd:date ;
    dct:conformsTo globrv:convenant-laadinfrastructuur ;
    dct:references globrv:convenant-laadinfrastructuur ,
        globrv:registervermelding-gegevensdeling ;

    schema:validFrom "2026-11-01"^^xsd:date ;
    schema:validThrough "2029-10-31"^^xsd:date ;
    gd:heeftStatus gdstatus:akkoord ;

    # De ODRL-laag: twee gewone partij-IRI's, zodat een ODRL-evaluator deze
    # overeenkomst kan lezen zonder het rolmodel te kennen. Beide partijen
    # staan al in vocabulaire.ttl — de GLO klikt aan het bestaande corpus vast
    # en munt ze niet opnieuw.
    odrl:assigner vlierdam:RDW ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    # De modellaag ernaast: de twee rol-objecten met elk hun eigen doel,
    # grondslag, akkoordverklaring en eindverantwoordelijke functie.
    gd:heeftRol globrv:rol-verstrekker , globrv:rol-ontvanger ;

    gd:noodzaak """De gemeente moet weten hoeveel laadvermogen er de komende
jaren per straat en per wijk nodig is, en kan dat alleen ramen als zij weet
hoeveel stekkervoertuigen er op welke adreseenheid staan en hoeveel energie en
vermogen die vragen. Een raming op basis van gemeentetotalen is voor de
netaansluitingen te grof: de capaciteit wordt per straatsegment aangelegd.

Voor dat doel zijn het burgerservicenummer en het kenteken NIET nodig. De
gemeente hoeft niet te weten wélk voertuig van wélke inwoner is; zij hoeft te
weten wat er op een adreseenheid staat. De koppeling van kenteken naar houder
naar verblijfsobject gebeurt daarom bij de RDW, en de geleverde set bevat
alleen technische voertuigkenmerken met een verblijfsobject-identificatie.

Dat een verblijfsobject-identificatie samen met een klein aantal voertuig-
kenmerken in bepaalde gevallen naar een huishouden kan wijzen, is onder ogen
gezien: op een adreseenheid met één voertuig is de kring klein. De levering is
daarom beperkt tot stekkervoertuigen, tot de tien kenmerken die de raming
nodig heeft en tot inwoners van Vlierdam; herleiding tot personen is verboden
en de gemeente legt de set niet naast de basisregistratie personen. De
kenmerken zelf beschrijven een voertuig als technisch object en zeggen over de
houder niets."""@nl ,
        """The municipality needs to know how much charging power will be
required per street and per district in the coming years, and can only estimate
this if it knows how many plug-in vehicles are located at which dwelling unit
and how much energy and power they require. An estimate based on municipal
totals is too coarse for grid connections: capacity is installed per street
segment.

For that purpose the citizen service number and the licence plate are NOT
needed. The municipality does not need to know which vehicle belongs to which
resident; it needs to know what is present at a dwelling unit. The linking of
licence plate to keeper to dwelling unit therefore takes place at the RDW, and
the delivered set contains only technical vehicle characteristics with a
dwelling unit identification.

That a dwelling unit identification together with a small number of vehicle
characteristics may in certain cases point to a household has been considered:
at a dwelling unit with a single vehicle the circle is small. The delivery is
therefore limited to plug-in vehicles, to the ten characteristics the estimate
requires and to residents of Vlierdam; re-identification of persons is
prohibited and the municipality does not combine the set with the population
register. The characteristics themselves describe a vehicle as a technical
object and say nothing about the keeper."""@en ;

    gd:doelVerstrekker globrv:doel-verstrekking-onderzoek-statistiek ;
    gd:verwerkingsbelang globrv:belang-verantwoording ;
    gd:gegevensleveringsspecificatie globrv:gls-laadcapaciteit ;
    gd:akkoordverklaring globrv:akkoord-rdw , globrv:akkoord-vlierdam ;

    odrl:permission globrv:toestemming-gebruik ;
    odrl:prohibition globrv:verbod-herleiding , globrv:verbod-doorlevering ;
    odrl:obligation globrv:plicht-levering , globrv:plicht-vernietiging ,
        globrv:afspraak-evaluatie , globrv:afspraak-opzegtermijn .

# -----------------------------------------------------------------------------
# 2. De regels
# -----------------------------------------------------------------------------

# Wat de gemeente met de leverset mag: gebruiken, en uitsluitend binnen de
# doelbinding. Dezelfde vorm als het profielvoorbeeld: een benoemde actieknoop
# met de doelbinding als odrl:refinement, zodat de doelbinding het normatieve,
# AP-NL-conforme mechanisme blijft.
globrv:toestemming-gebruik a odrl:Permission ;
    odrl:uid globrv:toestemming-gebruik ;
    dct:title "Gebruik voor de laadcapaciteitsinventarisatie"@nl ,
              "Use for the charging capacity survey"@en ;
    odrl:target globrv:leverset-laadcapaciteit ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    odrl:action globrv:actie-gebruik-inventarisatie .

globrv:actie-gebruik-inventarisatie rdf:value odrl:use ;
    rdfs:label "gebruiken voor de capaciteitsinventarisatie"@nl ,
               "use for the capacity survey"@en ;
    odrl:refinement globrv:vw-doelbinding-laadcapaciteit .

globrv:vw-doelbinding-laadcapaciteit a odrl:Constraint ;
    rdfs:label "Doelbinding: inventarisatie laadcapaciteit"@nl ,
               "Purpose limitation: charging capacity survey"@en ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand globrv:doel-inventarisatie-laadcapaciteit .

# HET HART VAN DEZE CASUS, als norm.
#
# Het verbod op herleiding is geen doorleververbod en geen gebruiksbeperking:
# het verbiedt de gemeente een nieuwe verzameling te maken waarin de geleverde
# voertuigkenmerken alsnog aan personen vastzitten — door de set naast de BRP
# te leggen, naast het eigen zaaksysteem, of naast welke bron dan ook die een
# verblijfsobject aan een bewoner koppelt. odrl:derive is daarvoor de
# ODRL-kernactie: een nieuw asset afleiden uit dit asset. Geen eigen term; het
# patroon is baseline, het besluit is dat dít de vertaling is.
#
# DE MARKER STAAT OP DE REGEL, niet op een voorwaarde: dit verbod is ALS GEHEEL
# technisch geborgd (beleid.ttl, kop: "Staat de marker op de REGEL, dan is die
# regel ALS GEHEEL geborgd"). De borging is dat de herleidingssleutels de
# gemeente niet bereiken — zij zijn bij de RDW uit de set gelaten. Een verbod
# dat op die manier is geborgd is niet minder een verbod: het blijft gelden
# voor de gevallen waarin de gemeente langs een andere weg aan een sleutel zou
# komen, en het is de rechtvaardiging van de technische keuze erboven.
globrv:verbod-herleiding a odrl:Prohibition , dpv:TechnicalMeasure ;
    odrl:uid globrv:verbod-herleiding ;
    dct:title "Geen herleiding tot personen"@nl ,
              "No re-identification of persons"@en ;
    dct:description "De gemeente Vlierdam herleidt de geleverde voertuigkenmerken niet tot personen of huishoudens en koppelt de leverset niet aan de basisregistratie personen, aan het eigen zaaksysteem of aan enige andere bron waarin een verblijfsobject aan een bewoner is gekoppeld."@nl ,
                    "The municipality of Vlierdam does not trace the delivered vehicle characteristics back to persons or households and does not combine the delivery set with the population register, with its own case system, or with any other source in which a dwelling unit is linked to a resident."@en ;
    odrl:target globrv:leverset-laadcapaciteit ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    odrl:action odrl:derive .

# Hetzelfde patroon als een gewoon doorleververbod: een
# odrl:Prohibition met odrl:distribute, de ontvanger als assignee en de
# leverset als target. Hier zwaarder dan daar: een set die bij de gemeente niet
# tot personen te herleiden is, kan dat bij een derde met een eigen
# adressenbestand wél zijn.
globrv:verbod-doorlevering a odrl:Prohibition ;
    odrl:uid globrv:verbod-doorlevering ;
    dct:title "Geen doorlevering aan derden"@nl ,
              "No onward sharing with third parties"@en ;
    dct:description "De gemeente Vlierdam deelt de leverset niet met een derde. Verstrekking aan de netbeheerder of aan een onderzoeksbureau gebeurt uitsluitend in geaggregeerde vorm, op ten minste buurtniveau en zonder verblijfsobject-identificatie."@nl ,
                    "The municipality of Vlierdam does not share the delivery set with a third party. Provision to the grid operator or to a research agency takes place only in aggregated form, at neighbourhood level or higher and without dwelling unit identification."@en ;
    odrl:target globrv:leverset-laadcapaciteit ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    odrl:action odrl:distribute .

# De leverplicht van de verstrekker. Het leverritme staat als proza in de
# beschrijving én machineleesbaar als RFC 5545-RRULE (dprod:recurrence):
# vier keer per jaar, op de eerste dag van het kwartaal.
globrv:plicht-levering a odrl:Duty , gd:afspraak ;
    odrl:uid globrv:plicht-levering ;
    dct:title "Kwartaallevering"@nl , "Quarterly delivery"@en ;
    dct:description "De RDW stelt de leverset elk kwartaal samen en verstuurt haar uiterlijk op de vijfde werkdag na het begin van het kwartaal, volgens de gegevensleveringsspecificatie."@nl ,
                    "The RDW compiles the delivery set every quarter and sends it no later than the fifth working day after the start of the quarter, according to the data delivery specification."@en ;
    dct:subject gdonderwerp:verplichtingen-verstrekker ;
    odrl:assignee vlierdam:RDW ;
    odrl:action odrl:distribute ;
    odrl:target globrv:leverset-laadcapaciteit ;
    odrl:constraint globrv:anker-samenstelling-bij-de-bron ;
    dprod:recurrence "FREQ=YEARLY;BYMONTH=1,4,7,10;BYMONTHDAY=1" .

# HET ANKER, in het conformsToPolicy-idioom van beleid.ttl: een BENOEMDE
# voorwaarde met de marker dpv:TechnicalMeasure, die naar het uitvoerende
# artefact in haar rightOperand delegeert en de realisatielinks draagt.
#
# WAAROM apnl:verwerkingsverzoek OOK BIJ EEN PUSH PAST. Het profiel beschrijft
# daarmee het volledige inkomende verwerkingsverzoek dat een beslispunt te zien
# krijgt. Bij een push is dat verzoek er ook: het leverproces van de RDW vraagt
# zijn eigen beslispunt om toestemming voordat het de set samenstelt en
# verstuurt. Het verschil met beleid.ttl is niet de vorm van het verzoek maar
# wie het doet — daar een medewerker via de outway, hier een geplande taak.
#
# Het anker realiseert twee dingen tegelijk, en dat is precies wat deze casus
# bijzonder maakt: de LEVERPLICHT (er gaat elk kwartaal een set uit) en het
# VERBOD OP HERLEIDING (er gaat geen sleutel mee). Eén selectieregel, twee
# normen. Het anker telt zelf niet mee in de status van de regel.
globrv:anker-samenstelling-bij-de-bron a odrl:Constraint , dpv:TechnicalMeasure ;
    rdfs:label "Samenstelling van de leverset bij de bron"@nl ,
               "Compilation of the delivery set at the source"@en ;
    odrl:leftOperand apnl:verwerkingsverzoek ;
    odrl:operator apnl:conformsToPolicy ;
    odrl:rightOperand globrv:selectieregels-brv-laadcapaciteit ;
    prov:wasDerivedFrom globrv:plicht-levering , globrv:verbod-herleiding .

# Het artefact waarnaar het anker delegeert: puur beschrijvend, net als
# openftv.ttl. Fictief, zoals de hele casus; de eerlijkheidsnoot zegt wat het
# is en wat het niet is.
globrv:selectieregels-brv-laadcapaciteit a apnl:RegoModule , schema:SoftwareSourceCode ;
    rdfs:label "Selectie- en samenstellingsregels leverset laadcapaciteit (Rego)"@nl ,
               "Selection and compilation rules for the charging capacity delivery set (Rego)"@en ;
    dct:identifier "brv/laadcapaciteit/levering.rego" ;
    schema:programmingLanguage "Rego" ;
    dct:format "application/vnd.rego" ;
    apnl:entrypoint "data.brv.levering.allow" ;
    rdfs:comment "Fictief artefact. Het beschrijft de beoogde verantwoordelijkheid van het leverproces bij de verstrekker: de populatie afbakenen (stekkervoertuigen van houders met een verblijfsobject in Vlierdam), de koppeling kenteken–houder–verblijfsobject in eigen huis leggen, en de herleidingssleutels — kenteken en burgerservicenummer — uit de leverset laten voordat zij de deur uit gaat. Er hoort geen bestand bij; deze casus toont de normlaag, niet de implementatie."@nl ,
                 "Fictitious artifact. It describes the intended responsibility of the delivery process at the provider: delimiting the population (plug-in vehicles of keepers with a dwelling unit in Vlierdam), performing the licence plate–keeper–dwelling unit linkage in house, and dropping the re-identification keys — licence plate and citizen service number — from the delivery set before it leaves. There is no file attached; this case shows the normative layer, not the implementation."@en .

# De vernietigingsplicht. ORGANISATORISCH geborgd, met dezelfde redenering als
# vlierdam:plicht-vernietiging in beleid.ttl: wat de gemeente met de set doet
# nadat zij binnen is, ziet geen enkel beslispunt. De marker staat op de plicht
# als geheel; er valt technisch niets uit te werken.
globrv:plicht-vernietiging a odrl:Duty , gd:afspraak , dpv:OrganisationalMeasure ;
    odrl:uid globrv:plicht-vernietiging ;
    dct:title "Vernietiging na afronding van de raming"@nl ,
              "Destruction after completion of the estimate"@en ;
    dct:description "De gemeente Vlierdam vernietigt een ontvangen leverset uiterlijk achttien maanden na ontvangst, en in elk geval zodra de capaciteitsraming van de betreffende planronde is vastgesteld. Wat daarna bewaard blijft is de raming zelf, op buurtniveau en zonder verblijfsobject-identificatie."@nl ,
                    "The municipality of Vlierdam destroys a received delivery set no later than eighteen months after receipt, and in any case as soon as the capacity estimate for the planning round concerned has been adopted. What remains afterwards is the estimate itself, at neighbourhood level and without dwelling unit identification."@en ;
    dct:subject gdonderwerp:verplichtingen-ontvanger ;
    odrl:assignee vlierdam:GemeenteVlierdam ;
    odrl:action odrl:delete ;
    odrl:target globrv:leverset-laadcapaciteit .

globrv:afspraak-evaluatie a odrl:Duty , gd:afspraak ;
    odrl:uid globrv:afspraak-evaluatie ;
    dct:title "Jaarlijkse evaluatie van de veldenlijst"@nl ,
              "Annual evaluation of the field list"@en ;
    dct:description "Partijen beoordelen jaarlijks of elk geleverd gegevenstype nog nodig is voor de capaciteitsraming. Een gegevenstype dat twee ramingen achtereen niet is gebruikt, vervalt uit de leverset."@nl ,
                    "The parties assess annually whether each delivered data type is still needed for the capacity estimate. A data type that has not been used in two consecutive estimates is removed from the delivery set."@en ;
    dct:subject gdonderwerp:tussentijdse-evaluatie ;
    odrl:assignee vlierdam:RDW , vlierdam:GemeenteVlierdam ;
    odrl:action odrl:reviewPolicy .

globrv:afspraak-opzegtermijn a odrl:Duty , gd:afspraak ;
    odrl:uid globrv:afspraak-opzegtermijn ;
    dct:title "Opzegging met drie maanden termijn"@nl ,
              "Termination with three months' notice"@en ;
    dct:description "Opschorting of opzegging gebeurt schriftelijk aan de eindverantwoordelijke functionaris van de andere partij, met een termijn van drie maanden. Deze afspraak bindt beide partijen."@nl ,
                    "Suspension or termination is communicated in writing to the other party's responsible officer, with three months' notice. This clause binds both parties."@en ;
    dct:subject gdonderwerp:opschorten-opzeggen ;
    odrl:assignee vlierdam:RDW , vlierdam:GemeenteVlierdam ;
    odrl:action odrl:inform .

# -----------------------------------------------------------------------------
# 3. Doelen, grondslagen en het verwerkingsbelang
#
# De doelen zijn vermeldingen in het verwerkingsregister van de betrokken
# partij; de overeenkomst verwijst ernaar en modelleert ze niet opnieuw.
# -----------------------------------------------------------------------------

globrv:doel-inventarisatie-laadcapaciteit a dpv:Purpose ;
    dct:title "Inventarisatie van de benodigde laadcapaciteit"@nl ,
              "Survey of the required charging capacity"@en ;
    dct:identifier "VLD-VR-0131" ;
    dct:description "Vermelding in het verwerkingsregister van de gemeente Vlierdam: het ramen, per straatsegment en per buurt, van het laadvermogen en de energievraag die de komende planperiode nodig zijn, als voorbereiding op de plaatsing van laadinfrastructuur en op de afstemming met de netbeheerder."@nl ,
                    "Entry in the processing register of the municipality of Vlierdam: estimating, per street segment and per neighbourhood, the charging power and energy demand required in the coming planning period, in preparation for the installation of charging infrastructure and for coordination with the grid operator."@en ;
    dpv:hasLegalBasis globrv:grondslag-convenant .

globrv:doel-verstrekking-onderzoek-statistiek a dpv:Purpose ;
    dct:title "Verstrekking van voertuiggegevens voor onderzoek en statistiek"@nl ,
              "Provision of vehicle data for research and statistics"@en ;
    dct:identifier "RDW-VR-0208" ;
    dct:description "Vermelding in het verwerkingsregister van de RDW: het verstrekken van gegevens uit het kentekenregister aan bestuursorganen ten behoeve van onderzoek, statistiek en beleidsvoorbereiding, in een vorm waarin de gegevens niet tot personen herleidbaar zijn."@nl ,
                    "Entry in the processing register of the RDW: providing data from the vehicle register to administrative bodies for research, statistics and policy preparation, in a form in which the data cannot be traced back to persons."@en ;
    dpv:hasLegalBasis globrv:grondslag-onderzoek .

# De gegevensdeling zelf als registervermelding; de overeenkomst verwijst ernaar
# met dct:references en modelleert het object niet verder.
globrv:registervermelding-gegevensdeling
    dct:identifier "GV-2026-031" ;
    dct:title "Gegevensdeling voertuigkenmerken laadcapaciteit Vlierdam (registervermelding)"@nl ,
              "Data sharing of vehicle characteristics for charging capacity in Vlierdam (register entry)"@en .

# Twee grondslagen, elk een compacte knoop in het grondslag-idioom van het
# neutrale vocabulaire. Geen autorisatiebesluit-structuur: die hoort bij een
# verstrekking op aanvraag, en dit is een levering die uit een convenant en een
# onderzoeksbepaling volgt.

globrv:grondslag-onderzoek a gdgrondslag:Wettelijk ;
    rdfs:label "Wettelijke onderzoeks- en statistiekbepaling kentekenregister"@nl ,
               "Statutory research and statistics provision of the vehicle register"@en ;
    dct:description "De verstrekking van gegevens uit het kentekenregister aan een bestuursorgaan ten behoeve van onderzoek en statistiek, mits de gegevens niet tot personen herleidbaar worden verstrekt. Fictieve bepaling."@nl ,
                    "The provision of data from the vehicle register to an administrative body for research and statistics, provided that the data are not provided in a form traceable to persons. Fictitious provision."@en .

globrv:grondslag-convenant a gdgrondslag:Vrijwillig ;
    rdfs:label "Convenant laadinfrastructuur Vlierdam"@nl ,
               "Charging infrastructure covenant Vlierdam"@en ;
    dct:description "De gemeente neemt deel aan een regionaal convenant over de uitrol van laadinfrastructuur; de capaciteitsinventarisatie is de eerste stap daaruit. Deelname is vrijwillig en de gemeente kan haar beëindigen."@nl ,
                    "The municipality participates in a regional covenant on the roll-out of charging infrastructure; the capacity survey is its first step. Participation is voluntary and the municipality may end it."@en ;
    # Bij een grondslag op basis van vrijwilligheid eist het model een
    # verantwoording dat wet- en regelgeving niet in de weg staan.
    gdvrijwillig:verantwoording """Voor de capaciteitsinventarisatie bestaat geen
wettelijk voorschrift dat de gemeente ertoe verplicht en evenmin een voorschrift
dat haar verbiedt: de gemeente kiest zelf of zij laadinfrastructuur aanlegt en
hoe zij die voorbereidt. De verwerking gaat niet verder dan de tien technische
voertuigkenmerken die de raming nodig heeft, bevat geen gegeven over een
houder, en eindigt zodra de gemeente het convenant beëindigt."""@nl ,
        """No statutory rule obliges the municipality to carry out the capacity
survey, and none forbids it: the municipality decides for itself whether to
install charging infrastructure and how to prepare for it. The processing goes
no further than the ten technical vehicle characteristics the estimate
requires, contains no datum about a keeper, and ends as soon as the
municipality leaves the covenant."""@en ;
    dct:source globrv:convenant-laadinfrastructuur .

globrv:convenant-laadinfrastructuur a dct:Standard ;
    dct:title "Convenant laadinfrastructuur Vlierdam 2026–2030 (fictief)"@nl ,
              "Charging infrastructure covenant Vlierdam 2026–2030 (fictitious)"@en ;
    owl:versionInfo "1.0" ;
    dct:issued "2026-05-12"^^xsd:date .

# Het verwerkingsbelang: het op regelgeving gebaseerde belang dat met deze
# verwerkingen is gemoeid, en dat de bewaartermijn- en vernietigingsafspraak
# draagt. Getypeerd als wettelijke grondslag, zoals het model dat voorschrijft.
globrv:belang-verantwoording a gdgrondslag:Wettelijk ;
    rdfs:label "Verantwoordingsbelang bij de capaciteitsraming"@nl ,
               "Accountability interest in the capacity estimate"@en ;
    dct:description "De gemeente moet kunnen verantwoorden waarop een besluit over de plaatsing van laadinfrastructuur berust; dit belang bepaalt hoe lang een leverset bewaard blijft en wanneer zij wordt vernietigd."@nl ,
                    "The municipality must be able to account for the basis of a decision on the installation of charging infrastructure; this interest determines how long a delivery set is retained and when it is destroyed."@en .

# -----------------------------------------------------------------------------
# 4. De rol-objecten, de akkoordverklaringen en de personen in functie
# -----------------------------------------------------------------------------

globrv:rol-verstrekker a gd:Verstrekker ;
    rdfs:label "Verstrekkersrol: RDW"@nl ,
               "Provider role: RDW"@en ;
    gd:partij vlierdam:RDW ;
    gd:doelVerstrekker globrv:doel-verstrekking-onderzoek-statistiek ;
    gd:heeftGrondslag globrv:grondslag-onderzoek ;
    gd:eindverantwoordelijkeFunctie globrv:functie-directeur-registers ;
    gd:akkoordverklaring globrv:akkoord-rdw .

globrv:rol-ontvanger a gd:Ontvanger ;
    rdfs:label "Ontvangersrol: gemeente Vlierdam"@nl ,
               "Recipient role: municipality of Vlierdam"@en ;
    gd:partij vlierdam:GemeenteVlierdam ;
    # Hetzelfde doel-IRI dat de doelbinding op de toestemming als rightOperand
    # draagt; de doelbinding blijft het normatieve mechanisme.
    gd:doelOntvanger globrv:doel-inventarisatie-laadcapaciteit ;
    gd:heeftGrondslag globrv:grondslag-convenant ;
    gd:eindverantwoordelijkeFunctie globrv:functie-wethouder-mobiliteit ;
    gd:akkoordverklaring globrv:akkoord-vlierdam .

globrv:akkoord-rdw a gd:Akkoordverklaring , prov:Activity ;
    rdfs:label "Akkoordverklaring namens de RDW"@nl ,
               "Declaration of agreement on behalf of the RDW"@en ;
    gd:namens vlierdam:RDW ;
    gdnamens:verstrekker vlierdam:RDW ;
