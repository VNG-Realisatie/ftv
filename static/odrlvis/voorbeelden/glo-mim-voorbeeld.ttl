# 6 — geboortedatum (datum, met ontbrekendwaarde)
#
# DE SCHEIDING SUBSTANTIEF/SENTINEL is de kern van de DDI-CDI-waardetypering:
# geldige waarden en ontbrekendwaarden zijn twee domeinen, niet één lijst met
# uitzonderingen. Hier draagt zij de onvolledige geboortedatum, die in een
# persoonsregistratie een gewoon verschijnsel is.
vlierdam:veld-brp-geboorte-datum a gd:Gegevenstype ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/odrl/veld-brp-geboorte-datum"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-GEBOORTEDATUM-001" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De geboortedatum van de bevraagde persoon." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-externalDefinition glo:term-geboortedatum ;
    cdi:ConceptualVariable_measures_UnitType glo:unittype-natuurlijk-persoon ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Date" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain glo:waardedomein-geboortedatum ;
    cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain glo:waardedomein-geboortedatum-onvolledig ;
    gd:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

glo:waardedomein-geboortedatum a cdi:SubstantiveValueDomain ;
    rdfs:label "Waardedomein geboortedatum"@nl , "Value domain date of birth"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "Date" ] ;
    cdi:SubstantiveValueDomain_isDescribedBy_ValueAndConceptDescription [
        cdi:ValueAndConceptDescription-description [ cdi:InternationalString-languageSpecificString
            [ cdi:LanguageString-content "Kalenderdatum, niet in de toekomst ten opzichte van het moment van bevraging." ;
              cdi:LanguageString-language "nl" ] ] ;
        cdi:ValueAndConceptDescription-formatPattern [ cdi:ControlledVocabularyEntry-entryValue "JJJJ-MM-DD" ] ] .

glo:waardedomein-geboortedatum-onvolledig a cdi:SentinelValueDomain ;
    rdfs:label "Ontbrekendwaarden geboortedatum"@nl , "Sentinel values date of birth"@en ;
    cdi:SentinelValueDomain_takesValuesFrom_EnumerationDomain glo:codelijst-onvolledige-datum .

glo:codelijst-onvolledige-datum a cdi:CodeList ;
    rdfs:label "Codelijst onvolledige datum"@nl , "Code list for an incomplete date"@en ;
    cdi:EnumerationDomain-name [ cdi:ObjectName-name "onvolledigeDatum" ] ;
    cdi:CodeList_has_Code glo:code-datum-onbekend , glo:code-dag-onbekend ;
    cdi:EnumerationDomain_references_CategorySet glo:categorieen-onvolledige-datum .

glo:code-datum-onbekend a cdi:Code ;
    rdfs:label "0000-00-00 — datum onbekend"@nl , "0000-00-00 — date unknown"@en ;
    cdi:Code_denotes_Category glo:categorie-datum-onbekend ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "0000-00-00" ] ] .

glo:code-dag-onbekend a cdi:Code ;
    rdfs:label "JJJJ-MM-00 — dag onbekend"@nl , "JJJJ-MM-00 — day unknown"@en ;
    cdi:Code_denotes_Category glo:categorie-dag-onbekend ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "JJJJ-MM-00" ] ] .

glo:categorieen-onvolledige-datum a cdi:CategorySet ;
    rdfs:label "Categorieën onvolledige datum"@nl , "Categories for an incomplete date"@en ;
    cdi:ConceptSystem-name [ cdi:ObjectName-name "onvolledigeDatumCategorieen" ] ;
    cdi:CategorySet_has_Category glo:categorie-datum-onbekend , glo:categorie-dag-onbekend .

glo:categorie-datum-onbekend a cdi:Category ;
    rdfs:label "datum onbekend"@nl , "date unknown"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "datumOnbekend" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De geboortedatum is bij de inschrijving niet vastgesteld." ;
          cdi:LanguageString-language "nl" ] ] .

glo:categorie-dag-onbekend a cdi:Category ;
    rdfs:label "dag onbekend"@nl , "day unknown"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "dagOnbekend" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "Jaar en maand zijn bekend, de dag niet." ;
          cdi:LanguageString-language "nl" ] ] .

glo:gegevensveld-geboortedatum a gd:Gegevensveld ;
    rdfs:label "veld geboortedatum"@nl , "field date of birth"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/gegevensveld-geboortedatum"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "geboortedatum" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string (ISO 8601)" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout glo:tgm-brp-antwoord ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired true ;
        cdi:ValueMapping-format [ cdi:ControlledVocabularyEntry-entryValue "YYYY-MM-DD" ] ] .

glo:mapping-geboortedatum a cdi:VariableRelationship ;
    rdfs:label "Gegevenstypemapping geboortedatum"@nl , "Data type mapping date of birth"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable vlierdam:veld-brp-geboorte-datum ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable glo:gegevensveld-geboortedatum .

# 7 — gemeente van inschrijving (CATEGORISCH)
#
# Dit is het gegevenstype waarop de leverset is afgebakend: beleid.ttl eist op
# de inway dat de bevraagde persoon ingezetene van Vlierdam is, en hier is dat
# de waarde uit een opgesomd waardebereik. Het bereik telt twee waarden en niet
# één, omdat een antwoord ook een persoon kan betreffen die inmiddels is
# vertrokken; de verstrekker laat die buiten het antwoord, en de codelijst maakt
# zichtbaar dat dat een beslissing is en geen onmogelijkheid.
vlierdam:veld-brp-gemeenteVanInschrijving a gd:GegevenstypeCategorisch ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/odrl/veld-brp-gemeenteVanInschrijving"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "GT-GEMEENTE-001" ] ;
    cdi:Concept-definition [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De gemeente waar de bevraagde persoon als ingezetene staat ingeschreven." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:Concept-externalDefinition glo:term-gemeente-van-inschrijving ;
    cdi:ConceptualVariable_measures_UnitType glo:unittype-natuurlijk-persoon ;
    cdi:RepresentedVariable-hasIntendedDataType [
        cdi:ControlledVocabularyEntry-entryValue "Categorical" ;
        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain glo:waardedomein-gemeente ;
    gd:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

glo:waardedomein-gemeente a cdi:SubstantiveValueDomain ;
    rdfs:label "Waardebereik gemeente van inschrijving"@nl ,
               "Value range municipality of registration"@en ;
    cdi:ValueDomain-recommendedDataType [ cdi:ControlledVocabularyEntry-entryValue "String" ] ;
    cdi:SubstantiveValueDomain_takesValuesFrom_EnumerationDomain glo:codelijst-gemeenten .

glo:codelijst-gemeenten a cdi:CodeList ;
    rdfs:label "Codelijst gemeenten in de bevraging"@nl , "Code list of municipalities in the query"@en ;
    cdi:EnumerationDomain-name [ cdi:ObjectName-name "gemeenten" ] ;
    cdi:CodeList_has_Code glo:code-gemeente-vlierdam , glo:code-gemeente-elders ;
    cdi:EnumerationDomain_references_CategorySet glo:categorieen-gemeente .

glo:code-gemeente-vlierdam a cdi:Code ;
    rdfs:label "0001 — Vlierdam"@nl , "0001 — Vlierdam"@en ;
    cdi:Code_denotes_Category glo:categorie-gemeente-vlierdam ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "0001" ] ] .

glo:code-gemeente-elders a cdi:Code ;
    rdfs:label "9999 — buiten Vlierdam"@nl , "9999 — outside Vlierdam"@en ;
    cdi:Code_denotes_Category glo:categorie-gemeente-elders ;
    cdi:Code_uses_Notation [ cdi:Notation-content [ cdi:TypedString-content "9999" ] ] .

glo:categorieen-gemeente a cdi:CategorySet ;
    rdfs:label "Categorieën gemeente van inschrijving"@nl ,
               "Categories for municipality of registration"@en ;
    cdi:ConceptSystem-name [ cdi:ObjectName-name "gemeenteCategorieen" ] ;
    cdi:CategorySet_has_Category glo:categorie-gemeente-vlierdam , glo:categorie-gemeente-elders .

glo:categorie-gemeente-vlierdam a cdi:Category ;
    rdfs:label "ingezetene van Vlierdam"@nl , "resident of Vlierdam"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "vlierdam" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De persoon staat in Vlierdam ingeschreven; dit is de enige waarde die in een antwoord voorkomt." ;
          cdi:LanguageString-language "nl" ] ] .

glo:categorie-gemeente-elders a cdi:Category ;
    rdfs:label "ingezetene van een andere gemeente"@nl , "resident of another municipality"@en ;
    cdi:Concept-name [ cdi:ObjectName-name "elders" ] ;
    cdi:Category-descriptiveText [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De persoon staat elders ingeschreven; de verstrekker laat zo iemand buiten het antwoord, en deze waarde komt in een levering dus niet voor." ;
          cdi:LanguageString-language "nl" ] ] .

glo:gegevensveld-gemeente-van-inschrijving a gd:Gegevensveld ;
    rdfs:label "veld gemeente van inschrijving"@nl , "field municipality of registration"@en ;
    cdi:Concept-identifier [ cdi:Identifier-uri "https://vlierdam.example/glo/gegevensveld-gemeente-van-inschrijving"^^xsd:anyURI ] ;
    cdi:Concept-name [ cdi:ObjectName-name "gemeenteVanInschrijving" ] ;
    cdi:InstanceVariable-physicalDataType [ cdi:ControlledVocabularyEntry-entryValue "string" ] ;
    cdi:InstanceVariable_has_PhysicalSegmentLayout glo:tgm-brp-antwoord ;
    cdi:InstanceVariable_has_ValueMapping [
        cdi:ValueMapping-isRequired true ;
        cdi:ValueMapping-length 4 ] .

glo:mapping-gemeente-van-inschrijving a cdi:VariableRelationship ;
    rdfs:label "Gegevenstypemapping gemeente van inschrijving"@nl ,
               "Data type mapping municipality of registration"@en ;
    cdi:VariableRelationship_hasSource_ConceptualVariable vlierdam:veld-brp-gemeenteVanInschrijving ;
    cdi:VariableRelationship_hasTarget_ConceptualVariable glo:gegevensveld-gemeente-van-inschrijving .

# De zeven mappings in één structuur.
glo:variabelestructuur-brp-laadpalen a cdi:VariableStructure ;
    rdfs:label "Variabelenstructuur BRP-bevraging laadpalen"@nl ,
               "Variable structure for charging-station population register queries"@en ;
    cdi:VariableStructure-purpose [ cdi:InternationalString-languageSpecificString
        [ cdi:LanguageString-content "De gegevenstypemappingen tussen het logisch en het technisch gegevensmodel van de leverset." ;
          cdi:LanguageString-language "nl" ] ] ;
    cdi:VariableStructure_structures_VariableCollection glo:gegevensset-brp-laadpalen ;
    cdi:VariableStructure_has_VariableRelationship
        glo:mapping-bsn , glo:mapping-voornamen , glo:mapping-geslachtsnaam ,
        glo:mapping-adresregel1 , glo:mapping-adresregel2 ,
        glo:mapping-geboortedatum , glo:mapping-gemeente-van-inschrijving .

# =============================================================================
# 9. WAT DIT BESTAND AAN BESTAANDE KNOPEN TOEVOEGT
#
# De aanvullingen staan hierboven op hun inhoudelijke plaats; deze lijst maakt
# in één oogopslag zichtbaar welke knopen uit de andere vlierdam-bestanden er
# tripels bij krijgen. Geen van die bestanden is gewijzigd.
#
#   vlierdam:brp-velden-laadpalen  (velden.ttl)
#       + gd:Gegevensleversetspecificatie met code, beschrijving, populatie,
#         logisch gegevensmodel, filtergegevenstype, gegevensmiddel,
#         classificaties, rubricering en drie leversetafspraken (sectie 7).
#   vlierdam:doelbinding-registratie-laadpalen  (vocabulaire.ttl)
#       + dpv:Purpose met beschrijving en twee grondslagen (sectie 5).
#   vlierdam:gemeentesecretaris  (vocabulaire.ttl)
#       + org:Role, zodat de functie als eindverantwoordelijke kan dienen
#         (sectie 6).
#   de zeven veldknopen  (velden.ttl)
#       + gd:Gegevenstype respectievelijk gd:GegevenstypeCategorisch, met
#         begrip, waardetype, waardedomein en classificaties (sectie 8c).
#
# Alleen aangehaald, niet aangevuld: vlierdam:RvIG, vlierdam:GemeenteVlierdam,
# vlierdam:set-rvig-inway, vlierdam:plicht-vernietiging,
# vlierdam:plicht-traceparent en vlierdam:medewerkers-burgerzaken.
# =============================================================================

## --- data/vlierdam/glo-shapes.ttl ---
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix dprod:  <https://www.omg.org/spec/DPROD/dprod/> .
@prefix cdi:    <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix gd:     <https://gegevensdeling.example/def/> .

# =============================================================================
# Formulier-shapes bij glo-vocabulaire.ttl (Visualisatie-note §8).
#
# WAT ZE DOEN. Deze shapes beschrijven WEERGAVE en toetsen niets: welke
# eigenschappen van een knoop een generieke viewer toont, in welke volgorde,
# onder welke kop en met welke widget. Zij dragen geen sh:message en leveren dus
# geen eis. Zonder deze shapes staan de knopen van een
# gegevensleveringsovereenkomst er wel, maar zonder veldkoppen en zonder vouwen:
# de GLS-kaart klapt dan niet open naar haar leverset, haar gegevensmiddel en
# haar veldlaag.
#
# WAAROM EEN EIGEN BESTAND. Het beleidscorpus van Vlierdam (beleid.ttl,
# velden.ttl, vocabulaire.ttl, openftv.ttl) heeft deze vormen niet nodig. Wie
# alleen dat corpus laadt, laadt dit bestand niet en heeft er dus geen last van;
# wie de overeenkomst erbij laadt, laadt dit bestand mee.
#
# DE SUBSET IS DE GRENS. Gebruikt wordt precies wat de Visualisatie-note §8
# vastlegt: sh:NodeShape + sh:targetClass (met subklasse-sluiting), sh:property
# met sh:path (ook [ sh:inversePath … ]), sh:name, sh:description, sh:order,
# sh:group + sh:PropertyGroup, dash:viewer en dash:propertyRole. Drie grenzen
# volgen daaruit:
#
#   1. GEEN SEQUENCE PATHS. De DDI-CDI-veldlaag legt naam, code, beschrijving en
#      waardetype achter een gestructureerd datatype (cdi:ObjectName,
#      cdi:Identifier, cdi:InternationalString, cdi:ControlledVocabularyEntry).
#      Die waarden liggen één hop te diep voor een enkelvoudig pad. De
#      veldlaagformulieren tonen daarom wat in één stap wél bereikbaar is: de
#      relaties naar andere knopen. Een rij die op de tussenknoop zou uitkomen
#      is weggelaten in plaats van als "(anoniem)" getoond.
#   2. ÉÉN sh:targetClass PER SHAPE. Een lezer neemt de eerste doelklasse; een
#      shape met drie doelen zou er twee laten liggen. De drie afspraaksoorten
#      krijgen daarom elk hun eigen formulier.
#   3. GEEN SHAPE-OVERERVING. sh:node zit niet in de subset, dus wat Verstrekker
#      en Ontvanger delen staat in beide shapes; de samenvattende klasse
#      Overeenkomstrol krijgt een derde, volledige shape voor wie alleen die
#      zet.
#
# DE KOP VAN EEN VELDLAAGKNOOP komt van rdfs:label wanneer de knoop er een
# draagt, en valt anders terug op de staart van de IRI — de naam achter
# cdi:ObjectName is door grens 1 onbereikbaar. De knopen van het voorbeeld
# dragen daarom een rdfs:label.
#
# DE FORMULIEREN ZIJN LEVERINGSVORM-NEUTRAAL, net als het vocabulaire: geen rij
# hieronder veronderstelt een bevraging of juist een bestandslevering. De
# rij "Leverritme" op het gegevensmiddelformulier blijft bij levering op verzoek
# eenvoudig leeg.
# =============================================================================

# --- De groepen waarin de rijen vallen ---------------------------------------
# Eén reeks koppen voor alle formulieren hieronder, zodat een lezer die van een
# overeenkomst naar een specificatie, een leverset en een gegevensmiddel
# doorklikt telkens dezelfde indeling ziet. De sh:order van de groep bepaalt
# haar plaats tussen de andere blokken, de sh:order van de rij haar plaats
# binnen de groep; de rijnummers lopen daarom per shape op in tientallen die de
# groepsvolgorde volgen.

gd:GroepKenmerken a sh:PropertyGroup ;
    rdfs:label "Kenmerken"@nl , "Characteristics"@en ;
    sh:order 0 .
gd:GroepInhoud a sh:PropertyGroup ;
    rdfs:label "Inhoud en afbakening"@nl , "Content and scope"@en ;
    sh:order 1 .
gd:GroepStructuur a sh:PropertyGroup ;
    rdfs:label "Structuur en modellen"@nl , "Structure and models"@en ;
    sh:order 2 .
gd:GroepLevering a sh:PropertyGroup ;
    rdfs:label "Levering"@nl , "Delivery"@en ;
    sh:order 3 .
gd:GroepAfspraken a sh:PropertyGroup ;
    rdfs:label "Afspraken"@nl , "Clauses"@en ;
    sh:order 4 .
gd:GroepVerantwoordelijkheid a sh:PropertyGroup ;
    rdfs:label "Rollen en verantwoordelijkheid"@nl , "Roles and responsibility"@en ;
    sh:order 5 .
gd:GroepSamenhang a sh:PropertyGroup ;
    rdfs:label "Samenhang"@nl , "Context"@en ;
    sh:order 6 .
gd:GroepHerkomst a sh:PropertyGroup ;
    rdfs:label "Herkomst en verwijzingen"@nl , "Provenance and references"@en ;
    sh:order 7 .

# =============================================================================
# A. De overeenkomst en wat eraan hangt
# =============================================================================

# De kaartweergave plaatst titel, geldigheid en regels zelf; deze shape benoemt
# en ordent de velden die de kaart niet plaatst. De drie paden die de
# overeenkomst met de rol-objecten deelt — doelVerstrekker, akkoordverklaring en
# het verwerkingsbelang als de grond van het geheel — staan hier onder dezelfde
# kop en met hetzelfde rijnummer als op het rolformulier, zodat wie doorklikt
# hetzelfde blok terugziet. Het gat op 53 is de eindverantwoordelijke functie:
# die hangt aan de rol en niet aan de overeenkomst.
#
# Twee rijen staan met opzet elders dan hun naamgenoot op de GLS-kaart.
# gd:noodzaak valt onder "Inhoud en afbakening" omdat de noodzaakbeoordeling de
# deling afbakent — zij is hier wat de populatiebeschrijving op de GLS-kaart is.
# En dct:conformsTo staat onder "Herkomst en verwijzingen" in plaats van onder
# "Structuur en modellen": op de GLS wijst dat pad naar het begrippenkader en
# het gegevensmodel, op de overeenkomst naar het modeldocument waarnaar zij is
# opgesteld.
gd:GloFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevensleveringsovereenkomst ;
    rdfs:label "Formulier gegevensleveringsovereenkomst"@nl , "Data delivery agreement form"@en ;
    sh:property [
        sh:path gd:heeftStatus ;
        sh:name "Status"@nl , "Status"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:noodzaak ;
        sh:name "Noodzaak"@nl , "Necessity"@en ;
        sh:description """Waarom deze gegevens voor dit doel nodig zijn, en waarom
niet meer dan deze."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path gd:gegevensleveringsspecificatie ;
        sh:name "Gegevensleveringsspecificatie"@nl , "Data delivery specification"@en ;
        sh:group gd:GroepLevering ; sh:order 40 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftRol ;
        sh:name "Rollen"@nl , "Roles"@en ;
        sh:description """De verstrekkers- en de ontvangersrol van deze
overeenkomst, elk met een eigen partij, doel, grondslag, akkoordverklaring en
eindverantwoordelijke functie."""@nl ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:doelVerstrekker ;
        sh:name "Doel verstrekker"@nl , "Provider purpose"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 51 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:verwerkingsbelang ;
        sh:name "Verwerkingsbelang"@nl , "Processing interest"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 52 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:akkoordverklaring ;
        sh:name "Akkoordverklaringen"@nl , "Declarations of agreement"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 54 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:name "Voldoet aan"@nl , "Conforms to"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:references ;
        sh:name "Verwijzingen"@nl , "References"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:AkkoordverklaringFormShape a sh:NodeShape ;
    sh:targetClass gd:Akkoordverklaring ;
    rdfs:label "Akkoordverklaringsformulier"@nl , "Declaration form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path gd:namens ;
        sh:name "Namens"@nl , "On behalf of"@en ;
        sh:order 1 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:name "Afgelegd door"@nl , "Declared by"@en ;
        sh:order 2 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:date ;
        sh:name "Datum"@nl , "Date"@en ;
        sh:order 3 ; dash:viewer dash:LiteralViewer ;
    ] .

# --- De rol-objecten ---------------------------------------------------------
#
# Drie shapes voor twee klassen plus hun samenvattende bovenklasse. Wie alleen
# gd:Overeenkomstrol zet krijgt het volledige formulier met beide doelrijen — de
# lege verdwijnt vanzelf; wie de verbijzondering zet krijgt de rij die bij zijn
# kant hoort, met de naam die daarbij past. De partij staat als kerngegeven
# boven aan de kaart: zonder haar is een rol een lege huls.

gd:OvereenkomstrolFormShape a sh:NodeShape ;
    sh:targetClass gd:Overeenkomstrol ;
    rdfs:label "Rolformulier"@nl , "Agreement role form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path gd:partij ;
        sh:name "Partij"@nl , "Party"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:doelVerstrekker ;
        sh:name "Doel verstrekker"@nl , "Provider purpose"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:doelOntvanger ;
        sh:name "Doel ontvanger"@nl , "Recipient purpose"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 51 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftGrondslag ;
        sh:name "Grondslag"@nl , "Legal basis"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 52 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:eindverantwoordelijkeFunctie ;
        sh:name "Eindverantwoordelijke functie"@nl , "Accountable role"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 53 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:akkoordverklaring ;
        sh:name "Akkoordverklaring"@nl , "Declaration of agreement"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 54 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:heeftRol ] ;
        sh:name "Rol in"@nl , "Role in"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:VerstrekkerFormShape a sh:NodeShape ;
    sh:targetClass gd:Verstrekker ;
    rdfs:label "Verstrekkersrol-formulier"@nl , "Provider role form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path gd:partij ;
        sh:name "Verstrekkende partij"@nl , "Providing party"@en ;
        sh:description """De partij die de gegevens levert; zij is de odrl:assigner
van de overeenkomst."""@nl ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:doelVerstrekker ;
        sh:name "Doel verstrekker"@nl , "Provider purpose"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftGrondslag ;
        sh:name "Grondslag"@nl , "Legal basis"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 52 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:eindverantwoordelijkeFunctie ;
        sh:name "Eindverantwoordelijke functie"@nl , "Accountable role"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 53 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:akkoordverklaring ;
        sh:name "Akkoordverklaring"@nl , "Declaration of agreement"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 54 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:heeftRol ] ;
        sh:name "Rol in"@nl , "Role in"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:OntvangerFormShape a sh:NodeShape ;
    sh:targetClass gd:Ontvanger ;
    rdfs:label "Ontvangersrol-formulier"@nl , "Recipient role form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path gd:partij ;
        sh:name "Ontvangende partij"@nl , "Receiving party"@en ;
        sh:description """De partij die de gegevens ontvangt; zij is de
odrl:assignee van de overeenkomst."""@nl ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:doelOntvanger ;
        sh:name "Doel ontvanger"@nl , "Recipient purpose"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 51 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftGrondslag ;
        sh:name "Grondslag"@nl , "Legal basis"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 52 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:eindverantwoordelijkeFunctie ;
        sh:name "Eindverantwoordelijke functie"@nl , "Accountable role"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 53 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:akkoordverklaring ;
        sh:name "Akkoordverklaring"@nl , "Declaration of agreement"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 54 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:heeftRol ] ;
        sh:name "Rol in"@nl , "Role in"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

# =============================================================================
# B. Het datasetniveau van de gegevensleveringsspecificatie
# =============================================================================

gd:GlsFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevensleveringsspecificatie ;
    rdfs:label "GLS-formulier"@nl , "GLS form"@en ;
    sh:property [
        sh:path dct:title ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Beschrijving"@nl , "Description"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "GLS-code"@nl , "GLS code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Soort"@nl , "Kind"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path owl:versionInfo ;
        sh:name "Versie"@nl , "Version"@en ;
        sh:group gd:GroepKenmerken ; sh:order 11 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path gd:populatiebeschrijving ;
        sh:name "Populatiebeschrijving"@nl , "Population description"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path gd:classificatie ;
        sh:name "Classificaties"@nl , "Classifications"@en ;
        sh:description """De classificaties van de gegevensdeling als geheel; een
gegevensleverset kan daar met eigen classificaties van afwijken."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:name "Voldoet aan"@nl , "Conforms to"@en ;
        sh:description """Het begrippenkader met de termen van deze deling en het
logisch gegevensmodel met haar gegevenstypen."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dprod:outputDataset ;
        sh:name "Gegevensleversetspecificaties"@nl , "Delivery set specifications"@en ;
        sh:group gd:GroepLevering ; sh:order 40 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dprod:outputPort ;
        sh:name "Leverkanaal"@nl , "Delivery channel"@en ;
        sh:group gd:GroepLevering ; sh:order 41 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftAfspraak ;
        sh:name "GLS-afspraken"@nl , "GLS clauses"@en ;
        sh:group gd:GroepAfspraken ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path odrl:hasPolicy ;
        sh:name "Gegevensleveringsovereenkomst"@nl , "Data delivery agreement"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 55 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:contactpersoon ;
        sh:name "Contactpersonen"@nl , "Contact persons"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 56 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:source ;
        sh:name "Vindplaats"@nl , "Location"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:URIViewer ;
    ] ;
    sh:property [
        sh:path dct:references ;
        sh:name "Verwijzingen"@nl , "References"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:LeversetspecificatieFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevensleversetspecificatie ;
    rdfs:label "Gegevensleversetspecificatie-formulier"@nl , "Delivery set specification form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Beschrijving"@nl , "Description"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "Leversetcode"@nl , "Delivery set code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path gd:populatiebeschrijving ;
        sh:name "Populatiebeschrijving"@nl , "Population description"@en ;
        sh:description "De afbakening van déze leverset binnen de populatie van de gegevensdeling."@nl ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path gd:classificatie ;
        sh:name "Classificaties"@nl , "Classifications"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:accessRights ;
        sh:name "Rubricering"@nl , "Security marking"@en ;
        sh:group gd:GroepInhoud ; sh:order 22 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:name "Voldoet aan"@nl , "Conforms to"@en ;
        sh:description "Het logisch gegevensmodel van deze leverset."@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:filtertOpGegevenstype ;
        sh:name "Filtert op gegevenstype"@nl , "Filtered on data type"@en ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dcat:distribution ;
        sh:name "Gegevensmiddelspecificaties"@nl , "Delivery medium specifications"@en ;
        sh:group gd:GroepLevering ; sh:order 40 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftAfspraak ;
        sh:name "Gegevensleversetafspraken"@nl , "Delivery set clauses"@en ;
        sh:group gd:GroepAfspraken ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath dprod:outputDataset ] ;
        sh:name "Onderdeel van"@nl , "Part of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:MiddelspecificatieFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevensmiddelspecificatie ;
    rdfs:label "Gegevensmiddelspecificatie-formulier"@nl , "Delivery medium specification form"@en ;
    sh:property [
        sh:path dct:title ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Beschrijving"@nl , "Description"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "Gegevensmiddelcode"@nl , "Delivery medium code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path dcat:mediaType ;
        sh:name "Mediatype"@nl , "Media type"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:name "Voldoet aan"@nl , "Conforms to"@en ;
        sh:description "Het technisch gegevensmodel van dit gegevensmiddel."@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    # De tweede brug naar de veldlaag. Het gegevensmiddel is aan de DPROD-kant de
    # distributie en aan de DDI-CDI-kant de fysieke dataset op dezelfde IRI, en
    # het is de fysieke dataset die haar instantievariabelen opsomt. Deze rij
    # blijft leeg zolang een bron alleen het datasetniveau beschrijft, en vult
    # zich zodra de veldlaag erbij komt.
    sh:property [
        sh:path cdi:PhysicalDataSet_has_InstanceVariable ;
        sh:name "Gegevensvelden"@nl , "Data fields"@en ;
        sh:description "De gegevensvelden die in dit gegevensmiddel worden overgedragen."@nl ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:heeftAfspraak ;
        sh:name "Gegevensmiddelafspraken"@nl , "Delivery medium clauses"@en ;
        sh:group gd:GroepAfspraken ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath dcat:distribution ] ;
        sh:name "Onderdeel van"@nl , "Part of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

# HET LEVERKANAAL. De uitvoerpoort had tot nu toe geen formulier: zij is een
# kale dcat:DataService en de viewer toonde haar als naamloos doel van
# dprod:outputPort, terwijl de knoop in vlierdam-glo.ttl titel, beschrijving,
# eindpunt, protocol, beveiligingsschema én het beleid draagt dat op het
# koppelvlak beslist. Dat laatste is hier het interessantst: de poort is de
# plek waar de overeenkomst en het beleid elkaar raken.
#
# De rijen zijn precies wat deze bestanden dragen. Een profiel dat zich
# conform DCAT-AP-NL 3.0 verklaart heeft dezelfde shape met meer rijen
# (toegangsniveau, thema, licentie, eindpuntbeschrijving, uitgever,
# contactpunt), want dat profiel moet die eigenschappen vullen. Deze
# bestanden claimen geen toepassingsprofiel en krijgen die rijen dus niet —
# een lege rij is geen dekking.
gd:LeverkanaalFormShape a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    rdfs:label "Leverkanaalformulier"@nl , "Delivery channel form"@en ;
    sh:property [
        sh:path dct:title ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Beschrijving"@nl , "Description"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dcat:endpointURL ;
        sh:name "Eindpunt-URL"@nl , "Endpoint URL"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:URIViewer ;
    ] ;
    sh:property [
        sh:path dprod:protocol ;
        sh:name "Protocol"@nl , "Protocol"@en ;
        sh:group gd:GroepLevering ; sh:order 40 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dprod:securitySchemaType ;
        sh:name "Beveiligingsschema"@nl , "Security schema"@en ;
        sh:group gd:GroepLevering ; sh:order 41 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path odrl:hasPolicy ;
        sh:name "Beslispunt op dit koppelvlak"@nl , "Decision point on this interface"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path dprod:isAccessServiceOf ;
        sh:name "Ontsluit gegevensmiddel"@nl , "Serves delivery medium"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath dprod:outputPort ] ;
        sh:name "Onderdeel van"@nl , "Part of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] .

# De drie afspraaksoorten, elk met een eigen shape (grens 2). Het onderwerp is
# het kerngegeven: het zegt waarover de afspraak gaat voordat de tekst dat doet.

gd:GlsAfspraakFormShape a sh:NodeShape ;
    sh:targetClass gd:glsafspraak ;
    rdfs:label "GLS-afspraakformulier"@nl , "GLS clause form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Afspraaktekst"@nl , "Clause text"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dct:subject ;
        sh:name "Onderwerp"@nl , "Topic"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path odrl:assignee ;
        sh:name "Gebonden partijen"@nl , "Bound parties"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:heeftAfspraak ] ;
        sh:name "Onderdeel van"@nl , "Part of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:LeversetafspraakFormShape a sh:NodeShape ;
    sh:targetClass gd:leversetafspraak ;
    rdfs:label "Gegevensleversetafspraak-formulier"@nl , "Delivery set clause form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Afspraaktekst"@nl , "Clause text"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dct:subject ;
        sh:name "Onderwerp"@nl , "Topic"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path odrl:assignee ;
        sh:name "Gebonden partijen"@nl , "Bound parties"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:heeftAfspraak ] ;
        sh:name "Onderdeel van"@nl , "Part of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:MiddelafspraakFormShape a sh:NodeShape ;
    sh:targetClass gd:middelafspraak ;
    rdfs:label "Gegevensmiddelafspraak-formulier"@nl , "Delivery medium clause form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:name "Afspraaktekst"@nl , "Clause text"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path dct:subject ;
        sh:name "Onderwerp"@nl , "Topic"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LabelViewer ;
    ] ;
    # Leeg bij een levering op verzoek, gevuld bij een levering met een vast
    # ritme. De rij staat hier omdat de frequentie-afspraak het machineleesbare
    # ritme draagt wanneer er een is.
    sh:property [
        sh:path dprod:recurrence ;
        sh:name "Leverritme (RRULE)"@nl , "Recurrence (RRULE)"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path odrl:assignee ;
        sh:name "Gebonden partijen"@nl , "Bound parties"@en ;
        sh:group gd:GroepVerantwoordelijkheid ; sh:order 50 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:heeftAfspraak ] ;
        sh:name "Onderdeel van"@nl , "Part of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

# =============================================================================
# C. De veldlaag
#
# Begrippenkader en term staan op SKOS en tonen daarom hun eigen naam en
# definitie. Wat op DDI-CDI staat kan dat niet: naam, code, beschrijving en
# waardetype liggen achter een sequence path (grens 1). Deze formulieren tonen
# daar wat in één stap bereikbaar is — de relaties — zodat de veldlaag ten
# minste doorklikbaar is: gegevensset → gegevenstype → waardedomein →
# gegevensveld → technisch gegevensmodel.
# =============================================================================

gd:BegrippenkaderFormShape a sh:NodeShape ;
    sh:targetClass gd:Begrippenkader ;
    rdfs:label "Begrippenkaderformulier"@nl , "Terminology form"@en ;
    sh:property [
        sh:path dct:title ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "Begrippenkadercode"@nl , "Terminology code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath skos:inScheme ] ;
        sh:name "Termen"@nl , "Terms"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath dct:conformsTo ] ;
        sh:name "Gebruikt door"@nl , "Used by"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:TermFormShape a sh:NodeShape ;
    sh:targetClass gd:Term ;
    rdfs:label "Termformulier"@nl , "Term form"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:name "Termbeschrijving"@nl , "Term description"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:name "Begrippenkader"@nl , "Terminology"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:Concept-externalDefinition ] ;
        sh:name "Gebruikt door gegevenstype"@nl , "Used by data type"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:GegevenssetFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevensset ;
    rdfs:label "Gegevenssetformulier"@nl , "Data set form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path cdi:VariableCollection_has_ConceptualVariable ;
        sh:name "Gegevenstypen"@nl , "Data types"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:GegevenstypeFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevenstype ;
    rdfs:label "Gegevenstypeformulier"@nl , "Data type form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Soort"@nl , "Kind"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:classificatie ;
        sh:name "Classificaties"@nl , "Classifications"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:Concept-externalDefinition ;
        sh:name "Term uit het begrippenkader"@nl , "Term from the terminology"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain ;
        sh:name "Waardedomein"@nl , "Value domain"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain ;
        sh:name "Ontbrekendwaarden"@nl , "Sentinel values"@en ;
        sh:description """Het waardedomein van de waarden die "geen waarde"
betekenen; DDI-CDI houdt die gescheiden van de geldige waarden."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:VariableCollection_has_ConceptualVariable ] ;
        sh:name "In gegevensset"@nl , "In data set"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:DataStructureComponent_isDefinedBy_RepresentedVariable ] ;
        sh:name "Component in het logisch gegevensmodel"@nl , "Component in the logical data model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:VariableRelationship_hasSource_ConceptualVariable ] ;
        sh:name "Gegevenstypemappings"@nl , "Data type mappings"@en ;
        sh:group gd:GroepSamenhang ; sh:order 62 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:filtertOpGegevenstype ] ;
        sh:name "Filtert de gegevensleverset"@nl , "Filters the delivery set"@en ;
        sh:group gd:GroepSamenhang ; sh:order 63 ;
        dash:viewer dash:LabelViewer ;
    ] .

# Het categorische gegevenstype is een verbijzondering, en een lezer kiest de
# meest specifieke doelklasse: deze shape wint zodra de knoop
# gd:GegevenstypeCategorisch draagt, en herhaalt daarom de rijen van de vorige.
# Het verschil zit in de naam van de waardedomeinrij — bij een categorisch type
# is dat het waardebereik.
gd:GegevenstypeCategorischFormShape a sh:NodeShape ;
    sh:targetClass gd:GegevenstypeCategorisch ;
    rdfs:label "Formulier categorisch gegevenstype"@nl , "Categorical data type form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Soort"@nl , "Kind"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path gd:classificatie ;
        sh:name "Classificaties"@nl , "Classifications"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:Concept-externalDefinition ;
        sh:name "Term uit het begrippenkader"@nl , "Term from the terminology"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain ;
        sh:name "Waardebereik"@nl , "Value range"@en ;
        sh:description """Het substantieve waardedomein; bij een categorisch
gegevenstype leidt het naar de opsomming van toegestane waarden."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain ;
        sh:name "Ontbrekendwaarden"@nl , "Sentinel values"@en ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:VariableCollection_has_ConceptualVariable ] ;
        sh:name "In gegevensset"@nl , "In data set"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:DataStructureComponent_isDefinedBy_RepresentedVariable ] ;
        sh:name "Component in het logisch gegevensmodel"@nl , "Component in the logical data model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:VariableRelationship_hasSource_ConceptualVariable ] ;
        sh:name "Gegevenstypemappings"@nl , "Data type mappings"@en ;
        sh:group gd:GroepSamenhang ; sh:order 62 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath gd:filtertOpGegevenstype ] ;
        sh:name "Filtert de gegevensleverset"@nl , "Filters the delivery set"@en ;
        sh:group gd:GroepSamenhang ; sh:order 63 ;
        dash:viewer dash:LabelViewer ;
    ] .

# De waardedomeinen, zodat de stap van gegevenstype naar opsomming niet
# doodloopt. Doelklasse is de DDI-CDI-klasse: het vocabulaire munt hier geen
# eigen term, en het formulier hoeft er ook geen.
gd:WaardedomeinFormShape a sh:NodeShape ;
    sh:targetClass cdi:SubstantiveValueDomain ;
    rdfs:label "Waardedomeinformulier"@nl , "Value domain form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path cdi:SubstantiveValueDomain_takesValuesFrom_EnumerationDomain ;
        sh:name "Opgesomd waardedomein"@nl , "Enumeration domain"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain ] ;
        sh:name "Waardedomein van"@nl , "Value domain of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:OntbrekendwaardedomeinFormShape a sh:NodeShape ;
    sh:targetClass cdi:SentinelValueDomain ;
    rdfs:label "Formulier ontbrekendwaardedomein"@nl , "Sentinel value domain form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path cdi:SentinelValueDomain_takesValuesFrom_EnumerationDomain ;
        sh:name "Opgesomd waardedomein"@nl , "Enumeration domain"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain ] ;
        sh:name "Ontbrekendwaarden van"@nl , "Sentinel values of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

# De codelijst is de laatste stap: zonder haar formulier houdt het doorklikken
# op bij het waardedomein en blijven de toegestane waarden onzichtbaar.
gd:CodelijstFormShape a sh:NodeShape ;
    sh:targetClass cdi:CodeList ;
    rdfs:label "Codelijstformulier"@nl , "Code list form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path cdi:CodeList_has_Code ;
        sh:name "Codes"@nl , "Codes"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:EnumerationDomain_references_CategorySet ;
        sh:name "Categorieverzameling"@nl , "Category set"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:GegevensveldFormShape a sh:NodeShape ;
    sh:targetClass gd:Gegevensveld ;
    rdfs:label "Gegevensveldformulier"@nl , "Data field form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path cdi:InstanceVariable_has_PhysicalSegmentLayout ;
        sh:name "Technisch gegevensmodel"@nl , "Technical data model"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:PhysicalDataSet_has_InstanceVariable ] ;
        sh:name "In gegevensmiddel"@nl , "In delivery medium"@en ;
        sh:group gd:GroepLevering ; sh:order 40 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:VariableRelationship_hasTarget_ConceptualVariable ] ;
        sh:name "Gegevenstypemapping"@nl , "Data type mapping"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

# De gegevenstypemapping is het scharnier tussen gegevenstype en gegevensveld;
# zonder formulier is zij in een weergave een knoop zonder inhoud.
gd:GegevenstypemappingFormShape a sh:NodeShape ;
    sh:targetClass cdi:VariableRelationship ;
    rdfs:label "Gegevenstypemappingformulier"@nl , "Data type mapping form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path cdi:VariableRelationship_hasSource_ConceptualVariable ;
        sh:name "Gegevenstype"@nl , "Data type"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:VariableRelationship_hasTarget_ConceptualVariable ;
        sh:name "Gegevensveld"@nl , "Data field"@en ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:LogischGegevensmodelFormShape a sh:NodeShape ;
    sh:targetClass gd:LogischGegevensmodel ;
    rdfs:label "Formulier logisch gegevensmodel"@nl , "Logical data model form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "LGM-code"@nl , "Logical data model code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path cdi:DataStructure_has_DataStructureComponent ;
        sh:name "Componenten"@nl , "Components"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath dct:conformsTo ] ;
        sh:name "Gebruikt door"@nl , "Used by"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

# De component is de brug van het logisch gegevensmodel naar de veldlaag. Zonder
# haar formulier toont de Componenten-rij hierboven platte labels en houdt de
# documentweergave daar op: alles wat eronder hangt — gegevenstype,
# waardedomein, gegevensset, gegevenstypemapping, gegevensveld en het technisch
# gegevensmodel — is dan een onbereikbaar eiland.
#
# Doelklasse is de bovenklasse cdi:DataStructureComponent, zodat elke
# componentrol onder hetzelfde formulier valt. Een lezer sluit sh:targetClass af
# over rdfs:subClassOf in de GEGEVENSgraaf; de twee axioma's die die sluiting
# dragen staan in glo-vocabulaire.ttl.
gd:ComponentFormShape a sh:NodeShape ;
    sh:targetClass cdi:DataStructureComponent ;
    rdfs:label "Componentformulier"@nl , "Component form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Rol in de structuur"@nl , "Role in the structure"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path cdi:DataStructureComponent_isDefinedBy_RepresentedVariable ;
        sh:name "Gegevenstype"@nl , "Data type"@en ;
        sh:description """Het gegevenstype waarvan deze component de rol in het
logisch gegevensmodel vastlegt."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:DataStructure_has_DataStructureComponent ] ;
        sh:name "Component in"@nl , "Component of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

gd:TechnischGegevensmodelFormShape a sh:NodeShape ;
    sh:targetClass gd:TechnischGegevensmodel ;
    rdfs:label "Formulier technisch gegevensmodel"@nl , "Technical data model form"@en ;
    sh:property [
        sh:path rdfs:label ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:name "TGM-code"@nl , "Technical data model code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 1 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath cdi:InstanceVariable_has_PhysicalSegmentLayout ] ;
        sh:name "Gegevensvelden"@nl , "Data fields"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath dct:conformsTo ] ;
        sh:name "Gebruikt door"@nl , "Used by"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] .

## --- data/vlierdam/vlierdam-mim-bronmodel.ttl ---
@prefix mim:    <http://modellen.mim-standaard.nl/def/mim#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix vlmim:  <https://vlierdam.example/mim/> .
@prefix glo:    <https://vlierdam.example/glo/> .

# =============================================================================
# Gemeente Vlierdam (FICTIEF) — DE MIM-INSTANTIEGRAAF VAN DE BEVRAGINGSCASUS.
#
# WAT DIT BESTAND IS. De structuurlaag van de BRP-bevraging voor laadpalen,
# gemodelleerd in het Metamodel Informatie Modellering (MIM 1.2, Geonovum),
# uitgedrukt in de Linked-Data-taalbinding van hoofdstuk 4 van die standaard.
# Het is de demonstratie van de aanbevolen gedaante uit de synthese (§4c, MIM
# als BRONMODEL): de structuurlaag wordt in MIM gemodelleerd, de gepubliceerde
# gegevensleveringsovereenkomst blijft staan zoals zij is, en
# `vlierdam-mim-afleiding.ttl` legt de band tussen beide.
#
# HET NIVEAUVERSCHIL DAT ALLES KLEURT (synthese §1). Een MIM-model in RDF is
# een INSTANTIEGRAAF VAN DE MIM-ONTOLOGIE, geen ontologie waarmee data te
# typeren valt. `vlmim:objecttype-ingeschreven-persoon a mim:Objecttype` is een
# individu, geen klasse; om er gegevens mee te typeren is een afzonderlijke
# transformatie naar RDFS/OWL/SHACL nodig. De MIM 1.2-specificatie zegt het
# zelf: "het toepassen van het MIM in RDF [levert] geen ontologie of
# vocabulaire waarin RDF kan worden uitgedrukt: slechts het informatiemodel
# zelf is op deze manier in RDF uitgedrukt."
#
# Daarom staan hier twee blokken naast elkaar.
#   A. HET LEVERSETMODEL — het objecttype van de bevraagde persoon met zijn
#      zeven attribuutsoorten, waardedomeinen, de Keuze voor
#      datum-of-onbekend en de codelijst van gemeenten. Dit is de laag waar
#      MIM als gelijke concurreert met de huidige drager (DDI-CDI).
#   B. HET ADMINISTRATIEMODEL VAN DE OVEREENKOMST — objecttype
#      Gegevensleveringsovereenkomst, de statusenumeratie en twee
#      relatiesoorten naar partijen. Dit blok staat er om TASTBAAR TE MAKEN
#      WAT MIM VAN DE OVEREENKOMSTLAAG WEL EN NIET LEVERT: het formulier
#      waarop een overeenkomst kan worden vastgelegd, en niet de afspraak
#      zelf. `glo:glo-rvig-vlierdam-2026` — met haar eigen IRI, datums,
#      statuswaarde en handtekeningen — is in MIM-termen een OBJECT in het
#      beschouwde domein, en een object is per hoofdstuk 2 van de standaard
#      uitdrukkelijk "geen modelelement".
#
# NAMESPACE-WAARSCHUWING. De MIM-namespace dereferenceert per 14 september
# 2026 niet (HTTP 404, verlopen certificaat). De Nederlandse labels op de
# gebruikte mim-termen reizen daarom met de dataset mee; zij staan in
# `glo-mim-shapes.ttl` en niet hier, zodat dit bestand zuiver de
# instantiegraaf blijft.
#
# EXTENSIE. Noodzaak per veld en de classificaties staan NIET in dit bestand
# maar in `vlierdam-mim-extensie.ttl`. Dat is geen ordeningskwestie: MIM kent
# er geen metagegeven voor, dus zij horen per definitie buiten de
# MIM-instantiegraaf. Wat hier staat is dus zuiver MIM 1.2, en het valideert
# als zodanig tegen `mim.ttl` en `mim-shapes.ttl` uit de MIM-Werkomgeving.
#
# EEN VALIDATIE VAN DIT BESTAND HEEFT WEL HET CORPUS ERBIJ NODIG. `mim:begrip`
# eist `sh:class skos:Concept`, en de zeven termknopen waarnaar verwezen wordt
# staan in `vlierdam-glo.ttl` (getypeerd als `gd:Term`, dat in
# `glo-vocabulaire.ttl` een subklasse van `skos:Concept` is). De datagraaf van
# de validatie is daarom deze drie nieuwe bestanden plus de bestaande
# vlierdam-bestanden die zij aanhalen.
#
# TWEETALIGHEID. `rdfs:label` draagt nl en en, zoals het hele vlierdam-corpus.
# De MIM-metagegevens zelf (naam, definitie, populatie, toelichting) zijn
# Nederlandstalig, zoals MIM dat zelf is; `mim:populatie`, `mim:lengte`,
# `mim:patroon` en `mim:kardinaliteit` zijn per `mim-shapes.ttl` bovendien
# `xsd:string` en kunnen geen taalmarkering dragen.
#
# Alles is fictief; RvIG figureert in dit corpus als fictieve ketenpartner
# (zie README.md).
# =============================================================================

# =============================================================================
# 0. HET INFORMATIEMODEL (de package)
# =============================================================================

vlmim:im-brp-levering-laadpalen a mim:Informatiemodel ;
    rdfs:label "Informatiemodel BRP-bevraging laadpalen"@nl ,
               "Information model for charging-station population register queries"@en ;
    mim:basisUri "https://vlierdam.example/mim/"^^xsd:anyURI ;
    mim:identificatie "https://vlierdam.example/mim/im-brp-levering-laadpalen"^^xsd:anyURI ;
    mim:naam "Informatiemodel BRP-bevraging laadpalen"@nl ;
    mim:alias "IM-VLD-BRP-001"@nl ;
    # BESCHOUWINGSNIVEAU 3. De leverset beschrijft hoe de gegevens logisch zijn
    # geordend, niet hoe zij in het bericht staan; dat laatste is niveau 4 en
    # valt buiten de scope van MIM (§1.7). Het technisch gegevensmodel
    # TGM-VLD-BRP-001 heeft daarom geen MIM-tegenhanger.
    mim:informatiemodeltype mim:LogischInformatiemodel ;
    mim:informatiedomein "Identiteitsgegevens" ;
    # ALTERNATIEF 1 van de standaard: de relatiesoort is leidend, niet de
    # relatierol. Dit is het enige keuzepunt dat MIM 1.2 kent.
    mim:relatiemodelleringstype mim:RelatiesoortLeidend ;
    mim:mimversie "1.2" ;
    mim:mimextensie "https://gegevensdeling.example/def/mim-ext/" ;
    mim:mimtaal "Nederlands" ;
    mim:tekstopmaak "Geen" ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:bevatModelelement
        vlmim:objecttype-ingeschreven-persoon ,
        vlmim:attribuutsoort-burgerservicenummer ,
        vlmim:attribuutsoort-voornamen ,
        vlmim:attribuutsoort-geslachtsnaam ,
        vlmim:attribuutsoort-adresregel1 ,
        vlmim:attribuutsoort-adresregel2 ,
        vlmim:attribuutsoort-geboortedatum ,
        vlmim:attribuutsoort-gemeente-van-inschrijving ,
        vlmim:datatype-burgerservicenummer ,
        vlmim:datatype-naamtekst ,
        vlmim:datatype-adresregel ,
        vlmim:datatype-kalenderdatum ,
        vlmim:keuze-datum-of-onbekend ,
        vlmim:enumeratie-onvolledige-datum ,
        vlmim:enumeratiewaarde-datum-onbekend ,
        vlmim:enumeratiewaarde-dag-onbekend ,
        vlmim:codelijst-gemeenten ,
        vlmim:objecttype-gegevensleveringsovereenkomst ,
        vlmim:objecttype-partij ,
        vlmim:attribuutsoort-overeenkomstcode ,
        vlmim:attribuutsoort-overeenkomststatus ,
        vlmim:attribuutsoort-ingangsdatum ,
        vlmim:attribuutsoort-einddatum ,
        vlmim:attribuutsoort-partijnaam ,
        vlmim:datatype-code ,
        vlmim:datatype-organisatienaam ,
        vlmim:enumeratie-overeenkomststatus ,
        vlmim:enumeratiewaarde-status-concept ,
        vlmim:enumeratiewaarde-status-akkoord ,
        vlmim:enumeratiewaarde-status-opgeschort ,
        vlmim:enumeratiewaarde-status-opgezegd ,
        vlmim:enumeratiewaarde-status-verlopen ,
        vlmim:relatiesoort-verstrekker ,
        vlmim:relatiesoort-ontvanger ,
        vlmim:relatierol-verstrekker ,
        vlmim:relatierol-ontvanger .

# =============================================================================
# A. HET LEVERSETMODEL
# =============================================================================

# -----------------------------------------------------------------------------
# A1. Het objecttype
#
# `mim:populatie` draagt de populatiebeschrijving. Zij is in MIM een
# metagegeven van het MODELELEMENT, niet van een levering: twee leveringen met
# verschillende populaties op hetzelfde objecttype zijn er niet mee uit elkaar
# te houden. Dat is de kunstgreep die de synthese bij E58 noemt, en zij is hier
# zichtbaar doordat de tekst hieronder de filterregel van DEZE ene bevraging
# beschrijft terwijl zij aan het type hangt.
# -----------------------------------------------------------------------------

vlmim:objecttype-ingeschreven-persoon a mim:Objecttype ;
    rdfs:label "Ingeschreven persoon"@nl , "Registered person"@en ;
    mim:identificatie "https://vlierdam.example/mim/objecttype-ingeschreven-persoon"^^xsd:anyURI ;
    mim:naam "Ingeschreven persoon"@nl ;
    mim:definitie "De natuurlijke persoon die in de basisregistratie personen staat ingeschreven en over wie de bevraging gaat."@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:herkomstDefinitie "Begrippenkader BRP-bevraging laadpalen, BK-VLD-BRP-001"@nl ;
    mim:begripsterm "natuurlijk persoon"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:indicatieAbstractObject false ;
    mim:populatie "Natuurlijke personen die in de basisregistratie personen staan ingeschreven met gemeente Vlierdam als gemeente van inschrijving. De verstrekker beantwoordt een bevraging alleen voor die groep: een zoekvraag die een persoon buiten Vlierdam zou opleveren, levert geen antwoord op. Overleden personen en personen met een verstrekkingsbeperking blijven buiten het antwoord." ;
    mim:kwaliteit "De gegevens zijn de stand van de basisregistratie personen op het moment van bevraging; er wordt geen historie meegeleverd." ;
    mim:toelichting "Eén object per bevraagde persoon; een antwoord bevat nul of meer van deze objecten."@nl ;
    mim:attribuut
        vlmim:attribuutsoort-burgerservicenummer ,
        vlmim:attribuutsoort-voornamen ,
        vlmim:attribuutsoort-geslachtsnaam ,
        vlmim:attribuutsoort-adresregel1 ,
        vlmim:attribuutsoort-adresregel2 ,
        vlmim:attribuutsoort-geboortedatum ,
        vlmim:attribuutsoort-gemeente-van-inschrijving .

# -----------------------------------------------------------------------------
# A2. De zeven attribuutsoorten
#
# DIT IS DE WINST DIE DE SYNTHESE BIJ E83/E84/E86 BESCHRIJFT: naam, definitie,
# type, kardinaliteit, lengte en patroon zijn PLATTE, NEDERLANDSTALIGE
# PROPERTIES op de attribuutsoort. In de gepubliceerde veldlaag liggen dezelfde
# gegevens één hop dieper, achter gestructureerde DDI-CDI-knopen
# (`cdi:Concept-name` → `cdi:ObjectName-name`), zodat een generieke viewer daar
# relaties toont waar een lezer waarden verwacht.
#
# `mim:begrip` verwijst naar de bestaande termknopen van het begrippenkader in
# `vlierdam-glo.ttl`. Het begrippenkader ZELF blijft daar: beschouwingsniveau 1
# (model van begrippen) valt buiten de scope van MIM, en `mim:begrip` is
# precies de verwijzing die de standaard daarvoor biedt.
# -----------------------------------------------------------------------------

# 1 — burgerservicenummer. Identificerend, met formeel patroon.
#
# `mim:identificerend` zegt in één property wat DDI-CDI met een aparte
# `cdi:IdentifierComponent`-knoop in de datastructuur zegt (E96).
vlmim:attribuutsoort-burgerservicenummer a mim:Attribuutsoort ;
    rdfs:label "burgerservicenummer"@nl , "citizen service number"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-burgerservicenummer"^^xsd:anyURI ;
    mim:naam "burgerservicenummer"@nl ;
    mim:alias "BSN"@nl ;
    mim:definitie "Het burgerservicenummer van de bevraagde persoon."@nl ;
    mim:begrip glo:term-burgerservicenummer ;
    mim:begripsterm "burgerservicenummer"@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:herkomstDefinitie "Begrippenkader BRP-bevraging laadpalen, BK-VLD-BRP-001"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-burgerservicenummer ;
    mim:lengte "9" ;
    mim:patroon "Negen cijfers, elfproef-geldig." ;
    mim:formeelPatroon "[0-9]{9}" ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend true ;
    mim:authentiek mim:Authentiek ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

vlmim:datatype-burgerservicenummer a mim:PrimitiefDatatype ;
    rdfs:label "Burgerservicenummer"@nl , "Citizen service number"@en ;
    mim:identificatie "https://vlierdam.example/mim/datatype-burgerservicenummer"^^xsd:anyURI ;
    mim:naam "Burgerservicenummer"@nl ;
    mim:definitie "Een tekstwaarde van negen cijfers die de elfproef doorstaat."@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:lengte "9" ;
    mim:patroon "Negen cijfers, elfproef-geldig." ;
    mim:formeelPatroon "[0-9]{9}" .

# 2 — voornamen. Niet elke ingeschrevene heeft voornamen, vandaar 0..1.
vlmim:attribuutsoort-voornamen a mim:Attribuutsoort ;
    rdfs:label "voornamen"@nl , "given names"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-voornamen"^^xsd:anyURI ;
    mim:naam "voornamen"@nl ;
    mim:definitie "De voornamen van de bevraagde persoon, in de vastgelegde volgorde."@nl ;
    mim:begrip glo:term-voornamen ;
    mim:begripsterm "voornamen"@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:herkomstDefinitie "Begrippenkader BRP-bevraging laadpalen, BK-VLD-BRP-001"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-naamtekst ;
    mim:lengte "200" ;
    mim:patroon "Vrije tekst, ten hoogste 200 tekens; diakritische tekens blijven staan." ;
    mim:kardinaliteit "0..1" ;
    mim:identificerend false ;
    mim:authentiek mim:Authentiek ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

# 3 — geslachtsnaam.
vlmim:attribuutsoort-geslachtsnaam a mim:Attribuutsoort ;
    rdfs:label "geslachtsnaam"@nl , "surname"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-geslachtsnaam"^^xsd:anyURI ;
    mim:naam "geslachtsnaam"@nl ;
    mim:definitie "De geslachtsnaam van de bevraagde persoon, met voorvoegsel."@nl ;
    mim:begrip glo:term-geslachtsnaam ;
    mim:begripsterm "geslachtsnaam"@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:herkomstDefinitie "Begrippenkader BRP-bevraging laadpalen, BK-VLD-BRP-001"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-naamtekst ;
    mim:lengte "200" ;
    mim:patroon "Vrije tekst, ten hoogste 200 tekens; diakritische tekens blijven staan." ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend false ;
    mim:authentiek mim:Authentiek ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

vlmim:datatype-naamtekst a mim:PrimitiefDatatype ;
    rdfs:label "Naamtekst"@nl , "Name text"@en ;
    mim:identificatie "https://vlierdam.example/mim/datatype-naamtekst"^^xsd:anyURI ;
    mim:naam "Naamtekst"@nl ;
    mim:definitie "Vrije tekst zoals in de registratie vastgelegd, ten hoogste 200 tekens, met behoud van diakritische tekens."@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:lengte "200" .

# 4 en 5 — de twee adresregels. Zij delen hun begrip en hun datatype; wat ze
# onderscheidt is hun plaats in het bericht — en die plaats is nu juist wat MIM
# niet uitdrukt, want de volgorde in het antwoordbericht hoort bij
# beschouwingsniveau 4.
vlmim:attribuutsoort-adresregel1 a mim:Attribuutsoort ;
    rdfs:label "adresregel 1"@nl , "address line 1"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-adresregel1"^^xsd:anyURI ;
    mim:naam "adresregel 1"@nl ;
    mim:definitie "De eerste adresregel: straatnaam en huisnummer met toevoeging."@nl ;
    mim:begrip glo:term-adresregel ;
    mim:begripsterm "adresregel"@nl ;
    mim:herkomst "Basisregistratie personen"@nl ;
    mim:herkomstDefinitie "Begrippenkader BRP-bevraging laadpalen, BK-VLD-BRP-001"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-adresregel ;
    mim:lengte "80" ;
    mim:patroon "Vrije tekst, ten hoogste 80 tekens, opgemaakt volgens de postale schrijfwijze." ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend false ;
    mim:authentiek mim:Authentiek ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

vlmim:attribuutsoort-adresregel2 a mim:Attribuutsoort ;
    rdfs:label "adresregel 2"@nl , "address line 2"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-adresregel2"^^xsd:anyURI ;
    mim:naam "adresregel 2"@nl ;
