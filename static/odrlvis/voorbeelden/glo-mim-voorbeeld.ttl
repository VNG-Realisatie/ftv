            [ cdi:LanguageString-content "Vrije tekst, ten hoogste 80 tekens, opgemaakt volgens de postale schrijfwijze." ;
              cdi:LanguageString-language "nl" ] ] ] .

glo:gegevensveld-adresregel1 a gd:Gegevensveld ;
