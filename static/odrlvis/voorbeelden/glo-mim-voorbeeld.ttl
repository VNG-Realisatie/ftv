        cdi:ControlledVocabularyEntry-vocabulary [
            cdi:Reference-uri "https://gegevensdeling.example/def/waardetype"^^xsd:anyURI ] ] ;
    cdi:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain glo:waardedomein-adresregel ;
    gd:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

glo:waardedomein-adresregel a cdi:SubstantiveValueDomain ;
