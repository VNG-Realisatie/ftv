## --- data/vlierdam/vlierdam-mim-extensie.ttl ---
@prefix mim:    <http://modellen.mim-standaard.nl/def/mim#> .
@prefix mimx:   <https://gegevensdeling.example/def/mim-ext/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix vlmim:  <https://vlierdam.example/mim/> .
@prefix gdc:    <https://gegevensdeling.example/def/classificatie/> .

# =============================================================================
# DE MIM-EXTENSIE: TWEE METAGEGEVENS OP DE ATTRIBUUTSOORT.
#
# WAAROM DIT BESTAND BESTAAT. Twee eisen uit de eisenlijst hebben in MIM 1.2
# geen drager, en het zijn juist de twee die op MODELNIVEAU thuishoren:
#
#   E91 — de noodzaak per veld. Waarom is dít ene gegeven voor dít doel nodig?
#         De gepubliceerde stapel heeft er evenmin een term voor en behelpt
#         zich met `skos:scopeNote` met een "NOODZAAK — "-voorvoegsel (zie
#         vlierdam-glo-brv.ttl). Dit is het ene punt waar de MIM-route NETTER
#         kan worden dan de bestaande: een eigen metagegeven zegt wat het is,
#         in plaats van een SKOS-noot die toevallig zo begint.
#   E90 — de classificaties per gegevenstype (bevat persoonsgegevens ja/nee,
#         en van welke soort). MIM kent alleen `mim:authentiek`, en dat gaat
#         over de wettelijke status van het gegeven, niet over de
#         gevoeligheid ervan.
#
# WAAROM DIT MAG, EN WAAR DE GRENS LIGT. De inleiding van MIM 1.2 staat
# metamodelextensies toe: een domein mag eigen metamodelelementen of
# metagegevens toevoegen, mits de extensie NIETS VERVANGT wat al in MIM staat,
# en zij wordt buiten MIM beheerd. Deze extensie voegt twee metagegevens toe en
# raakt geen enkele bestaande MIM-term.
#
# De standaard grenst de route even uitdrukkelijk af: "Een metamodelextensie is
# expliciet niet bedoeld voor aanvullende constructies die alleen spelen op het
# niveau van implementatie, of op het niveau van afgeleide technische modellen
# t.b.v. specifieke interfaces." Daarom staan hier ALLEEN deze twee. De poort,
# het beslispunt, het uitvoerend artefact, het mediatype en het adres van de
# dienst — de hele ontsluitingslaag van de casus — mogen langs deze weg niet
# worden toegevoegd, ook al zou het technisch kunnen. Dat is geen weglating
# maar de regel van de standaard zelf.
#
# VORM. De extensie volgt de omzettingsregels van hoofdstuk 4 van MIM 1.2: een
# metagegeven met een literal-waarde wordt een `owl:DatatypeProperty`, een
# metagegeven dat naar een ander ding verwijst een `owl:ObjectProperty`, met
# `rdfs:label` als naam en `rdfs:comment` als definitie. Het informatiemodel in
# vlierdam-mim-bronmodel.ttl noemt deze namespace in zijn `mim:mimextensie`.
#
# DE INSTANTIETRIPELS STAAN HIER EN NIET IN HET BRONMODEL. Zo blijft de
# MIM-instantiegraaf zuiver en valideert zij op zichzelf tegen mim.ttl en
# mim-shapes.ttl; wat de extensie draagt is dan ook zichtbaar de extensie, en
# niet MIM.
#
# Alles is fictief; zie README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. De extensie als beheerd artefact
# -----------------------------------------------------------------------------

<https://gegevensdeling.example/def/mim-ext/> a owl:Ontology ;
    rdfs:label "MIM-extensie gegevensdeling"@nl ,
               "MIM extension for data sharing"@en ;
    rdfs:comment "Een metamodelextensie op MIM 1.2 met twee metagegevens op de attribuutsoort: de noodzaak van het gegeven voor het doel van de levering, en de classificatie van het gegeven naar gevoeligheid. De extensie vervangt geen enkel MIM-construct en wordt buiten MIM beheerd."@nl ;
    owl:versionInfo "1.0" ;
    dct:conformsTo <https://docs.geostandaarden.nl/mim/mim/> ;
    dct:source <https://docs.geostandaarden.nl/mim/mim/> .

# -----------------------------------------------------------------------------
# 2. De twee metagegevens
# -----------------------------------------------------------------------------

mimx:noodzaak a owl:DatatypeProperty ;
    rdfs:label "noodzaak"@nl , "necessity"@en ;
    rdfs:comment "De onderbouwing waarom dit gegeven voor het doel van de levering nodig is, en wat er zonder dit gegeven niet kan. Eén onderbouwing per attribuutsoort."@nl ;
    rdfs:isDefinedBy <https://gegevensdeling.example/def/mim-ext/> ;
    rdfs:domain mim:Attribuutsoort ;
    rdfs:range rdf:langString .

mimx:classificatie a owl:ObjectProperty ;
    rdfs:label "classificatie"@nl , "classification"@en ;
    rdfs:comment "Een indeling van het gegeven naar gevoeligheid, uit een buiten het model beheerde waardelijst. Een attribuutsoort kan meerdere classificaties dragen."@nl ;
    rdfs:isDefinedBy <https://gegevensdeling.example/def/mim-ext/> ;
    rdfs:domain mim:Attribuutsoort ;
    rdfs:range skos:Concept .

# -----------------------------------------------------------------------------
# 3. De twee metagegevens toegepast op de zeven attribuutsoorten
#
# DE NOODZAAKTEKSTEN ZIJN VOOR DEZE CASUS GESCHREVEN, naar het model van de
# `skos:scopeNote`-teksten in vlierdam-glo-brv.ttl: één alinea die zegt wat het
# gegeven bijdraagt aan het doel en wat er zonder dat gegeven niet lukt. De
# noodzaakbeoordeling van de OVEREENKOMST als geheel staat in vlierdam-glo.ttl
# op `gd:noodzaak`; deze zeven zijn de uitsplitsing daarvan naar veld. Het doel
# is de registratie van laadpalen bij woningen van inwoners met een elektrische
# auto.
# -----------------------------------------------------------------------------

vlmim:attribuutsoort-burgerservicenummer
    mimx:noodzaak "De aanvraag moet aan één rechthebbende worden gekoppeld en een laadpaal wordt aan één huishouden toegewezen; zonder een uniek nummer vallen naamgenoten op hetzelfde adres samen en is niet vast te stellen of de aanvrager en de ingeschrevene dezelfde persoon zijn. Het nummer wordt na de toewijzing niet in het laadpaaldossier bewaard."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-nationale-identificatienummers .

vlmim:attribuutsoort-voornamen
    mimx:noodzaak "De gemeente neemt over de plaatsing contact op met de aanvrager en moet die aanspreken zoals hij in de registratie bekend staat; zonder voornamen is een aanschrijving aan een adres met meerdere naamgenoten niet te richten. Voor de raming van het laadvermogen draagt dit gegeven niets bij."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

vlmim:attribuutsoort-geslachtsnaam
    mimx:noodzaak "De geslachtsnaam is het gegeven waarmee de aanvraag en de inschrijving op elkaar worden gelegd; het burgerservicenummer bevestigt die koppeling maar staat niet op het aanvraagformulier. Zonder geslachtsnaam kan de behandelaar een aanvraag niet aan een ingeschrevene toewijzen zonder eerst het nummer op te vragen, wat een ruimere bevraging zou vergen."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

vlmim:attribuutsoort-adresregel1
    mimx:noodzaak "Een laadpaal wordt in een straat geplaatst en op een adreseenheid aangesloten; straatnaam en huisnummer bepalen bij welk parkeervak de paal komt en op welke netaansluiting hij hoort. Zonder dit gegeven is de aanvraag wel te herleiden tot een persoon maar niet tot een plaats."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

vlmim:attribuutsoort-adresregel2
    mimx:noodzaak "Straatnamen komen binnen een gemeente meermaals voor; postcode en woonplaats maken het adres eenduidig en zijn bovendien de sleutel waarmee de aanvraag op het straatsegment van de netbeheerder valt. Zonder deze regel kan een aanvraag aan de verkeerde straat worden toegewezen."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

vlmim:attribuutsoort-geboortedatum
    mimx:noodzaak "De regeling stelt de aanvraag open voor meerderjarigen, omdat de plaatsing een gebruiksovereenkomst met de gemeente meebrengt; de geboortedatum is het gegeven waarmee dat wordt vastgesteld. Zij dient ook om naamgenoten op hetzelfde adres te onderscheiden wanneer het burgerservicenummer op het formulier ontbreekt. Voor de raming van het laadvermogen doet zij niet mee, en een onvolledige datum is voldoende zolang het jaar bekend is."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

vlmim:attribuutsoort-gemeente-van-inschrijving
    mimx:noodzaak "De gemeente mag alleen laadpalen toewijzen aan haar eigen ingezetenen en moet dat per aanvraag kunnen vaststellen; dit gegeven is de toets. Het is bovendien de grootheid waarop de populatie van de levering is afgebakend: een bevraging die een persoon buiten Vlierdam zou opleveren, levert geen antwoord op. Zonder dit gegeven zou de toets op de bevoegdheid buiten de levering moeten plaatsvinden, op gegevens die de gemeente dan alsnog zou moeten opvragen."@nl ;
    mimx:classificatie
        gdc:persoonsgegevens-aanwezig\/bevat-persoonsgegevens ,
        gdc:type-persoonsgegevens\/bevat-gewone-persoonsgegevens .

# -----------------------------------------------------------------------------
# 4. Wat deze extensie NIET doet
#
# Zij draagt de noodzaakbeoordeling van de OVEREENKOMST niet. Die is vrije
# tekst over één concrete deling tussen twee genoemde partijen; het
# dichtstbijzijnde MIM-metagegeven (`mim:toelichting`) hoort bij een
# modelelement en niet bij een geval, en een extensie die dat zou rechttrekken
# zou het niveauverschil van hoofdstuk 2 doorbreken in plaats van het metamodel
# uitbreiden.
#
# Zij draagt evenmin de doelbinding, de grondslag, de bewaartermijn of de
# verstrekkingsbeperking. Dat zijn geen eigenschappen van een gegeven maar van
# een deling, en zij staan in de gepubliceerde overeenkomst.
# -----------------------------------------------------------------------------

## --- data/vlierdam/vlierdam-mim-afleiding.ttl ---
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix vlmim:  <https://vlierdam.example/mim/> .
@prefix glo:    <https://vlierdam.example/glo/> .
@prefix vlierdam: <https://vlierdam.example/odrl/> .

# =============================================================================
# DE AFLEIDING: WAT VAN DE GEPUBLICEERDE OVEREENKOMST EEN MIM-BRON HEEFT,
# EN — VEEL BELANGRIJKER — WAT NIET.
#
# HOE DIT BESTAND TE LEZEN. Elke tripel hieronder zegt: deze knoop uit de
# gepubliceerde gegevensleveringsovereenkomst is AFGELEID van die knoop uit de
# MIM-instantiegraaf. De richting volgt de aanbevolen gedaante uit de synthese
# (§4c): het MIM-model is de BRON, de gepubliceerde stapel is het afgeleide
# artefact. Dat is dezelfde lijn die alle vier de onderzochte
# MIM-praktijkmodellen volgen — IMEV, IMGeluid, IMKL en IMKAD leveren elk hun
# XSD, JSON-schema of GML uit een MIM-bronmodel, en geen van vieren publiceert
# het model zelf als mim-graaf.
#
# HET LEGE DEEL IS DE DEMONSTRATIE. Sectie 3 hieronder somt op wat géén
# afleidingsrelatie heeft. Dat is geen onaf werk en geen tijdgebrek: het is de
# uitkomst van paragraaf 3 van de synthese, gemeten in knopen. Van de vijf
# lagen van een gegevensleveringsovereenkomst heeft er precies één een
# MIM-bron. De andere vier worden hieronder bij naam genoemd, met de grond uit
# de standaard zelf erbij, zodat een lezer het verschil kan zien in plaats van
# moeten geloven.
#
# `prov:wasDerivedFrom` is in dit corpus de bestaande relatie voor "hier komt
# dit vandaan" (vlierdam-glo.ttl gebruikt hem al tussen aanbod en
# overeenkomst); er komt voor deze demonstratie geen nieuwe term bij.
#
# Alles is fictief; zie README.md.
# =============================================================================

# =============================================================================
# 1. DE STRUCTUURLAAG — HIER IS DE AFLEIDING COMPLEET
# =============================================================================

# -----------------------------------------------------------------------------
# 1a. De zeven gegevenstypen ← de zeven attribuutsoorten.
#
# Dit is de kern van de winst. Wat in de gepubliceerde veldlaag een
# `gd:Gegevenstype` is met zijn naam, code en definitie achter geneste
# DDI-CDI-knopen, is in de bron een `mim:Attribuutsoort` met platte,
# Nederlandstalige properties. De IRI's blijven die van `velden.ttl`: het zijn
# dezelfde velden, niet nieuwe.
# -----------------------------------------------------------------------------

vlierdam:veld-brp-burgerservicenummer
    prov:wasDerivedFrom vlmim:attribuutsoort-burgerservicenummer .
vlierdam:veld-brp-naam-voornamen
    prov:wasDerivedFrom vlmim:attribuutsoort-voornamen .
vlierdam:veld-brp-naam-geslachtsnaam
    prov:wasDerivedFrom vlmim:attribuutsoort-geslachtsnaam .
vlierdam:veld-brp-adressering-adresregel1
    prov:wasDerivedFrom vlmim:attribuutsoort-adresregel1 .
vlierdam:veld-brp-adressering-adresregel2
    prov:wasDerivedFrom vlmim:attribuutsoort-adresregel2 .
vlierdam:veld-brp-geboorte-datum
    prov:wasDerivedFrom vlmim:attribuutsoort-geboortedatum .
vlierdam:veld-brp-gemeenteVanInschrijving
    prov:wasDerivedFrom vlmim:attribuutsoort-gemeente-van-inschrijving .

# -----------------------------------------------------------------------------
# 1b. Het logisch gegevensmodel ← het objecttype.
#
# De `cdi:WideDataStructure` van de gepubliceerde veldlaag beschrijft één brede
# rij per persoon; het MIM-objecttype beschrijft diezelfde persoon als
# getypeerde groep objecten. De COMPONENTROLLEN van de structuur
# (`cdi:IdentifierComponent` naast zes `cdi:MeasureComponent`) hebben geen
# eigen tegenhanger: MIM zegt hetzelfde met één metagegeven,
# `mim:identificerend` op de attribuutsoort. Dat is winst en verlies tegelijk —
# korter, maar de rol is geen ding meer waar iets anders naar kan wijzen.
# -----------------------------------------------------------------------------

glo:lgm-brp-laadpalen
    prov:wasDerivedFrom vlmim:objecttype-ingeschreven-persoon .

# De eenheid waarover gemeten wordt is in MIM hetzelfde ding als het
# objecttype; DDI-CDI splitst die twee, MIM niet.
glo:unittype-natuurlijk-persoon
    prov:wasDerivedFrom vlmim:objecttype-ingeschreven-persoon .

# -----------------------------------------------------------------------------
# 1c. De gegevensset ← het informatiemodel.
#
# De `gd:Gegevensset` groepeert de zeven gegevenstypen met een eigen naam en
# code (E82). In MIM is die groepering de package: hier het informatiemodel
# zelf, omdat de leverset in deze casus precies één objecttype telt.
# -----------------------------------------------------------------------------

glo:gegevensset-brp-laadpalen
    prov:wasDerivedFrom vlmim:im-brp-levering-laadpalen .

# -----------------------------------------------------------------------------
# 1d. De waardedomeinen ← de datatypen.
#
# `cdi:SubstantiveValueDomain` met zijn `ValueAndConceptDescription` wordt een
# `mim:PrimitiefDatatype` met `mim:lengte`, `mim:patroon` en
# `mim:formeelPatroon` (E87).
# -----------------------------------------------------------------------------

glo:waardedomein-bsn
    prov:wasDerivedFrom vlmim:datatype-burgerservicenummer .
glo:waardedomein-naamtekst
    prov:wasDerivedFrom vlmim:datatype-naamtekst .
glo:waardedomein-adresregel
    prov:wasDerivedFrom vlmim:datatype-adresregel .
glo:waardedomein-geboortedatum
    prov:wasDerivedFrom vlmim:datatype-kalenderdatum .

# -----------------------------------------------------------------------------
# 1e. De opgesomde bereiken ← de enumeratie en de codelijst.
#
# LET OP DE ASYMMETRIE, want zij is de kunstgreep van E88 in één regel. Het
# SENTINEL-waardedomein van de geboortedatum heeft géén eigen tegenhanger: in
# MIM is de ontbrekendwaarde geen apart domein maar een tak van de
# `mim:Keuze`, plus het metagegeven `mim:mogelijkGeenWaarde`. De codelijst
# eronder wordt wel netjes een enumeratie.
# -----------------------------------------------------------------------------

glo:codelijst-onvolledige-datum
    prov:wasDerivedFrom vlmim:enumeratie-onvolledige-datum .
glo:code-datum-onbekend
    prov:wasDerivedFrom vlmim:enumeratiewaarde-datum-onbekend .
glo:code-dag-onbekend
    prov:wasDerivedFrom vlmim:enumeratiewaarde-dag-onbekend .

# De gemeentelijst is in MIM een CODELIJST en geen enumeratie: zij wordt buiten
# het model beheerd en het model beschrijft haar structuur niet. Daardoor
# hebben `glo:code-gemeente-vlierdam` en `glo:code-gemeente-elders` geen
# tegenhanger — zij staan in het bronmodel alleen in de toelichting van de
# codelijst. Dat is het verlies dat tegenover de winst van 1e staat.
glo:codelijst-gemeenten
    prov:wasDerivedFrom vlmim:codelijst-gemeenten .

# -----------------------------------------------------------------------------
# 1f. Het begrippenkader is GEEN afleiding maar een VERWIJZING.
#
# Beschouwingsniveau 1 (model van begrippen) valt buiten de scope van MIM. Het
# kader blijft dus staan waar het staat, in SKOS, en het bronmodel wijst er met
# `mim:begrip` naar. Daarom staat `glo:begrippenkader-brp-laadpalen` hieronder
# niet met een `prov:wasDerivedFrom`: er is niets om het van af te leiden, en
# dat is hier geen gat maar de afgesproken werkverdeling. Het MIM
# 2.0-visiedocument wil die aansluiting (op NL-SBB) juist verstevigen.
# -----------------------------------------------------------------------------

# =============================================================================
# 2. DE TELLING
# =============================================================================

vlmim:im-brp-levering-laadpalen
    rdfs:comment "Achttien knopen van de gepubliceerde gegevensleveringsovereenkomst hebben een MIM-bron: zeven gegevenstypen, het logisch gegevensmodel, de eenheid, de gegevensset, vier waardedomeinen, twee opgesomde bereiken en twee codes. Alle achttien liggen in de structuur- en veldlaag boven de berichtgrens. Sectie 3 van dit bestand somt op wat er niet bij staat."@nl .

# =============================================================================
# 3. WAT GEEN AFLEIDINGSRELATIE HEEFT — EN WAAROM NIET
#
# Dit is de kern van de demonstratie. Hieronder staat geen enkele tripel, en
# dat is de bedoeling: elke regel noemt een knoop die in de gepubliceerde
# overeenkomst bestaat en in de MIM-instantiegraaf geen tegenhanger heeft.
# De gronden zijn die van paragraaf 3 van `mim-synthese.md`; de termtellingen
# komen uit `mim-materiaal.md` §4.2 en zijn gedaan op de volledige tekst van
# MIM 1.2.
#
# -----------------------------------------------------------------------------
# 3a. DE OVEREENKOMST ZELF (synthese §2a, E1–E7, E9, E10, E23–E26)
#
#   glo:glo-rvig-vlierdam-2026        de overeenkomst
#   glo:aanbod-brp-gemeenten          het aanbod waaruit zij voortkomt
#   glo:rol-verstrekker               de rol van RvIG in de afspraak
#   glo:rol-ontvanger                 de rol van de gemeente in de afspraak
#   glo:akkoord-rvig, glo:akkoord-vlierdam    de twee akkoordverklaringen
#   glo:pif-veenstra, glo:pif-brouwer, glo:pif-said   de personen in functie
#
# GROND. Dit zijn INSTANTIES. MIM typeert per eigen normatieve keuze alleen
# modellen; een object is volgens hoofdstuk 2 "geen modelelement". Het FORMULIER
# van deze laag heeft wél een MIM-bron — zie blok B van
# vlierdam-mim-bronmodel.ttl, met het objecttype
# Gegevensleveringsovereenkomst, de statusenumeratie en twee relatiesoorten
# naar partijen — maar dat formulier is niet de afspraak. Een akkoordverklaring
# is bovendien een gebeurtenis, en paragraaf 1.5.2 sluit dat uit: "scheiding
# proces en informatie, het proces is niet in scope van deze standaard".
#
# -----------------------------------------------------------------------------
# 3b. DE NORMATIEVE LAAG (synthese §2b, E34–E42, E48–E50)
#
#   glo:toestemming-gebruik           de toestemming
#   glo:verbod-doorlevering           het verbod
#   glo:plicht-beschikbaarstelling    de plicht
#   vlierdam:plicht-vernietiging      de vernietigingsplicht uit het beleid
#   glo:afspraak-*                    de acht afspraken van de overeenkomst
#   glo:doel-verstrekking-brp         het doel van de verstrekker
#   vlierdam:doelbinding-registratie-laadpalen   de doelbinding
#   glo:belang-verantwoording         het verwerkingsbelang
#
# GROND. De deontische termtelling in MIM 1.2 is nul over de hele linie:
# verplichting nul, verbod nul, toestemming nul, doelbinding nul. Het
# dichtstbijzijnde construct, `mim:Constraint`, is "een conditie of een
# beperking, die voor één of meerdere modelelementen uit het informatiemodel
# geldt" — een uitspraak over het MODEL, niet een norm die een partij bindt.
# `mim:Keuze`, dat in dit bronmodel de datum-of-onbekend draagt, is een XOR
# tussen modelelementen en geen keuze die iemand mag maken.
#
# -----------------------------------------------------------------------------
# 3c. DE LEVERINGSLAAG (synthese §2c, E56–E71)
#
#   glo:gls-brp-laadpalen             de gegevensleveringsspecificatie
#   vlierdam:brp-velden-laadpalen     de leverset als dataset-met-afspraken
#   glo:middel-brp-antwoord           het gegevensmiddel / de distributie
#   glo:leversetafspraak-*            bewaartermijn, toegang, beveiliging
#   glo:middelafspraak-*              initiatie, frequentie, actualiteit, …
#   glo:glsafspraak-*                 de zeven specificatie-afspraken
#
# GROND. "Dataset" komt viermaal voor in MIM 1.2 en elke keer om te zeggen dat
# MIM daar niet voor is; "distributie" nul, "levering" nul, "frequentie" nul.
# De spec: "Het MIM is niet bedoeld om vervolgens in termen van dit
# informatiemodel een concrete dataset te vormen." De POPULATIEBESCHRIJVING is
# de enige uitzondering en zij staat in het bronmodel, op `mim:populatie` van
# het objecttype — met de kanttekening dat zij daar aan het TYPE hangt en niet
# aan deze levering.
#
# -----------------------------------------------------------------------------
# 3d. DE TECHNISCHE ONTSLUITING (synthese §2e en §3, E103–E117)
#
#   glo:poort-rvig-inway              de dienst / het koppelvlak
#   vlierdam:set-rvig-inway           het beslispunt dat de levering bewaakt
#   vlierdam:bundle-rvig-pdp1         het uitvoerend artefact
#   vlierdam:anker-*                  de borgingsankers
#
# GROND. Hier is de grond het scherpst, want de extensieroute is hier
# uitdrukkelijk DICHT: "Een metamodelextensie is expliciet niet bedoeld voor
# aanvullende constructies die alleen spelen op het niveau van implementatie,
# of op het niveau van afgeleide technische modellen t.b.v. specifieke
# interfaces." Wie dit in MIM zou bouwen, bouwt het per definitie buiten MIM.
# Termtellingen: endpoint nul, API eenmaal (in een opsomming van formaten),
# "service" viermaal en steeds als afgeleid product.
#
# -----------------------------------------------------------------------------
# 3e. HET BERICHT — DE ONDERKANT VAN DEZELFDE VELDLAAG (E92–E98)
#
#   glo:record-persoon                het logisch record in het antwoord
#   glo:tgm-brp-antwoord              het technisch gegevensmodel (JSON-schema)
#   glo:gegevensveld-*                de zeven gegevensvelden in het bericht
#   glo:mapping-*                     de zeven mappings logisch ↔ technisch
#   glo:variabelestructuur-brp-laadpalen   de structuur van die mappings
#   glo:component-*                   de zeven componentrollen
#
# GROND. Dit is de zichtbaarste knip van de hele demonstratie, want hij loopt
# MIDDEN DOOR ÉÉN LAAG. Beschouwingsniveau 4 valt buiten de scope van MIM:
# "wel staat MIM een model-gedreven werkwijze voor waarbij de modellen van
# niveau 4 gegenereerd kunnen worden vanuit niveau 2 of 3" (paragraaf 1.7). Er
# is geen construct voor de veldlengte in een bericht, voor de encoding of voor
# de mapping tussen logisch en fysiek; die mapping bestaat in de MIM-wereld
# alleen impliciet, in de generator. De gepubliceerde stapel heeft hier één
# doorlopende beschrijving en de MIM-bron houdt halverwege op.
#
# De componentrollen zijn een randgeval: zij verdwijnen niet omdat MIM ze niet
# kan, maar omdat MIM ze ANDERS zegt — als `mim:identificerend` op de
# attribuutsoort (zie 1b).
# =============================================================================

<https://vlierdam.example/mim/afleiding>
    dct:title "Afleidingsrelaties tussen de MIM-bron en de gepubliceerde gegevensleveringsovereenkomst"@nl ,
              "Derivation relations between the MIM source model and the published data delivery agreement"@en ;
    dct:description "Per element van de structuurlaag een prov:wasDerivedFrom naar zijn MIM-tegenhanger; voor de overeenkomstlaag, de normatieve laag, de leveringslaag, de technische ontsluiting en het bericht staat er niets, en dat ontbreken is de demonstratie. Sectie 3 van dit bestand noemt elke ontbrekende knoop bij naam, met de grond uit MIM 1.2 erbij."@nl ,
                    "For each element of the structural layer a prov:wasDerivedFrom to its MIM counterpart; for the agreement layer, the normative layer, the delivery layer, the technical access layer and the message there is nothing, and that absence is the demonstration. Section 3 of this file names every missing node, with the grounds from MIM 1.2."@en ;
    dct:source <https://docs.geostandaarden.nl/mim/mim/> .

# =============================================================================
# 4. DE AANHECHTING — de GLS voldoet aan het MIM-informatiemodel
#
# Eén tripel, en hij doet twee dingen tegelijk.
#
# INHOUDELIJK: de gegevensleveringsspecificatie voldoet aan het
# MIM-informatiemodel waaruit haar veldlaag is afgeleid — conformiteitsgrond 2
# van MIM 1.2 §1.9 (transformeerbaarheid). Dat is een uitspraak over deze
# casus, en daarom staat hij in dit bestand en niet in glo-mim-shapes.ttl; dat
# is een weergavebestand.
#
# PRAKTISCH: hij is ook de INGANG. De documentweergave daalt af langs de rijen
# van de formulieren, en `dct:conformsTo` is de rij "Voldoet aan" die het
# formulier van glo-shapes.ttl al toont. Zonder deze tripel is de hele
# MIM-graaf in de viewer onbereikbaar — nul vouwen, nul formulieren — want geen
# van die formulieren toont `prov:wasDerivedFrom`, de relatie die sectie 2
# hierboven legt. Eén tripel op een BESTAAND pad voegt alleen een waarde toe en
# neemt niets weg; een tweede formulier-shape op
# gd:Gegevensleveringsspecificatie zou het rijke formulier kunnen verdringen.
#
# IDEMPOTENT: staat dezelfde uitspraak ook in het bronmodel, dan is het één
# tripel in de samengevoegde graaf en verandert er niets.
# =============================================================================

glo:gls-brp-laadpalen dct:conformsTo vlmim:im-brp-levering-laadpalen .

## --- data/vlierdam/glo-mim-shapes.ttl ---
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix gd:     <https://gegevensdeling.example/def/> .
@prefix mim:    <http://modellen.mim-standaard.nl/def/mim#> .
@prefix mimx:   <https://gegevensdeling.example/def/mim-ext/> .
@prefix vlmim:  <https://vlierdam.example/mim/> .

# =============================================================================
# Formulier-shapes en weergavelabels voor de MIM-laag van de Vlierdam-casus.
#
# WAT DIT BESTAND DOET. Het beschrijft WEERGAVE en toetst niets: welke
# metagegevens van een MIM-knoop een generieke viewer toont, in welke volgorde,
# onder welke kop en met welke widget — plus de Nederlandse en Engelse labels
# van de gebruikte mim:-termen zelf. Zonder dit bestand staan de knopen van
# vlierdam-mim-bronmodel.ttl er wel, maar zonder veldkoppen en zonder vouwen:
# het informatiemodel klapt dan niet open naar zijn objecttype, zijn
# attribuutsoorten, zijn enumeratie en zijn codelijst.
#
# WAAROM HET MOET. MIM 1.2 kent zelf een SHACL-shapegraph (mim-shapes.ttl uit de
# MIM-Werkomgeving), maar die VALIDEERT: zij zegt welke metagegevens een
# attribuutsoort mag en moet dragen, niet in welke volgorde, onder welke kop of
# met welke widget zij getoond horen te worden. Dat is precies de bevinding van
# de synthese (§2e, E117, "dekt niet"): weergave-shapes zijn met de hand
# geschreven, aan beide zijden van de vergelijking. Dit bestand is die hand.
#
# DEZELFDE SUBSET EN DEZELFDE GROEPEN als glo-shapes.ttl (Visualisatie-note §8):
# sh:NodeShape + sh:targetClass, sh:property met sh:path (ook sh:inversePath),
# sh:name, sh:description, sh:order, sh:group, dash:viewer en dash:propertyRole.
# De acht kopgroepen zelf worden hier NIET opnieuw gedefinieerd; zij komen uit
# glo-shapes.ttl, dat met dit bestand samen wordt geladen. Zelfde afspraak als
# glo-brv-shapes.ttl.
#
# ÉÉN sh:targetClass PER SHAPE, en geen enkele shape leunt op een
# rdfs:subClassOf-sluiting: de MIM-ontologie (mim.ttl) reist niet met de data
# mee, dus de subklasse-axioma's die mim:Enumeratie onder mim:Datatype hangen
# staan niet in de graaf. Elke gebruikte MIM-klasse krijgt daarom haar eigen,
# volledige formulier.
#
# DE KOP VAN EEN MIM-KNOOP. Binnen het formulier komt zij van
# dash:LabelRole op mim:naam. Daarbuiten — in de rij van een ándere knoop, en
# op de dichte vouw — leest een viewer de eigen naam-literal van de knoop
# (rdfs:label, skos:prefLabel, dct:title); mim:naam is geen van drieën. De
# knopen van het bronmodel dragen daarom naast mim:naam ook een rdfs:label,
# net als de veldlaagknopen van glo-shapes.ttl dat doen.
#
# DE LABELS REIZEN MEE (§2 van dit bestand). De MIM-namespace dereferenceert
# per 14 september 2026 niet: https://modellen.mim-standaard.nl/def/mim geeft
# HTTP 404 en het certificaat van het domein is verlopen. Een viewer die
# mim:kardinaliteit tegenkomt kan het label dus nergens ophalen en zou
# "kardinaliteit" uit de IRI-staart moeten raden — en bij mim:Objecttype of
# mim:CharacterString zou hij de Nederlandse term helemaal missen. Daarom staan
# de labels en definities van de gebruikte mim:-termen hier in de dataset zelf,
# letterlijk overgenomen uit de werkomgeving.
#
# BRON EN VERSIE VAN DE MIM-TERMEN: media/mim.ttl uit
# github.com/Geonovum/MIM-Werkomgeving, commit
# 4f3fc35e538c0a000580b8449993a6a6bea53740 (owl:versionInfo "1.2",
# owl:versionIRI http://modellen.mim-standaard.nl/def/mim/1.2), opgehaald
# 14 september 2026. De @nl-labels en de definities zijn LETTERLIJK die van
# mim.ttl; de @en-labels zijn vertalingen in dit bestand, want MIM levert er
# zelf geen (het metamodel is Nederlandstalig van zichzelf — synthese §2e,
# E116). Wie de MIM-versie wisselt, ververst dit blok.
# =============================================================================

# =============================================================================
# 1. DE FORMULIEREN
# =============================================================================

# --- Het informatiemodel -----------------------------------------------------
#
# Het instappunt van de MIM-kant: één package dat alle modelelementen bevat.
# Het kerngegeven is de MIM-versie — bij een metamodel-instantiegraaf is de
# eerste vraag van een lezer tegen wélk metamodel hij aankijkt, en het antwoord
# past op een chip.
vlmim:InformatiemodelFormShape a sh:NodeShape ;
    sh:targetClass mim:Informatiemodel ;
    rdfs:label "Formulier informatiemodel"@nl , "Information model form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:mimversie ;
        sh:name "MIM-versie"@nl , "MIM version"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:informatiemodeltype ;
        sh:name "Informatiemodeltype"@nl , "Information model type"@en ;
        sh:description """Het beschouwingsniveau waarop dit model staat.
MIM 1.2 kent er vier; alleen niveau 2 (conceptueel) en 3 (logisch) vallen
binnen de scope van de standaard."""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:informatiedomein ;
        sh:name "Informatiedomein"@nl , "Information domain"@en ;
        sh:group gd:GroepKenmerken ; sh:order 11 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:mimtaal ;
        sh:name "MIM-taal"@nl , "MIM language"@en ;
        sh:group gd:GroepKenmerken ; sh:order 12 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:mimextensie ;
        sh:name "MIM-extensie"@nl , "MIM extension"@en ;
        sh:description """De extensie waarmee dit model het metamodel uitbreidt.
Een extensie wordt buiten MIM beheerd en mag niets vervangen wat al in MIM
staat."""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 13 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:relatiemodelleringstype ;
        sh:name "Relatiemodelleringstype"@nl , "Relationship modelling type"@en ;
        sh:description """Het enige keuzepunt dat MIM zelf openlaat: is de
relatiesoort leidend of de relatierol?"""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 14 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:bevatModelelement ;
        sh:name "Modelelementen"@nl , "Model elements"@en ;
        sh:description """Alles wat dit informatiemodel bevat: objecttypen,
attribuutsoorten, datatypen, waardelijsten en relatiesoorten."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:basisUri ;
        sh:name "Basis-URI"@nl , "Base URI"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomst ;
        sh:name "Herkomst"@nl , "Origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:datumOpname ;
        sh:name "Datum opname"@nl , "Date added"@en ;
        sh:group gd:GroepHerkomst ; sh:order 73 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- Het objecttype ----------------------------------------------------------
#
# De knoop waar de structuurlaag begint. Drie omgekeerde paden maken hem tot
# een kruispunt in plaats van een eindpunt: het informatiemodel waarin hij
# staat, en de relatiesoorten die hem als bron dan wel als doel hebben — die
# wijzen in de data van de relatiesoort naar het objecttype, dus zonder
# omkering blijft het objecttype er onwetend van.
#
# GEEN KERNGEGEVEN. Een objecttype heeft in MIM geen korte, altijd aanwezige
# sleutel: de populatiebeschrijving is proza en de identificatie is een IRI.
# Een chip zonder inhoud zegt minder dan geen chip.
vlmim:ObjecttypeFormShape a sh:NodeShape ;
    sh:targetClass mim:Objecttype ;
    rdfs:label "Objecttypeformulier"@nl , "Object type form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:alias ;
        sh:name "Alias"@nl , "Alias"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:indicatieAbstractObject ;
        sh:name "Abstract objecttype"@nl , "Abstract object type"@en ;
        sh:group gd:GroepKenmerken ; sh:order 11 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:populatie ;
        sh:name "Populatie"@nl , "Population"@en ;
        sh:description """De beschrijving van welke exemplaren van dit
objecttype in de registratie voorhanden zijn. Dit is het metagegeven waarmee
MIM de populatiebeschrijving van een levering benadert — aan het modelelement,
niet aan de levering."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:kwaliteit ;
        sh:name "Kwaliteit"@nl , "Quality"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:begrip ;
        sh:name "Begrip"@nl , "Concept"@en ;
        sh:description """De term uit het begrippenkader waarop dit modelelement
is gebaseerd. MIM legt het begrippenkader zelf buiten zijn scope en levert
alleen deze verwijzing."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 22 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 23 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:attribuut ;
        sh:name "Attribuutsoorten"@nl , "Attribute types"@en ;
        sh:description """De gegevens die voor dit objecttype van toepassing
zijn, elk met naam, definitie, type en kardinaliteit als directe
metagegevens."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:gegevensgroep ;
        sh:name "Gegevensgroepen"@nl , "Data groups"@en ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:constraint ;
        sh:name "Constraints"@nl , "Constraints"@en ;
        sh:group gd:GroepStructuur ; sh:order 32 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bevatModelelement ] ;
        sh:name "In informatiemodel"@nl , "In information model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bron ] ;
        sh:name "Relatiesoorten vanuit dit objecttype"@nl ,
                "Relationship types from this object type"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:doel ] ;
        sh:name "Relatiesoorten naar dit objecttype"@nl ,
                "Relationship types to this object type"@en ;
        sh:group gd:GroepSamenhang ; sh:order 62 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    # DE AFLEIDING, TERUG GELEZEN. vlierdam-mim-afleiding.ttl legt
    # prov:wasDerivedFrom van de GEPUBLICEERDE knoop naar zijn MIM-tegenhanger;
    # vanaf de MIM-kant is dat dus een omgekeerd pad. Blijft deze rij leeg, dan
    # zegt dat iets: voor de normatieve laag, de leveringslaag en de
    # ontsluiting bestaat er geen MIM-bron (synthese §3).
    sh:property [
        sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
        sh:name "Gepubliceerd als"@nl , "Published as"@en ;
        sh:description """De knoop in de gepubliceerde GLO-veldlaag die van dit
modelelement is afgeleid."""@nl ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomst ;
        sh:name "Herkomst"@nl , "Origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomstDefinitie ;
        sh:name "Herkomst definitie"@nl , "Definition origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 73 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:datumOpname ;
        sh:name "Datum opname"@nl , "Date added"@en ;
        sh:group gd:GroepHerkomst ; sh:order 74 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- De attribuutsoort -------------------------------------------------------
#
# Het rijkste formulier van dit bestand, en de plek waar de winst van de
# MIM-gedaante te zien is: naam, definitie, type, kardinaliteit, lengte en
# patroon staan als PLATTE metagegevens op één knoop, waar de gepubliceerde
# veldlaag ze achter gestructureerde DDI-CDI-datatypen legt en de formulieren
# daar relaties tonen in plaats van waarden (synthese §4b, E122).
#
# HET KERNGEGEVEN IS DE KARDINALITEIT (ruling). Twee kandidaten uit de brief:
# het type en de kardinaliteit. De kardinaliteit wint omdat zij op élke
# attribuutsoort staat, altijd kort is ("1..1", "0..1") en op de dichte vouw
# de vraag beantwoordt die een lezer van een leveringsspecificatie het eerst
# stelt: moet dit veld er zijn? Het type is als terugval de tweede
# KeyInfoRole-rij — een viewer neemt de eerste die gevuld is — en staat
# bovendien als eigen rij onder Structuur.
vlmim:AttribuutsoortFormShape a sh:NodeShape ;
    sh:targetClass mim:Attribuutsoort ;
    rdfs:label "Attribuutsoortformulier"@nl , "Attribute type form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:kardinaliteit ;
        sh:name "Kardinaliteit"@nl , "Cardinality"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:type ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 3 ; dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificerend ;
        sh:name "Identificerend"@nl , "Identifying"@en ;
        sh:description """Aanduiding dat dit kenmerk uniek identificerend is
voor alle objecten in de populatie — wat MIM het dichtst bij een sleutel
kent."""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:mogelijkGeenWaarde ;
        sh:name "Mogelijk geen waarde"@nl , "May have no value"@en ;
        sh:description """Het MIM-onderscheid tussen "het kenmerk ontbreekt"
(kardinaliteit 0) en "het kenmerk bestaat maar de waarde is onbekend". MIM
kent hiervoor een indicator en geen apart ontbrekendwaardedomein; de scheiding
die de gepubliceerde veldlaag met een sentinel-domein maakt, leeft hier in
deze indicator plus een mim:Keuze (synthese §2d, E88)."""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 11 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:authentiek ;
        sh:name "Authenticiteit"@nl , "Authenticity"@en ;
        sh:description """De wettelijke status van het gegeven, uit de vijf
waarden die MIM normatief opsomt."""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 12 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:indicatieAfleidbaar ;
        sh:name "Afleidbaar"@nl , "Derivable"@en ;
        sh:group gd:GroepKenmerken ; sh:order 13 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:indicatieClassificerend ;
        sh:name "Classificerend"@nl , "Classifying"@en ;
        sh:group gd:GroepKenmerken ; sh:order 14 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:alias ;
        sh:name "Alias"@nl , "Alias"@en ;
        sh:group gd:GroepKenmerken ; sh:order 15 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    # De twee extensie-metagegevens. Zij staan onder "Inhoud en afbakening" en
    # niet onder "Kenmerken", want zij zeggen iets over de DELING van dit veld
    # en niet over zijn vorm. De noodzaak per veld heeft hier voor het eerst een
    # eigen term in plaats van een skos:scopeNote (synthese §2d, E91).
    sh:property [
        sh:path mimx:noodzaak ;
        sh:name "Noodzaak"@nl , "Necessity"@en ;
        sh:description """Waarom dit veld voor het doel van de levering nodig
is. Extensie-metagegeven: MIM 1.2 kent er geen term voor."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mimx:classificatie ;
        sh:name "Classificatie"@nl , "Classification"@en ;
        sh:description """De classificatie van dit gegeven, bijvoorbeeld als
persoonsgegeven. Extensie-metagegeven: MIM 1.2 kent alleen authenticiteit, en
die betekent iets anders."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:begrip ;
        sh:name "Begrip"@nl , "Concept"@en ;
        sh:group gd:GroepInhoud ; sh:order 22 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:begripsterm ;
        sh:name "Begripsterm"@nl , "Concept term"@en ;
        sh:group gd:GroepInhoud ; sh:order 23 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 24 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:type ;
        sh:name "Type"@nl , "Data type"@en ;
        sh:description """Het datatype waarmee waarden van dit kenmerk worden
vastgelegd: een primitief datatype, een enumeratie, een codelijst of een
referentielijst."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:datatypekeuze ;
        sh:name "Datatypekeuze"@nl , "Data type choice"@en ;
        sh:description """Een mim:Keuze in plaats van één type: er is er precies
één tegelijk van toepassing."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:lengte ;
        sh:name "Lengte"@nl , "Length"@en ;
        sh:group gd:GroepStructuur ; sh:order 32 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:patroon ;
        sh:name "Patroon"@nl , "Pattern"@en ;
        sh:description "Het waardenbereik in woorden."@nl ;
        sh:group gd:GroepStructuur ; sh:order 33 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:formeelPatroon ;
        sh:name "Formeel patroon"@nl , "Formal pattern"@en ;
        sh:description "Hetzelfde waardenbereik als reguliere expressie."@nl ;
        sh:group gd:GroepStructuur ; sh:order 34 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:minimumwaardeInclusief ;
        sh:name "Minimumwaarde (inclusief)"@nl , "Minimum value (inclusive)"@en ;
        sh:group gd:GroepStructuur ; sh:order 35 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:maximumwaardeInclusief ;
        sh:name "Maximumwaarde (inclusief)"@nl , "Maximum value (inclusive)"@en ;
        sh:group gd:GroepStructuur ; sh:order 36 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:eenheid ;
        sh:name "Eenheid"@nl , "Unit"@en ;
        sh:group gd:GroepStructuur ; sh:order 37 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:heeftTijdlijnGeldigheid ;
        sh:name "Tijdlijn geldigheid"@nl , "Validity timeline"@en ;
        sh:group gd:GroepStructuur ; sh:order 38 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:heeftTijdlijnRegistratie ;
        sh:name "Tijdlijn registratie"@nl , "Registration timeline"@en ;
        sh:group gd:GroepStructuur ; sh:order 39 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    # HET OMGEKEERDE PAD DAT DE ATTRIBUUTSOORT AAN HAAR OBJECTTYPE HANGT.
    # mim:attribuut loopt van objecttype naar attribuutsoort; zonder omkering
    # is een attribuutsoort een knoop zonder ouder en houdt het doorklikken
    # aan deze kant op.
    sh:property [
        sh:path [ sh:inversePath mim:attribuut ] ;
        sh:name "Attribuutsoort van"@nl , "Attribute type of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bevatModelelement ] ;
        sh:name "In informatiemodel"@nl , "In information model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
        sh:name "Gepubliceerd als"@nl , "Published as"@en ;
        sh:description """Het gegevenstype in de gepubliceerde GLO-veldlaag dat
van deze attribuutsoort is afgeleid."""@nl ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomst ;
        sh:name "Herkomst"@nl , "Origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomstDefinitie ;
        sh:name "Herkomst definitie"@nl , "Definition origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 73 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:datumOpname ;
        sh:name "Datum opname"@nl , "Date added"@en ;
        sh:group gd:GroepHerkomst ; sh:order 74 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- De waardelijsten --------------------------------------------------------
#
# Drie formulieren die samen de doorklik tot en met de enumeratiewaarden
# dragen: enumeratie → enumeratiewaarde, en de codelijst als de variant die
# haar waarden buiten het model laat beheren. Zonder het derde formulier houdt
# het doorklikken op bij de lijst en blijven de toegestane waarden onzichtbaar
# — dezelfde reden waarom glo-shapes.ttl een codelijstformulier heeft.

vlmim:EnumeratieFormShape a sh:NodeShape ;
    sh:targetClass mim:Enumeratie ;
    rdfs:label "Enumeratieformulier"@nl , "Enumeration form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:waarde ;
        sh:name "Enumeratiewaarden"@nl , "Enumeration values"@en ;
        sh:description """De limitatieve lijst: alleen deze waarden mogen
voorkomen."""@nl ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:type ] ;
        sh:name "Type van"@nl , "Data type of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bevatModelelement ] ;
        sh:name "In informatiemodel"@nl , "In information model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
        sh:name "Gepubliceerd als"@nl , "Published as"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:datumOpname ;
        sh:name "Datum opname"@nl , "Date added"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# De code is het kerngegeven: zij is wat er in de registratie terechtkomt, en
# zij past op een chip naast de naam.
vlmim:EnumeratiewaardeFormShape a sh:NodeShape ;
    sh:targetClass mim:Enumeratiewaarde ;
    rdfs:label "Enumeratiewaardeformulier"@nl , "Enumeration value form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:code ;
        sh:name "Code"@nl , "Code"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:begrip ;
        sh:name "Begrip"@nl , "Concept"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:waarde ] ;
        sh:name "Waarde in"@nl , "Value in"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
        sh:name "Gepubliceerd als"@nl , "Published as"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] .

vlmim:CodelijstFormShape a sh:NodeShape ;
    sh:targetClass mim:Codelijst ;
    rdfs:label "Codelijstformulier (MIM)"@nl , "Code list form (MIM)"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:locatie ;
        sh:name "Vindplaats van de waardelijst"@nl , "Location of the value list"@en ;
        sh:description """Een codelijst wordt buiten het informatiemodel
beheerd; dit is waar de waarden staan. Het model beschrijft ze niet zelf — dat
is het verschil met een referentielijst."""@nl ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:URIViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:begrip ;
        sh:name "Begrip"@nl , "Concept"@en ;
        sh:group gd:GroepInhoud ; sh:order 21 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:type ] ;
        sh:name "Type van"@nl , "Data type of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bevatModelelement ] ;
        sh:name "In informatiemodel"@nl , "In information model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
        sh:name "Gepubliceerd als"@nl , "Published as"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomst ;
        sh:name "Herkomst"@nl , "Origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- De keuze ----------------------------------------------------------------
#
# De kunstgreep uit synthese §2d (E88) heeft een eigen formulier nodig, anders
# is zij in de weergave een knoop zonder inhoud. mim:type draagt hier de
# alternatieven (minimaal twee, per mim-shapes.ttl); het omgekeerde pad wijst
# terug naar de attribuutsoort die de keuze gebruikt.
vlmim:KeuzeFormShape a sh:NodeShape ;
    sh:targetClass mim:Keuze ;
    rdfs:label "Keuzeformulier"@nl , "Choice form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:type ;
        sh:name "Keuze uit"@nl , "Choice between"@en ;
        sh:description """De datatypen waaruit gekozen wordt; er is er precies
één tegelijk van toepassing."""@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:datatypekeuze ] ;
        sh:name "Keuze van"@nl , "Choice of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bevatModelelement ] ;
        sh:name "In informatiemodel"@nl , "In information model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 61 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- Het primitieve datatype -------------------------------------------------
#
# Voor een eigen primitief datatype in het bronmodel. De MIM-standaard levert
# er zelf elf (mim:CharacterString, mim:Date, …); die staan in mim.ttl en niet
# in deze graaf, dus zij krijgen geen vouw maar wel een label (§2).
vlmim:PrimitiefDatatypeFormShape a sh:NodeShape ;
    sh:targetClass mim:PrimitiefDatatype ;
    rdfs:label "Formulier primitief datatype"@nl , "Primitive data type form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:lengte ;
        sh:name "Lengte"@nl , "Length"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:patroon ;
        sh:name "Patroon"@nl , "Pattern"@en ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:formeelPatroon ;
        sh:name "Formeel patroon"@nl , "Formal pattern"@en ;
        sh:group gd:GroepStructuur ; sh:order 32 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:type ] ;
        sh:name "Type van"@nl , "Data type of"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- De relatiesoort ---------------------------------------------------------
#
# Het administratiemodel van de overeenkomst zelf gebruikt relatiesoorten naar
# de twee partijen. De kardinaliteit is het kerngegeven, om dezelfde reden als
# bij de attribuutsoort.
vlmim:RelatiesoortFormShape a sh:NodeShape ;
    sh:targetClass mim:Relatiesoort ;
    rdfs:label "Relatiesoortformulier"@nl , "Relationship type form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:kardinaliteit ;
        sh:name "Kardinaliteit"@nl , "Cardinality"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:kardinaliteitRelatieBron ;
        sh:name "Kardinaliteit aan bronzijde"@nl , "Source cardinality"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:unidirectioneel ;
        sh:name "Unidirectioneel"@nl , "Unidirectional"@en ;
        sh:group gd:GroepKenmerken ; sh:order 11 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:aggregatietype ;
        sh:name "Aggregatietype"@nl , "Aggregation type"@en ;
        sh:group gd:GroepKenmerken ; sh:order 12 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path mim:bron ;
        sh:name "Bron"@nl , "Source"@en ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:doel ;
        sh:name "Doel"@nl , "Target"@en ;
        sh:group gd:GroepStructuur ; sh:order 31 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:relatierol ;
        sh:name "Relatierol"@nl , "Relationship role"@en ;
        sh:group gd:GroepStructuur ; sh:order 32 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:bevatModelelement ] ;
        sh:name "In informatiemodel"@nl , "In information model"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
        sh:name "Gepubliceerd als"@nl , "Published as"@en ;
        sh:group gd:GroepHerkomst ; sh:order 70 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:datumOpname ;
        sh:name "Datum opname"@nl , "Date added"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- De relatierol -----------------------------------------------------------
#
# Het administratiemodel gebruikt het alternatief niet — de relatiesoort is
# leidend — maar benoemt de rol wél. Zonder eigen formulier is de rol een dood
# label aan het eind van de relatiesoort, en juist daar wil een lezer kunnen
# zien wat MIM met "rol" bedoelt: de manier waarop een OBJECT deelneemt aan een
# relatie tussen objecten, en niet de rol van een partij in een afspraak
# (synthese §2a).
vlmim:RelatierolFormShape a sh:NodeShape ;
    sh:targetClass mim:Relatierol ;
    rdfs:label "Relatierolformulier"@nl , "Relationship role form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:definitie ;
        sh:name "Definitie"@nl , "Definition"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:kardinaliteit ;
        sh:name "Kardinaliteit"@nl , "Cardinality"@en ;
        dash:propertyRole dash:KeyInfoRole ;
        sh:order 2 ; dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:identificerend ;
        sh:name "Identificerend"@nl , "Identifying"@en ;
        sh:group gd:GroepKenmerken ; sh:order 10 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:authentiek ;
        sh:name "Authenticiteit"@nl , "Authenticity"@en ;
        sh:group gd:GroepKenmerken ; sh:order 11 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:toelichting ;
        sh:name "Toelichting"@nl , "Explanatory note"@en ;
        sh:group gd:GroepInhoud ; sh:order 20 ;
        dash:viewer dash:LangStringViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:relatierol ] ;
        sh:name "Rol in relatiesoort"@nl , "Role in relationship type"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:herkomst ;
        sh:name "Herkomst"@nl , "Origin"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 72 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# --- De constraint -----------------------------------------------------------
#
# MIM's enige drager voor een voorwaarde. Hij staat hier om te laten zien
# hoever die reikt: een constraint is een uitspraak OVER HET MODEL, geen norm
# die een partij bindt (synthese §2b).
vlmim:ConstraintFormShape a sh:NodeShape ;
    sh:targetClass mim:Constraint ;
    rdfs:label "Constraintformulier"@nl , "Constraint form"@en ;
    sh:property [
        sh:path mim:naam ;
        dash:propertyRole dash:LabelRole ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path mim:specificatieTekst ;
        sh:name "Specificatie (tekst)"@nl , "Specification (text)"@en ;
        dash:propertyRole dash:DescriptionRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path mim:specificatieFormeel ;
        sh:name "Specificatie (formeel)"@nl , "Specification (formal)"@en ;
        sh:description "De constraint in OCL."@nl ;
        sh:group gd:GroepStructuur ; sh:order 30 ;
        dash:viewer dash:LiteralViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath mim:constraint ] ;
        sh:name "Geldt voor"@nl , "Applies to"@en ;
        sh:group gd:GroepSamenhang ; sh:order 60 ;
        dash:viewer dash:LabelViewer ;
    ] ;
    sh:property [
        sh:path mim:identificatie ;
        sh:name "Identificatie"@nl , "Identification"@en ;
        sh:group gd:GroepHerkomst ; sh:order 71 ;
        dash:viewer dash:LiteralViewer ;
    ] .

# =============================================================================
# 2. DE LABELS VAN DE MIM-TERMEN
#
# Nederlandse labels en definities LETTERLIJK uit media/mim.ttl van de
# MIM-Werkomgeving (commit 4f3fc35e538c0a000580b8449993a6a6bea53740, MIM 1.2);
# de Engelse labels zijn vertalingen in dit bestand. Zonder dit blok toont een
# viewer die deze data zonder de MIM-ontologie laadt de IRI-staart, want de
# namespace dereferenceert niet.
#
# ALLEEN LABELS EN DEFINITIES, geen rdf:type en geen rdfs:subClassOf: deze
# termen zijn hier weergavemateriaal en geen knopen met een eigen formulier.
# Wie de MIM-ontologie erbij laadt, krijgt haar axioma's daarvandaan.
#
# DE KEUZE VAN DE TERMEN is de gebruikte verzameling: de klassen en
# metagegevens die de formulieren hierboven aanwijzen, plus de MIM-instanties
# waar het bronmodel naar verwijst (de primitieve datatypen en de drie
# waardelijsten van het metamodel zelf).
# =============================================================================

# --- Klassen -----------------------------------------------------------------

mim:Informatiemodel rdfs:label "Informatiemodel"@nl , "Information model"@en ;
    rdfs:comment "De groepering van alle modelelementen waaruit het informatiemodel is opgebouwd. Het informatiemodel als geheel."@nl .
mim:Package rdfs:label "Package"@nl , "Package"@en ;
    rdfs:comment "Een package is een benoemde en begrensde verzameling/groepering van modelelementen."@nl .
mim:Modelelement rdfs:label "Modelelement"@nl , "Model element"@en ;
    rdfs:comment "Een modelelement uit het Metamodel voor Informatie Modellering (MIM)"@nl .
mim:Objecttype rdfs:label "Objecttype"@nl , "Object type"@en ;
    rdfs:comment "De typering van een groep objecten die binnen een domein relevant zijn en als gelijksoortig worden beschouwd."@nl .
mim:Attribuutsoort rdfs:label "Attribuutsoort"@nl , "Attribute type"@en ;
    rdfs:comment "De typering van gelijksoortige gegevens die voor een objecttype van toepassing is."@nl .
mim:Gegevensgroep rdfs:label "Gegevensgroep"@nl , "Data group"@en ;
    rdfs:comment "Een typering van een groep van gelijksoortige gegevens die voor een objecttype van toepassing is."@nl .
mim:Gegevensgroeptype rdfs:label "Gegevensgroeptype"@nl , "Data group type"@en ;
    rdfs:comment "Een groep van met elkaar samenhangende attribuutsoorten. Een gegevensgroeptype is altijd een type van een gegevensgroep."@nl .
mim:Relatiesoort rdfs:label "Relatiesoort"@nl , "Relationship type"@en ;
    rdfs:comment "De typering van het structurele verband tussen een object van een objecttype en een (ander) object van een ander (of hetzelfde) objecttype."@nl .
mim:Relatierol rdfs:label "Relatierol"@nl , "Relationship role"@en ;
    rdfs:comment "De benaming van de manier waarop een object deelneemt aan een relatie met een ander object."@nl .
mim:RelatierolBron rdfs:label "Relatierol bron"@nl , "Source relationship role"@en ;
    rdfs:comment "De relatierol die de rol beschrijft van de bron van de relatie."@nl .
mim:RelatierolDoel rdfs:label "Relatierol doel"@nl , "Target relationship role"@en ;
    rdfs:comment "De relatierol die de rol beschrijft van het doel van de relatie."@nl .
mim:Datatype rdfs:label "Datatype"@nl , "Data type"@en ;
    rdfs:comment "Een beschrijving van de structuur waaraan een waarde, oftewel de data zelf, aan moet voldoen."@nl .
mim:PrimitiefDatatype rdfs:label "Primitief datatype"@nl , "Primitive data type"@en ;
    rdfs:comment "Een primitief datatype is een datatype met een eenvoudige basisstructuur, oftewel enkelvoudig en zonder gelaagdheid."@nl .
mim:GestructureerdDatatype rdfs:label "Gestructureerd datatype"@nl , "Structured data type"@en ;
    rdfs:comment "Specifiek benoemd datatype dat de structuur van een gegeven beschrijft, samengesteld uit minimaal twee elementen die in samenhang betekenisvol zijn."@nl .
mim:Enumeratie rdfs:label "Enumeratie"@nl , "Enumeration"@en ;
    rdfs:comment "Een datatype waarvan de mogelijke waarden limitatief zijn opgesomd in een statische lijst."@nl .
mim:Enumeratiewaarde rdfs:label "Enumeratiewaarde"@nl , "Enumeration value"@en ;
    rdfs:comment "Een gedefinieerde waarde, in de vorm van een eenmalig vastgesteld constant gegeven."@nl .
mim:Codelijst rdfs:label "Codelijst"@nl , "Code list"@en ;
    rdfs:comment "De representatie van een lijst met een opsomming van de mogelijke domeinwaarden van een attribuutsoort, die buiten het model in een externe waardenlijst worden beheerd. De representatie bevat geen kenmerken, voor alle kenmerken wordt verwezen naar de specificatie van de externe waardelijst."@nl .
mim:Referentielijst rdfs:label "Referentielijst"@nl , "Reference list"@en ;
    rdfs:comment "De representatie van een lijst met een opsomming van de mogelijke domeinwaarden van een attribuutsoort, die buiten het model in een externe waardenlijst worden beheerd. De representatie bevat een aantal kenmerken, die overgenomen zijn van de specificatie van de externe waardelijst."@nl .
mim:Keuze rdfs:label "Keuze"@nl , "Choice"@en ;
    rdfs:comment "Een opsomming van meerdere modelelementen, waarbij er maar van één tegelijkertijd sprake kan zijn."@nl .
mim:Constraint rdfs:label "Constraint"@nl , "Constraint"@en ;
    rdfs:comment "Een constraint is een conditie of een beperking, die over een of meerdere modelelementen uit het informatiemodel geldt."@nl .
mim:Generalisatie rdfs:label "Generalisatie"@nl , "Generalisation"@en ;
    rdfs:comment "De typering van het hiërarchische verband tussen een meer generiek en een meer specifiek modelelement van hetzelfde soort, waarbij het meer specifieke modelelement eigenschappen van het meer generieke modelelement overerft. Dit verband is alleen gedefinieerd voor objecttypen en datatypen."@nl .

# --- Metagegevens ------------------------------------------------------------

mim:naam rdfs:label "naam"@nl , "name"@en ;
    rdfs:comment "De naam van een modelelement."@nl .
mim:alias rdfs:label "alias"@nl , "alias"@en ;
    rdfs:comment "De weergave van de naam van een modelelement in natuurlijke taal (niet technisch)."@nl .
mim:definitie rdfs:label "definitie"@nl , "definition"@en ;
    rdfs:comment "De beschrijving van de betekenis van dit modelelement."@nl .
mim:toelichting rdfs:label "toelichting"@nl , "explanatory note"@en ;
    rdfs:comment "Een inhoudelijke toelichting op de definitie, ter verheldering of nadere duiding."@nl .
mim:herkomst rdfs:label "herkomst"@nl , "origin"@en ;
    rdfs:comment "De registratie of het informatiemodel waaraan het modelelement ontleend is dan wel de eigen organisatie indien het door de eigen organisatie toegevoegd is."@nl .
mim:herkomstDefinitie rdfs:label "herkomst definitie"@nl , "definition origin"@en ;
    rdfs:comment "De registratie of het informatiemodel waaruit de definitie is overgenomen dan wel een aanduiding die aangeeft uit welke bronnen de definitie is samengesteld."@nl .
mim:datumOpname rdfs:label "datum opname"@nl , "date added"@en ;
    rdfs:comment "De datum waarop het modelelement is opgenomen in het informatiemodel."@nl .
mim:identificatie rdfs:label "Identificatie"@nl , "identification"@en ;
    rdfs:comment "De identificatie van een modelelement."@nl .
mim:basisUri rdfs:label "Basis-URI"@nl , "base URI"@en ;
    rdfs:comment "De standaard basis-URI voor elk element in dit informatiemodel."@nl .
mim:begrip rdfs:label "begrip"@nl , "concept"@en ;
    rdfs:comment "Verwijzing naar een begrip, vanuit een modelelement, waarmee wordt aangegeven op welk begrip, of begrippen, het informatiemodel element is gebaseerd."@nl .
mim:begripsterm rdfs:label "begripsterm"@nl , "concept term"@en ;
    rdfs:comment "Verwijzing naar een begrip in de vorm van een term, vanuit een modelelement, waarmee wordt aangegeven op welk begrip, of begrippen, het informatiemodel element is gebaseerd."@nl .
mim:attribuut rdfs:label "attribuut"@nl , "attribute"@en ;
    rdfs:comment "De binding van een attribuutsoort als eigenschap aan een objecttype."@nl .
mim:gegevensgroep rdfs:label "gegevensgroep"@nl , "data group"@en ;
    rdfs:comment "De binding van een gegevensgroep als groep van eigenschappen aan een objecttype of gegevensgroeptype."@nl .
mim:bevatModelelement rdfs:label "bevat modelelement"@nl , "contains model element"@en ;
    rdfs:comment "De binding tussen een package en een modelelement dat zich in dat package bevindt."@nl .
mim:type rdfs:label "type"@nl , "data type"@en ;
    rdfs:comment "Het datatype waarmee waarden van dit modelelement worden vastgelegd."@nl .
mim:datatypekeuze rdfs:label "datatypekeuze"@nl , "data type choice"@en ;
    rdfs:comment "De binding van een keuze uit datatypen aan een attribuutsoort."@nl .
mim:kardinaliteit rdfs:label "kardinaliteit"@nl , "cardinality"@en ;
    rdfs:comment "De kardinaliteit geeft aan hoeveel keer waarden van dit kenmerk van een object kunnen voorkomen bij een object van het betreffende objecttype."@nl .
mim:kardinaliteitRelatieBron rdfs:label "kardinaliteit relatie bron"@nl , "source cardinality"@en ;
    rdfs:comment "De kardinaliteit relatie bron geeft bij een relatiesoort aan hoeveel instanties van het bron objecttype in een relatie met één instantie van het doel objecttype verbonden kunnen zijn."@nl .
mim:lengte rdfs:label "lengte"@nl , "length"@en ;
    rdfs:comment "De aanduiding van de lengte van een gegeven, volgens de aangegeven notatiewijze."@nl .
mim:patroon rdfs:label "patroon"@nl , "pattern"@en ;
    rdfs:comment "De verzameling van waarden die gegevens van deze attribuutsoort kunnen hebben, oftewel het waardenbereik, uitgedrukt in een specifieke structuur."@nl .
mim:formeelPatroon rdfs:label "formeel patroon"@nl , "formal pattern"@en ;
    rdfs:comment "Zoals patroon, formeel vastgelegd, uitgedrukt in een formele taal die door de computer wordt herkend."@nl .
mim:minimumwaardeInclusief rdfs:label "minimumwaarde inclusief"@nl , "minimum value inclusive"@en .
mim:maximumwaardeInclusief rdfs:label "maximumwaarde inclusief"@nl , "maximum value inclusive"@en .
mim:eenheid rdfs:label "eenheid"@nl , "unit"@en ;
    rdfs:comment "Aanduiding van de eenheid die bij een meting of waarneming hoort."@nl .
mim:identificerend rdfs:label "identificerend"@nl , "identifying"@en ;
    rdfs:comment "Een aanduiding dat een kenmerk of een combinatie van kenmerken van een objecttype uniek identificerend is voor alle objecten in de populatie van objecten van dit objecttype, of de aanduiding dat een referentie element uniek identificerend is voor alle lijst items in een referentielijst."@nl .
mim:mogelijkGeenWaarde rdfs:label "mogelijk geen waarde"@nl , "may have no value"@en ;
    rdfs:comment "Aanduiding dat van een aspect geen waarde is geregistreerd, maar dat onduidelijk is of de waarde er werkelijk ook niet is."@nl .
mim:authentiek rdfs:label "authentiek"@nl , "authenticity"@en ;
    rdfs:comment "Aanduiding of het kenmerk een authentiek gegeven betreft."@nl .
mim:indicatieAfleidbaar rdfs:label "indicatie afleidbaar"@nl , "derivable"@en ;
    rdfs:comment "Aanduiding dat gegeven afleidbaar is uit andere attribuut- en/of relatiesoorten."@nl .
mim:indicatieClassificerend rdfs:label "indicatie classificerend"@nl , "classifying"@en ;
    rdfs:comment "Indicatie dat een attribuutsoort het objecttype waar het bij hoort classificeert in (sub)typen."@nl .
mim:indicatieAbstractObject rdfs:label "indicatie abstract object"@nl , "abstract object"@en ;
    rdfs:comment "Een indicatie die aangeeft of er objecten kunnen bestaan die getypeerd worden als zijnde objecten (instanties) van alleen dit objecttype."@nl .
mim:heeftTijdlijnGeldigheid rdfs:label "heeft tijdlijn geldigheid"@nl , "has validity timeline"@en ;
    rdfs:comment "Indicatie of voor dit kenmerk een tijdlijn geldigheid bijgehouden wordt en te bevragen is."@nl .
mim:heeftTijdlijnRegistratie rdfs:label "heeft tijdlijn registratie"@nl , "has registration timeline"@en ;
    rdfs:comment "Indicatie of voor dit kenmerk een tijdlijn registratie bijgehouden wordt en te bevragen is."@nl .
mim:indicatieMaterieleHistorie rdfs:label "Indicatie materiële historie"@nl , "material history"@en ;
    rdfs:comment "Indicatie of de materiële historie van het kenmerk van het object te bevragen is."@nl .
mim:indicatieFormeleHistorie rdfs:label "Indicatie formele historie"@nl , "formal history"@en ;
    rdfs:comment "Indicatie of de formele historie van het kenmerk van het object bijgehouden wordt en te bevragen is."@nl .
mim:populatie rdfs:label "populatie"@nl , "population"@en ;
    rdfs:comment "Voor objecttypen die deel uitmaken van een (basis)registratie betreft dit de beschrijving van de exemplaren van het gedefinieerde objecttype die in de desbetreffende (basis)registratie voorhanden zijn."@nl .
mim:kwaliteit rdfs:label "kwaliteit"@nl , "quality"@en ;
    rdfs:comment "Beschrijving van de mate waarin in de registratie opgenomen objecten van het desbetreffende type volledig, juist, actueel, nauwkeurig en betrouwbaar zijn."@nl .
mim:locatie rdfs:label "locatie"@nl , "location"@en ;
    rdfs:comment "Als het type van het attribuutsoort een waardenlijst is, dan wordt hier de locatie waar deze te vinden is opgegeven."@nl .
mim:code rdfs:label "code"@nl , "code"@en ;
    rdfs:comment "De in een registratie of informatiemodel aan de enumeratiewaarde toegekend unieke code"@nl .
mim:waarde rdfs:label "waarde"@nl , "value"@en ;
    rdfs:comment "De binding van een enumeratiewaarde aan een enumeratie."@nl .
mim:bron rdfs:label "bron"@nl , "source"@en ;
    rdfs:comment "Aanduiding van het bronobject in een relatie tussen objecten. Een bronobject heeft middels een relatiesoort een relatie met een doelobject."@nl .
mim:doel rdfs:label "doel"@nl , "target"@en ;
    rdfs:comment "Aanduiding van het gerelateerde objecttype die het eindpunt van de relatie aangeeft. Naar objecten van dit objecttype wordt verwezen."@nl .
mim:unidirectioneel rdfs:label "unidirectioneel"@nl , "unidirectional"@en ;
    rdfs:comment "De richting van een relatie, welke betekenis geeft aan de relatie vanuit het perspectief van de eigenaar van de relatie."@nl .
mim:aggregatietype rdfs:label "aggregatietype"@nl , "aggregation type"@en ;
    rdfs:comment "Aanduiding of het objecttype die de eigenaar is van een relatie het doel van relatie ziet als een samen te voegen onderdeel die bij het objecttype hoort."@nl .
mim:relatierol rdfs:label "relatierol"@nl , "relationship role"@en .
mim:constraint rdfs:label "constraint"@nl , "constraint"@en ;
    rdfs:comment "De binding van een constraint aan een modelelement."@nl .
mim:specificatieTekst rdfs:label "specificatie tekst"@nl , "specification text"@en ;
    rdfs:comment "De specificatie van de constraint in normale tekst."@nl .
mim:specificatieFormeel rdfs:label "specificatie formeel"@nl , "formal specification"@en ;
    rdfs:comment "De beschrijving van de constraint in een formele specificatietaal, in OCL"@nl .
mim:informatiedomein rdfs:label "informatiedomein"@nl , "information domain"@en ;
    rdfs:comment "Aanduiding van het functionele domein waartoe het informatiemodel behoort."@nl .
mim:informatiemodeltype rdfs:label "informatiemodeltype"@nl , "information model type"@en ;
    rdfs:comment "De beschrijving van de aard van het informatiemodel, hoe het geïnterpreteerd moet worden."@nl .
mim:relatiemodelleringstype rdfs:label "relatiemodelleringstype"@nl , "relationship modelling type"@en ;
    rdfs:comment "Aanduiding van een in MIM gedefinieerd alternatief voor een modelleringswijze, en welke keuze hierbij is gemaakt."@nl .
mim:mimversie rdfs:label "MIM versie"@nl , "MIM version"@en ;
    rdfs:comment "De versie van de MIM specificatie die gebruikt is om het informatiemodel in uit te drukken."@nl .
mim:mimextensie rdfs:label "MIM extensie"@nl , "MIM extension"@en ;
    rdfs:comment "De aanduiding van een extensie op MIM."@nl .
mim:mimtaal rdfs:label "MIM taal"@nl , "MIM language"@en ;
    rdfs:comment "De aanduiding van de taal die gebruikt is voor de modelelementen."@nl .
mim:tekstopmaak rdfs:label "Tekstopmaak"@nl , "text formatting"@en ;
    rdfs:comment "De specificatie van de opmaak van een tekstuele beschrijving in het model."@nl .

# --- Instanties uit het metamodel zelf ---------------------------------------
#
# De elf primitieve datatypen die MIM meelevert, en de drie waardelijsten van
# het metamodel (authenticiteit, aggregatietype, informatiemodeltype,
# relatiemodelleringstype). Het bronmodel verwijst ernaar; zonder deze labels
# staat er een IRI-staart in de rij "Type" of "Authenticiteit".

mim:CharacterString rdfs:label "CharacterString"@nl , "CharacterString"@en .
mim:Integer rdfs:label "Integer"@nl , "Integer"@en .
mim:Real rdfs:label "Real"@nl , "Real"@en .
mim:Decimal rdfs:label "Decimal"@nl , "Decimal"@en .
mim:Boolean rdfs:label "Boolean"@nl , "Boolean"@en .
mim:Date rdfs:label "Date"@nl , "Date"@en ;
    rdfs:comment "4-cijferig jaar, 2-cijferig maand, 2-cijferig dag uitgedrukt in yyyy-mm-dd conform ISO 8601"@nl .
mim:DateTime rdfs:label "DateTime"@nl , "DateTime"@en .
mim:Year rdfs:label "Year"@nl , "Year"@en .
mim:Month rdfs:label "Month"@nl , "Month"@en .
mim:Day rdfs:label "Day"@nl , "Day"@en .
mim:URI rdfs:label "URI"@nl , "URI"@en .

mim:Authentiek rdfs:label "Authentiek"@nl , "Authentic"@en ;
    rdfs:comment "In een basisregistratie opgenomen gegeven dat bij wettelijk voorschrift als authentiek is aangemerkt."@nl .
mim:Basisgegeven rdfs:label "Basisgegeven"@nl , "Base registry datum"@en ;
    rdfs:comment "Een in een basisregistratie opgenomen gegeven."@nl .
mim:WettelijkGegeven rdfs:label "Wettelijk gegeven"@nl , "Statutory datum"@en ;
    rdfs:comment "Gegeven behorende bij een wettelijke registratie, niet zijnde een basisregistratie"@nl .
mim:LandelijkKerngegeven rdfs:label "Landelijk kerngegeven"@nl , "National core datum"@en .
mim:OverigeAuthenticiteit rdfs:label "Overige authenticiteit"@nl , "Other authenticity"@en .

mim:Geen rdfs:label "Geen"@nl , "None"@en .
mim:Compositie rdfs:label "Compositie"@nl , "Composition"@en .
mim:Gedeeld rdfs:label "Gedeeld"@nl , "Shared"@en .

mim:ConceptueelInformatiemodel rdfs:label "Conceptueel informatiemodel"@nl , "Conceptual information model"@en .
mim:LogischInformatiemodel rdfs:label "Logisch informatiemodel"@nl , "Logical information model"@en .
mim:TechnischInformatiemodel rdfs:label "Technisch informatiemodel"@nl , "Technical information model"@en .

mim:RelatiesoortLeidend rdfs:label "Relatiesoort leidend"@nl , "Relationship type leading"@en .
mim:RelatierolLeidend rdfs:label "Relatierol leidend"@nl , "Relationship role leading"@en .

# --- De extensietermen -------------------------------------------------------
#
# De twee metagegevens van vlierdam-mim-extensie.ttl krijgen hun labels en
# definities in dat bestand — het is de extensie zelf en zij beheert haar eigen
# vocabulaire. Wat hier staat is alleen de weergave ervan (§1, het
# attribuutsoortformulier).

# =============================================================================
# 3. DE AANHECHTING — verhuisd naar vlierdam-mim-afleiding.ttl
#
# HET PROBLEEM staat hieronder beschreven en is echt: de documentweergave daalt
# af langs de rijen van de formulieren, dus een knoop die door geen enkele
# GETOONDE rij wordt aangewezen komt niet in het document — en zonder
# aanhechting is de hele MIM-graaf onbereikbaar (nul vouwen, nul formulieren).
# De OPLOSSING is ook ongewijzigd: één tripel op dct:conformsTo (de rij
# "Voldoet aan" die het bestaande formulier al toont), niet een tweede
# formulier-shape die het rijke formulier van glo-shapes.ttl zou kunnen
# verdringen.
#
# WAT DE FOLD VERANDERD HEEFT (14 sep 2026): de tripel zelf staat niet meer in
# DIT bestand maar in `vlierdam-mim-afleiding.ttl`. Dit is een WEERGAVEbestand
# — formulier-shapes en labels — en de uitspraak "deze gegevensleverings-
# specificatie voldoet aan dit informatiemodel" is een uitspraak over de CASUS,
# niet over de weergave. Zij hoort bij de tweeëntwintig
# `prov:wasDerivedFrom`-uitspraken die daar al staan en precies dezelfde vraag
# beantwoorden: hoe verhouden de gepubliceerde stapel en de MIM-bron zich tot
# elkaar. De lane bood deze verhuizing zelf als alternatief aan; de fold heeft
# hem overgenomen.
#
# VEILIG, want de twee bestanden reizen samen: `docker/fuseki/load.sh` laadt
# `data/vlierdam/*.ttl` met een glob, en een lezer die de MIM-shapes laadt
# zonder de MIM-data houdt sowieso een leeg formulier over.
# =============================================================================

## --- data/odrl-ap-nl.ttl ---
@prefix apnl:   <https://standaarden.overheid.nl/odrl-ap-nl/> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dpv:    <https://w3id.org/dpv#> .
@prefix prof:   <http://www.w3.org/ns/dx/prof/> .
@prefix role:   <http://www.w3.org/ns/dx/prof/role/> .

# =============================================================================
# ODRL-AP-NL — Applicatieprofiel voor toegangsbeleid Nederlandse overheid
#
# Werkgroep Federatieve Toegangsverlening (FTV).
# Status: WERKVERSIE voor simulaties — namespace nog niet uitgegeven.
#
# Dit bestand bevat:
#   (1) de profieldeclaratie apnl:profiel (odrl:Profile + prof:Profile) die
#       policies via odrl:profile aanhalen, met PROF-resourcebeschrijvingen;
#   (2) de OWL/RDFS-vocabulaire van het profiel (klassen, properties, left
#       operand, operator), conform ODRL 2.2 §3.3: elke profielterm is een
#       skos:Concept met skos:definition. De begrippenlaag volgt NL-SBB
#       (voorkeursterm, definitie, kader-lidmaatschap, verankering) en is
#       gevalideerd tegen het NL-SBB-SHACL-profiel;
#   (3) de SKOS-Collections per termsoort (Profile Best Practices §6) die
#       machineleesbaar afbakenen welke deelverzameling van ODRL dit profiel
#       gebruikt.
#
# Profiel-IRI ≠ namespace-IRI (bewuste splitsing, Profile Best Practices):
#   - profiel-IRI  : https://standaarden.overheid.nl/odrl-ap-nl/profiel
#                    (de waarde van odrl:profile in policies)
#   - namespace    : https://standaarden.overheid.nl/odrl-ap-nl/  (prefix apnl:)
#                    (de termen; tevens de ontologie-IRI)
#
# Ontwerpuitgangspunt (bindend): het profiel definieert GEEN eigen generieke
# begrippen (doelbinding, organisatie, dataset). Die worden hergebruikt uit
# TOOI, DPV, DCAT-AP-NL en NL-SBB. ODRL-AP-NL definieert uitsluitend de
# ODRL-mappings die nodig zijn om die begrippen in policies te gebruiken.
# =============================================================================

# -----------------------------------------------------------------------------
# 0a. De profieldeclaratie (het ding dat in odrl:profile staat)
# -----------------------------------------------------------------------------

apnl:profiel a odrl:Profile , prof:Profile ;
    dct:title "ODRL-AP-NL — Applicatieprofiel toegangsbeleid"@nl ;
    dct:description """Pragmatisch ODRL 2.2-applicatieprofiel voor het beschrijven
en delen van toegangsbeleid binnen de Nederlandse overheid. Ontwikkeld in de
werkgroep Federatieve Toegangsverlening (FTV) als uitwisselformaat voor het
Register Toegangsbeleid, in samenhang met NLGov AuthZEN (het vraag/antwoord-model)
en de Authorization Decision Log (verantwoording achteraf)."""@nl ;
    # Werkversie-plaatshouder: de werkgroep FTV heeft geen eigen TOOI-
    # identificatie; BZK als stelselverantwoordelijke. (De eerdere waarde
    # oorg10101 bleek het Nederlands Forensisch Instituut — een vergissing
    # die onzichtbaar bleef zolang register-URI's ongelabeld getoond werden;
    # zie examples/labels-tooi.ttl.)
    dct:publisher <https://identifier.overheid.nl/tooi/id/ministerie/mnre1034> ;
    dct:issued "2026-07-08"^^xsd:date ;
    owl:versionInfo "0.2.0-wv" ;
    prof:isProfileOf <http://www.w3.org/ns/odrl/2/> ;
    dct:conformsTo <http://www.w3.org/ns/odrl/2/> ;
    prof:hasToken "odrl-ap-nl" ;
    rdfs:seeAlso <https://www.w3.org/TR/odrl-model/> , apnl: ;
    # PROF-resourcebeschrijvingen: welke artefacten horen bij dit profiel en in
    # welke rol. De artefact-URL's zijn plaatshouders (namespace nog niet
    # uitgegeven); relatief aan de repository-root: index.html, ontology/,
    # shapes/, context.jsonld.
    prof:hasResource [ a prof:ResourceDescriptor ;
        rdfs:label "Specificatie (mensleesbaar)"@nl ;
        prof:hasRole role:specification ;
        dct:format "text/html" ;
        prof:hasArtifact <https://standaarden.overheid.nl/odrl-ap-nl/index.html> ] ;
    prof:hasResource [ a prof:ResourceDescriptor ;
        rdfs:label "Vocabulaire (OWL/RDFS + SKOS)"@nl ;
        prof:hasRole role:vocabulary ;
        dct:format "text/turtle" ;
        prof:hasArtifact <https://standaarden.overheid.nl/odrl-ap-nl/ontology/odrl-ap-nl.ttl> ] ;
    prof:hasResource [ a prof:ResourceDescriptor ;
        rdfs:label "SHACL-shapes per conformiteitsverrijking (orthogonaal, elk zelfstandig toetsbaar; afnemer.ttl bevat ook de obligation-doorwerking)"@nl ;
        prof:hasRole role:validation ;
        dct:format "text/turtle" ;
        prof:hasArtifact <https://standaarden.overheid.nl/odrl-ap-nl/shapes/leesbaar.ttl> ,
            <https://standaarden.overheid.nl/odrl-ap-nl/shapes/afnemer.ttl> ,
            <https://standaarden.overheid.nl/odrl-ap-nl/shapes/doelbinding.ttl> ,
            <https://standaarden.overheid.nl/odrl-ap-nl/shapes/uitvoerbaar.ttl> ] ;
    prof:hasResource [ a prof:ResourceDescriptor ;
        rdfs:label "JSON-LD-context"@nl ;
        prof:hasRole role:context ;
        dct:format "application/ld+json" ;
        prof:hasArtifact <https://standaarden.overheid.nl/odrl-ap-nl/context.jsonld> ] .
    # Voorzien maar nog niet geleverd: UI-shapes (formulierdefinities) als aparte
    # resource met rol role:guidance — zie de sectie Governance van de spec.

# -----------------------------------------------------------------------------
# 0b. De vocabulaire/namespace (de ontologie-IRI; NIET de profiel-IRI)
# -----------------------------------------------------------------------------

apnl: a owl:Ontology , skos:ConceptScheme ;
    dct:title "ODRL-AP-NL-vocabulaire"@nl ;
    dct:description """De termen (klassen, properties, left operand, operator) van
het applicatieprofiel ODRL-AP-NL. De profieldeclaratie die policies in
odrl:profile aanhalen is apnl:profiel; deze namespace-IRI identificeert
uitsluitend de vocabulaire."""@nl ;
    # Werkversie-plaatshouder: de werkgroep FTV heeft geen eigen TOOI-
    # identificatie; BZK als stelselverantwoordelijke. (De eerdere waarde
    # oorg10101 bleek het Nederlands Forensisch Instituut — een vergissing
    # die onzichtbaar bleef zolang register-URI's ongelabeld getoond werden;
    # zie examples/labels-tooi.ttl.)
    dct:publisher <https://identifier.overheid.nl/tooi/id/ministerie/mnre1034> ;
    dct:issued "2026-07-08"^^xsd:date ;
    owl:versionInfo "0.2.0-wv" ;
    owl:imports <http://www.w3.org/ns/odrl/2/> ;
    # De begrippenlaag van dit vocabulaire is een begrippenkader conform NL-SBB
    # (Standaard voor het beschrijven van begrippen, Geonovum 2024): elk begrip
    # draagt skos:prefLabel@nl, skos:definition@nl en skos:inScheme, en is
    # verankerd als topbegrip of via skos:broader/skos:related. Gevalideerd
    # tegen het NL-SBB-SHACL-profiel (shapes/extern/skos-ap-nl.ttl).
    dct:conformsTo <http://nlbegrip.nl/def/skosapnl#> ;
    skos:hasTopConcept
        apnl:PolicyArtifact , apnl:verwerkingsverzoek ,
        dpv:Purpose ,
        odrl:use , odrl:purpose , odrl:dateTime , odrl:deliveryChannel ,
        odrl:eq , odrl:isA , odrl:isAnyOf , odrl:gteq , odrl:lteq ;
    rdfs:seeAlso apnl:profiel .

# =============================================================================
# 1. Machine-uitvoerbaar beleid: PolicyArtifact en PolicyBundle
#
# conformsToPolicy koppelt een ODRL-beschrijving (het WAT/WAAROM) aan een
# machine-uitvoerbare regelset (het HOE). Sluit aan op het residual-policy-
# mechanisme van de FTV-standaard (allowed_residual_policy_types /
# residual-policy-accept) en op audit_identifiers.policy_version.
# =============================================================================

apnl:PolicyArtifact a owl:Class , skos:Concept ;
    rdfs:label "Policy-artefact"@nl ;
    skos:prefLabel "policy-artefact"@nl ;
    skos:topConceptOf apnl: ;
    skos:definition """Een machine-uitvoerbare regelset die een deel van een
ODRL-AP-NL-policy afdwingbaar maakt. Een artefact is een als Linked Data ontsloten
verwijzing naar een concreet bestand (Rego-module, Cedar-policyset, OpenFGA-model)
met een mediatype (dct:format), een downloadlocatie (dcat:downloadURL), een
entrypoint (apnl:entrypoint) en een integriteitshash (apnl:sha256)."""@nl ;
    skos:inScheme apnl: ;
    rdfs:seeAlso apnl:PolicyBundle .

apnl:RegoModule a owl:Class , skos:Concept ;
    rdfs:subClassOf apnl:PolicyArtifact ;
    rdfs:label "Rego-module"@nl ;
    skos:prefLabel "Rego-module"@nl ;
    skos:broader apnl:PolicyArtifact ;
    skos:definition "Een OPA/Rego-module als policy-artefact."@nl ;
    skos:note """Verwacht dct:format \"application/vnd.rego\" en een apnl:entrypoint
dat naar het te evalueren document/regelpad wijst (bijv.
\"data.doelbinding.burgerzaken.allow\")."""@nl ;
    skos:inScheme apnl: .

apnl:CedarPolicySet a owl:Class , skos:Concept ;
    rdfs:subClassOf apnl:PolicyArtifact ;
    rdfs:label "Cedar-policyset"@nl ;
    skos:prefLabel "Cedar-policyset"@nl ;
    skos:broader apnl:PolicyArtifact ;
    skos:definition "Een Amazon Cedar-policyset als policy-artefact."@nl ;
    skos:note "Verwacht dct:format \"application/vnd.cedar\"."@nl ;
    skos:inScheme apnl: .

apnl:OpenFGAModel a owl:Class , skos:Concept ;
    rdfs:subClassOf apnl:PolicyArtifact ;
    rdfs:label "OpenFGA-autorisatiemodel"@nl ;
    skos:prefLabel "OpenFGA-autorisatiemodel"@nl ;
    skos:broader apnl:PolicyArtifact ;
    skos:definition "Een OpenFGA/Zanzibar-relatiemodel als policy-artefact."@nl ;
    skos:note "Verwacht dct:format \"application/vnd.openfga\"."@nl ;
    skos:inScheme apnl: .

apnl:PolicyBundle a owl:Class , skos:Concept ;
    rdfs:label "Policy-bundel"@nl ;
    skos:prefLabel "policy-bundel"@nl ;
    skos:related apnl:PolicyArtifact ;
    skos:definition """Een bundel van policy-artefacten, gemodelleerd als Linked
Data-entiteit. Correspondeert typisch met een OPA-bundle (.tar.gz) die meerdere
Rego-modules en databestanden bevat."""@nl ;
    skos:note """Een bundel bundelt artefacten via apnl:bundles en draagt zelf een
dct:format, dcat:downloadURL, apnl:entrypoint en apnl:sha256, plus versionering
via prov:wasRevisionOf."""@nl ;
    skos:inScheme apnl: ;
    rdfs:seeAlso apnl:PolicyArtifact .

apnl:bundles a owl:ObjectProperty , skos:Concept ;
    rdfs:domain apnl:PolicyBundle ;
    rdfs:range apnl:PolicyArtifact ;
    rdfs:label "bundelt"@nl ;
    skos:prefLabel "bundelt"@nl ;
    skos:related apnl:PolicyBundle ;
    skos:definition "Koppelt een apnl:PolicyBundle aan de apnl:PolicyArtifact-en die hij bevat."@nl ;
    skos:inScheme apnl: .

apnl:entrypoint a owl:DatatypeProperty , skos:Concept ;
    rdfs:range xsd:string ;
    rdfs:label "entrypoint"@nl ;
    skos:prefLabel "entrypoint"@nl ;
    skos:related apnl:PolicyArtifact ;
    skos:definition """Het instappunt waarop de evaluator het artefact of de bundel
aanroept. Voor Rego/OPA het query-pad naar het beslisdocument, bijv.
\"data.doelbinding.burgerzaken.allow\"."""@nl ;
    skos:inScheme apnl: .

apnl:sha256 a owl:DatatypeProperty , skos:Concept ;
    rdfs:range xsd:string ;
    rdfs:label "sha256"@nl ;
    skos:prefLabel "sha256"@nl ;
    skos:related apnl:PolicyArtifact ;
    skos:definition "De SHA-256-hash (hexadecimaal, 64 tekens) van het artefact of de bundel."@nl ;
    skos:note """Maakt integriteitscontrole en herleidbaarheid mogelijk; kan als
audit_identifiers.policy_version in een AuthZEN-antwoord worden opgenomen."""@nl ;
    skos:inScheme apnl: .

# --- GESCHRAPT (aug 2026): apnl:TechnischToetsbaar --------------------------
# Het profiel kende een marker op de LEFT OPERAND ("kan een beslispunt deze
# grootheid uberhaupt zien?"). Zij is vervallen. De vraag die zij beantwoordde
# — wat mag ik van een ongedekte voorwaarde verwachten? — wordt beantwoord door
# de twee DPV-markers op de VOORWAARDE zelf (dpv:TechnicalMeasure en
# dpv:OrganisationalMeasure, zie de sectie conformsToPolicy). Die zitten op de
# juiste korrel: toetsbaarheid is geen eigenschap van een grootheid maar van
# een voorwaarde bij een beslispunt — dezelfde grootheid is bij de ene PDP wel
# en bij de andere niet beschikbaar. Twee markeringen die op hetzelfde
# neerkwamen maar elkaar konden tegenspreken, is er één te veel.

# =============================================================================
# 2. Left operands
#
# Het profiel legt vast dat een inkomend verwerkingsverzoek (een AuthZEN-
# verzoek) als left operand mag optreden. Dit adresseert het interoperabiliteits-
# probleem dat evaluatoren (zoals FORCE/UGent) een whitelist van toegestane
# leftOperands hanteren waarin domeinspecifieke operands ontbreken.
# =============================================================================

apnl:verwerkingsverzoek a odrl:LeftOperand , skos:Concept ;
    rdfs:label "verwerkingsverzoek"@nl ;
    skos:prefLabel "verwerkingsverzoek"@nl ;
    skos:topConceptOf apnl: ;
    skos:definition """Het volledige inkomende verwerkingsverzoek (het NLGov
AuthZEN-verzoek: subject, action, resource, context) als evalueerbare grootheid."""@nl ;
    skos:note """Gebruikt in het conformsToPolicy-patroon: het verzoek MOET voldoen
aan de machine-uitvoerbare policy in de rightOperand. Omdat het verwerkingsverzoek
per definitie het evaluatieverzoek zelf is (en niet de toestand van de wereld),
staat deze constraint conform de ODRL Formal Semantics in refinement-positie op
de action (odrl:refinement), niet als odrl:constraint op de rule."""@nl ;
    skos:inScheme apnl: ;
    rdfs:seeAlso apnl:conformsToPolicy .

apnl:rolAanvrager a odrl:LeftOperand , skos:Concept ;
    rdfs:label "rol van de aanvrager"@nl ;
    skos:prefLabel "rol van de aanvrager"@nl ;
    skos:definition """De rol die de aanvrager (de persoon of dienst namens wie
het verwerkingsverzoek wordt gedaan) draagt in het autorisatiesysteem van de
afnemer, als evalueerbare grootheid."""@nl ;
    skos:note """Gedeeld constraint-type voor rolgebonden toegang ("aanvrager
heeft de rol belastingmedewerker"): de LOGISCHE toegangseis, los van de
technische afdwinging. Dat diezelfde eis ook technisch afgedwongen kan worden
(bijv. een JWT-rolcheck in een Rego-module via het conformsToPolicy-patroon)
is secundair; het logische beleid hoort leesbaar in de policy zelf te staan.
Omdat de rol een eigenschap van het verwerkingsverzoek is (subject-attribuut
in het NLGov AuthZEN-verzoek), staat deze toets conform de ODRL Formal
Semantics in refinement-positie op de action, net als odrl:purpose en
apnl:verwerkingsverzoek."""@nl ;
    skos:editorialNote """Ter discussie in de werkgroep: rolgebonden toegang is
generiek genoeg dat hergebruik van een bestaand rol-/functievocabulaire de
voorkeur verdient boven een profieleigen term; onderzoek loopt (zie de sectie
Governance). Tot die uitkomst is deze term de werkversie-conventie."""@nl ;
    skos:inScheme apnl: ;
    skos:related apnl:verwerkingsverzoek ;
    rdfs:seeAlso apnl:verwerkingsverzoek .

# =============================================================================
# 3. Operatoren
# =============================================================================

apnl:conformsToPolicy a odrl:Operator , skos:Concept ;
    rdfs:label "voldoet aan beleid"@nl ;
    skos:prefLabel "voldoet aan beleid"@nl ;
    skos:related apnl:verwerkingsverzoek ;
    skos:definition """Operator die geldt indien de leftOperand (een
apnl:verwerkingsverzoek) voldoet aan de in de rightOperand aangehaalde
apnl:PolicyArtifact of apnl:PolicyBundle."""@nl ;
    skos:note """De evaluatie van deze operator wordt gedelegeerd aan de
betreffende engine (OPA, Cedar, OpenFGA). In termen van de ODRL Formal Semantics:
de satisfaction state van de refinement is satisfied dan en slechts dan als de
gedelegeerde engine voor het verwerkingsverzoek toestemming (allow) teruggeeft."""@nl ;
    skos:inScheme apnl: ;
    rdfs:seeAlso apnl:verwerkingsverzoek , apnl:PolicyArtifact .

# =============================================================================
# 4. Compositie: Offer→Agreement-koppeling
#
# Het profiel definieert hiervoor GEEN eigen properties: de Agreement verwijst
# naar het Offer met één standaardrelatie — prov:wasDerivedFrom (MOET;
# SHACL-getoetst in shapes/afnemer.ttl, de verrijking "per afnemer"), naar een
# odrl:Offer-getypeerd doelwit. Het eerdere duplicaat dct:references naar
# datzelfde aanbod (de koppeling uit de ODRL Implementation Best Practices) is
# geschrapt. De obligation-doorwerking Offer→Agreement wordt
# eveneens in shapes/afnemer.ttl getoetst; scope-opheffing is een open ontwerpvraag (zie de
# sectie Compositie van de spec).
# =============================================================================

# =============================================================================
# 5. Doelbinding (purpose)
#
# Doelbinding wordt NIET als eigen begrip gedefinieerd, en het DOEL evenmin.
# Het profiel hergebruikt odrl:purpose als leftOperand en verwijst met de
# rightOperand naar een dpv:Purpose: een verwerkingsdoel uit het Register van
# Verwerkingsactiviteiten van de afnemer en/of een purpose uit DPV zelf.
#
# GESCHRAPT (9 sep 2026): apnl:Verwerkingsdoel, de eigen subklasse van
# dpv:Purpose die tot dan als "klasse-anker" diende. Zij voegde geen betekenis
# toe aan dpv:Purpose — de definitie zei zelf al "geen nieuw generiek begrip" —
# maar dwong wel elke doel-URI, elke shape en elke waardelijst om de
# AP-NL-variant te kennen naast de DPV-term die iedereen al gebruikt. Eén
# klasse voor één begrip: dpv:Purpose.
#
# Wat het profiel wél bijdraagt aan het doelbegrip is TAAL: een Nederlandse
# voorkeursterm, een definitie in de context van dit profiel, en een plek in
# het begrippenkader. Dat staat hieronder als ANNOTATIE op de dpv-IRI — precies
# zoals sectie 5b dat voor de overgenomen ODRL-kerntermen doet. Zo houden
# editors en viewer hun Nederlandse labels zonder dat er een tweede klasse voor
# hetzelfde begrip bestaat.
# =============================================================================

dpv:Purpose a skos:Concept ;
    rdfs:label "Verwerkingsdoel"@nl ;
    skos:prefLabel "verwerkingsdoel"@nl ;
    skos:topConceptOf apnl: ;
    skos:definition """Het doel waarvoor persoonsgegevens verwerkt worden: de
rightOperand van een odrl:purpose-refinement, afkomstig uit een Register van
Verwerkingsactiviteiten en/of uit DPV."""@nl ;
    skos:note """Overgenomen uit het Data Privacy Vocabulary; ODRL-AP-NL
definieert geen eigen doelklasse. De doel-URI MOET overeenkomen met
action.properties.dpl.core.processing_activity_id in het corresponderende NLGov
AuthZEN-verzoek. Instanties dragen bij voorkeur een dct:title en een verwijzing
naar de wettelijke grondslag (dpv:hasLegalBasis, BWB/Juriconnect)."""@nl ;
    dct:source <https://w3id.org/dpv#Purpose> ;
    skos:inScheme apnl: .

apnl:doelbindingsverwijzing a owl:AnnotationProperty , skos:Concept ;
    rdfs:label "doelbindingsverwijzing"@nl ;
    skos:prefLabel "doelbindingsverwijzing"@nl ;
    skos:related dpv:Purpose ;
    skos:definition """Documentatie-annotatie (geen nieuw begrip): de rightOperand
van een odrl:purpose-refinement verwijst naar een verwerkingsdoel (dpv:Purpose),
in de praktijk een verwerkingsregister-URI."""@nl ;
    skos:note """Deze doel-URI MOET overeenkomen met
action.properties.dpl.core.processing_activity_id in het corresponderende NLGov
AuthZEN-verzoek. Niet-normatief; wordt in voorbeelden niet als predicaat
gebruikt."""@nl ;
    skos:inScheme apnl: ;
    rdfs:seeAlso dpv:Purpose .


# =============================================================================
# 5b. NL-SBB-annotaties bij de overgenomen ODRL-kerntermen
#
# NL-SBB staat toe (en moedigt aan) dat een begrippenkader begrippen uit andere
# bronnen hergebruikt: een begrip kan via skos:inScheme in meerdere kaders
# zitten. De hier overgenomen ODRL 2.2-kerntermen krijgen daarom een
# Nederlandse voorkeursterm en definitie en een plek in het kader, zodat het
# kader als geheel NL-SBB-conform is en editors/viewers Nederlandse labels
# hebben. De Engelstalige bron blijft het ODRL 2.2-vocabulaire; machineleesbaar
# als Turtle op https://www.w3.org/ns/odrl/2/ODRL22.ttl (de term-IRI's zelf
# resolven met content negotiation).
# De actiehiërarchie (skos:broader) volgt odrl:includedIn.
# =============================================================================

odrl:use a skos:Concept ;
    skos:prefLabel "gebruiken"@nl ;
    skos:definition "De asset op enigerlei wijze gebruiken; de algemene actie waar de overige acties van dit profiel onder vallen."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-use> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:read a skos:Concept ;
    skos:prefLabel "raadplegen"@nl ;
    skos:definition "Gegevens uit de asset verkrijgen zonder deze te wijzigen."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-read> ;
    skos:inScheme apnl: ; skos:broader odrl:use .

odrl:distribute a skos:Concept ;
    skos:prefLabel "verstrekken"@nl ;
    skos:definition "De asset of kopieën daarvan aan derden beschikbaar stellen."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-distribute> ;
    skos:inScheme apnl: ; skos:broader odrl:use .

odrl:inform a skos:Concept ;
    skos:prefLabel "informeren"@nl ;
    skos:definition "Een partij in kennis stellen van een gebruik van de asset (plicht-actie, o.a. de inlichtingenplicht)."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-inform> ;
    skos:inScheme apnl: ; skos:broader odrl:use .

odrl:purpose a skos:Concept ;
    skos:prefLabel "doelbinding"@nl ;
    skos:definition "Left operand: het doel waarvoor de verwerking plaatsvindt (de rightOperand is een verwerkingsdoel)."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-purpose> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:dateTime a skos:Concept ;
    skos:prefLabel "datum en tijd"@nl ;
    skos:definition "Left operand: het tijdstip van evaluatie; gebruikt voor tijdvensters (geldig vanaf/tot)."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-dateTime> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:deliveryChannel a skos:Concept ;
    skos:prefLabel "verstrekkingskanaal"@nl ;
    skos:definition "Left operand: het kanaal waarlangs de asset wordt geleverd of geraadpleegd."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-deliveryChannel> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:eq a skos:Concept ;
    skos:prefLabel "is gelijk aan"@nl ;
    skos:definition "Operator: de left operand is exact gelijk aan de right operand."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-eq> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:isA a skos:Concept ;
    skos:prefLabel "is een"@nl ;
    skos:definition "Operator: de left operand is een instantie of verbijzondering van de right operand (taxonomische match, o.a. de DPV-doelhiërarchie)."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-isA> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:isAnyOf a skos:Concept ;
    skos:prefLabel "is een van"@nl ;
    skos:definition "Operator: de left operand komt voor in de waardenlijst van de right operand."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-isAnyOf> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:gteq a skos:Concept ;
    skos:prefLabel "groter dan of gelijk aan"@nl ;
    skos:definition "Operator: de left operand is groter dan of gelijk aan de right operand (o.a. begin van een tijdvenster)."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-gteq> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

odrl:lteq a skos:Concept ;
    skos:prefLabel "kleiner dan of gelijk aan"@nl ;
    skos:definition "Operator: de left operand is kleiner dan of gelijk aan de right operand (o.a. einde van een tijdvenster)."@nl ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-lteq> ;
    skos:inScheme apnl: ; skos:topConceptOf apnl: .

# Brondocument-beschrijvingen (NL-SBB: een bron draagt een naam).
<https://www.w3.org/TR/odrl-vocab/#term-use> dct:title "ODRL Vocabulary & Expression 2.2: use"@en .
<https://www.w3.org/TR/odrl-vocab/#term-read> dct:title "ODRL Vocabulary & Expression 2.2: read"@en .
<https://www.w3.org/TR/odrl-vocab/#term-distribute> dct:title "ODRL Vocabulary & Expression 2.2: distribute"@en .
<https://www.w3.org/TR/odrl-vocab/#term-inform> dct:title "ODRL Vocabulary & Expression 2.2: inform"@en .
<https://www.w3.org/TR/odrl-vocab/#term-purpose> dct:title "ODRL Vocabulary & Expression 2.2: purpose"@en .
<https://www.w3.org/TR/odrl-vocab/#term-dateTime> dct:title "ODRL Vocabulary & Expression 2.2: dateTime"@en .
<https://www.w3.org/TR/odrl-vocab/#term-deliveryChannel> dct:title "ODRL Vocabulary & Expression 2.2: deliveryChannel"@en .
<https://www.w3.org/TR/odrl-vocab/#term-eq> dct:title "ODRL Vocabulary & Expression 2.2: eq"@en .
<https://www.w3.org/TR/odrl-vocab/#term-isA> dct:title "ODRL Vocabulary & Expression 2.2: isA"@en .
<https://www.w3.org/TR/odrl-vocab/#term-isAnyOf> dct:title "ODRL Vocabulary & Expression 2.2: isAnyOf"@en .
<https://www.w3.org/TR/odrl-vocab/#term-gteq> dct:title "ODRL Vocabulary & Expression 2.2: gteq"@en .
<https://www.w3.org/TR/odrl-vocab/#term-lteq> dct:title "ODRL Vocabulary & Expression 2.2: lteq"@en .

# =============================================================================
# 6. SKOS-Collections per termsoort (Profile Best Practices §6)
#
# De collecties bevatten zowel de door dit profiel GEDEFINIEERDE termen als de
# uit ODRL 2.2 OVERGENOMEN kerntermen. Daarmee is machineleesbaar welke
# deelverzameling van ODRL een NL-evaluator moet kennen (ODRL 2.2 §3.2).
# Domeinprofielen (zoals ODRL-BRP) breiden deze collecties uit met eigen
# acties, operatoren en left operands.
# =============================================================================

apnl:TermenCollectie a skos:Collection ;
    skos:prefLabel "ODRL-AP-NL: alle profieltermen"@nl ;
    skos:definition "Alle door ODRL-AP-NL gedefinieerde en overgenomen termen."@nl ;
    skos:member
        # gedefinieerd
        apnl:PolicyArtifact , apnl:RegoModule , apnl:CedarPolicySet ,
        apnl:OpenFGAModel , apnl:PolicyBundle ,
        apnl:bundles , apnl:entrypoint , apnl:sha256 ,
        apnl:verwerkingsverzoek , apnl:rolAanvrager , apnl:conformsToPolicy ,
        apnl:doelbindingsverwijzing ,
        # overgenomen (zie de deelcollecties hieronder)
        dpv:Purpose ,
        odrl:read , odrl:use , odrl:distribute , odrl:inform ,
        odrl:purpose , odrl:dateTime , odrl:deliveryChannel ,
        odrl:eq , odrl:isA , odrl:isAnyOf , odrl:gteq , odrl:lteq .

apnl:ActieCollectie a skos:Collection ;
    skos:prefLabel "ODRL-AP-NL: acties"@nl ;
    skos:definition """De ODRL-kernacties die dit profiel overneemt. Het profiel
definieert géén eigen acties; domeinprofielen (zoals ODRL-BRP met de
verstrekkingsvormen) voegen de hunne toe als odrl:Action met odrl:includedIn."""@nl ;
    skos:member odrl:read , odrl:use , odrl:distribute , odrl:inform .

apnl:LeftOperandCollectie a skos:Collection ;
    skos:prefLabel "ODRL-AP-NL: left operands"@nl ;
    skos:definition """De left operands van dit profiel: de profieleigen
apnl:verwerkingsverzoek en apnl:rolAanvrager (rolgebonden toegang) plus de
overgenomen kerntermen odrl:purpose (doelbinding), odrl:dateTime
(tijdvensters) en odrl:deliveryChannel (verstrekkingskanaal)."""@nl ;
    skos:member apnl:verwerkingsverzoek , apnl:rolAanvrager , odrl:purpose ,
        odrl:dateTime , odrl:deliveryChannel .

apnl:OperatorCollectie a skos:Collection ;
    skos:prefLabel "ODRL-AP-NL: operatoren"@nl ;
    skos:definition """De operatoren van dit profiel: het profieleigen
apnl:conformsToPolicy plus de overgenomen kerntermen odrl:eq (exacte match),
odrl:isA (taxonomische match, o.a. DPV-doelhiërarchie), odrl:isAnyOf
(waardenlijst) en odrl:gteq/odrl:lteq (tijdvensters)."""@nl ;
    skos:member apnl:conformsToPolicy , odrl:eq , odrl:isA , odrl:isAnyOf ,
        odrl:gteq , odrl:lteq .
