    mim:definitie "Beide partijen hebben de overeenkomst akkoord verklaard en zij is van kracht."@nl ;
    mim:code "akkoord" ;
    mim:datumOpname "2026-09-14"^^xsd:date .

vlmim:enumeratiewaarde-status-opgeschort a mim:Enumeratiewaarde ;
