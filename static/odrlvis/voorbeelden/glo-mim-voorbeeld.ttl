    mim:identificatie "https://vlierdam.example/mim/enumeratiewaarde-status-opgeschort"^^xsd:anyURI ;
    mim:naam "opgeschort"@nl ;
    mim:definitie "De levering is tijdelijk stilgelegd; de overeenkomst blijft bestaan."@nl ;
    mim:code "opgeschort" ;
    mim:datumOpname "2026-09-14"^^xsd:date .

vlmim:enumeratiewaarde-status-opgezegd a mim:Enumeratiewaarde ;
    rdfs:label "opgezegd"@nl , "terminated"@en ;
    mim:identificatie "https://vlierdam.example/mim/enumeratiewaarde-status-opgezegd"^^xsd:anyURI ;
    mim:naam "opgezegd"@nl ;
    mim:definitie "Een van beide partijen heeft de overeenkomst beëindigd voor het einde van haar looptijd."@nl ;
    mim:code "opgezegd" ;
    mim:datumOpname "2026-09-14"^^xsd:date .

vlmim:enumeratiewaarde-status-verlopen a mim:Enumeratiewaarde ;
    rdfs:label "verlopen"@nl , "expired"@en ;
    mim:identificatie "https://vlierdam.example/mim/enumeratiewaarde-status-verlopen"^^xsd:anyURI ;
    mim:naam "verlopen"@nl ;
    mim:definitie "De looptijd van de overeenkomst is verstreken zonder verlenging."@nl ;
    mim:code "verlopen" ;
    mim:datumOpname "2026-09-14"^^xsd:date .

vlmim:attribuutsoort-ingangsdatum a mim:Attribuutsoort ;
    rdfs:label "ingangsdatum"@nl , "start date"@en ;
    mim:identificatie "https://vlierdam.example/mim/attribuutsoort-ingangsdatum"^^xsd:anyURI ;
    mim:naam "ingangsdatum"@nl ;
    mim:definitie "De datum waarop de levering op grond van de overeenkomst mag beginnen."@nl ;
    mim:herkomst "Overeenkomstenadministratie gegevensdeling"@nl ;
    mim:herkomstDefinitie "Model gegevensleveringsovereenkomst v2"@nl ;
    mim:datumOpname "2026-09-14"^^xsd:date ;
    mim:type vlmim:datatype-kalenderdatum ;
    mim:kardinaliteit "1..1" ;
    mim:identificerend false ;
    mim:authentiek mim:OverigeAuthenticiteit ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:mogelijkGeenWaarde false ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:indicatieFormeleHistorie false .

