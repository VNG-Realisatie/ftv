        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAARLANGS — de machine-uitvoerbare toets: het verwerkingsverzoek moet voldoen aan de module die deze regels afdwingt. De module verklaart zelf (prov:wasDerivedFrom, zie proef-dekking-breda.ttl) welke regels zij uitwerkt."@nl ;
            odrl:leftOperand apnl:verwerkingsverzoek ;
