apovk:075801-v1 a prov:Entity, odrl:Agreement;
    dct:title "Gemeente Breda/Burgerzakentaken"@nl;
    odrl:assignee brpafn:075801;
    odrl:uid apovk:075801-v1;
    dct:issued "1994-05-01"^^xsd:date;
