apper:510149-v11-r-belastingen-belastingplichtige-adhoc a odrl:Permission ;
    odrl:uid apper:510149-v11-r-belastingen-belastingplichtige-adhoc ;
    dct:title "Belastingplichtige — verstrekking op verzoek"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    dpv:hasLegalBasis <https://wetten.overheid.nl/BWBR0005416> ;
    prov:hadPrimarySource <https://zoek.officielebekendmakingen.nl/stcrt-2018-42653.html> ;
    rdfs:comment "Grondslag in het besluit: artikel 5, tweede lid, onder a — \"De gemeente verzoekt slechts om een gegeven dat is opgenomen in bijlage 2 bij dit besluit indien het verzoek gericht is op het verkrijgen van gegevens over: een persoon ten aanzien van wie de gemeente belasting heft of invordert op grond van titel IV, hoofdstuk XV van de Gemeentewet, voor zover de gemeente deze bevoegdheid niet heeft gedelegeerd\"."@nl ;
    skos:editorialNote "Cel uit Modelautorisatiebesluit Model 1 (Stcrt. 2018, 42653), het besluitdocument achter deze versie (Breda per 1-8-2018, kenmerk 2018-0000285775). De bijlage die het artikel aanwijst is niet gematerialiseerd; als doelwit staat de Tabel-35-gegevensset van deze versie. Een WAARLANGS-refinement ontbreekt: een machine-uitvoerbare laag bestond in 2018 niet."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de taak waarvoor het besluit de verstrekking toestaat."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:gemeentelijke-belastingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; geen aparte bevoegdheid maar een uitvoeringsvorm van dezelfde systematische verstrekking."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhoc ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit het besluit en de Matrix."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:belastingplichtige ] ] ;
    odrl:target apset:510149-v11-adhoc .

