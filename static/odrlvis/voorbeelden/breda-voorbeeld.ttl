apovk:520149-v1 a odrl:Agreement;
    dct:title "[PROEF] Gemeente Breda/Uitgifte reisdocumenten niet-ingezetenen"@nl;
    odrl:assignee brpafn:520149;
    odrl:uid apovk:520149-v1;
    dct:identifier "2022-0000408025";
    dct:issued "2022-09-01"^^xsd:date;
    odrl:permission apper:520149-v1-adhoc-d001;
    prov:specializationOf apovk:520149;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking, apvz:2022-0000375797, apdoc:2022-0000408025, brpaut:520149-v1, <https://publicaties.rvig.nl/sites/default/files/Besluit/Grensgemeenten/520149%20Autorisatiebesluit%20Gemeente%20Breda%20RAP.pdf>, <https://publicaties.rvig.nl/zoekpagina-tabel-35-autorisatietabel?code=520149&sector=All&pubdate_op=%3E%3D&most_recent=1>;
    schema:validFrom "2022-09-01"^^xsd:date;
    dct:description "Regelt de systematische verstrekking van BRP-gegevens aan Gemeente Breda/Uitgifte reisdocumenten niet-ingezetenen voor één doel, via verstrekking op verzoek. Vastgesteld door de Rijksdienst voor Identiteitsgegevens (RvIG) namens de staatssecretaris van BZK; afnemersindicatie 520149, besluitversie 1, met ingang van 2022-09-01."@nl;
    skos:editorialNote "Modelnotitie: de doel-permissions verwijzen per kanaal naar de volledige rubriekenset van de autorisatietabelregel; doelspecifieke gegevenssets (bijlage-join) zijn een vervolgstap. Doelbindingen ontleend aan 1 besluit-PDF('s) van publicaties.rvig.nl (zie prov:wasDerivedFrom en rapport/transformatie-rapport.md). Documentkenmerk van het besluit: 2022-0000408025."@nl;
    dct:publisher oorg:oorg10103;
    odrl:assigner oorg:oorg10103;
    odrl:obligation apaanbod:duty-inlichtingenplicht, apaanbod:duty-geheimhouding, apaanbod:duty-protocollering, apaanbod:duty-aansluitvoorwaarden;
    odrl:profile apnl:profiel.

