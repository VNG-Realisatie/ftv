_:n3-299 rdf:value brp:adHocVerstrekking;
    odrl:refinement _:n3-300, [ a odrl:Constraint ;
        rdfs:comment "OVER WIE — de doelgroep uit het besluit: artikel 3, tweede lid — \"De grensgemeente verzoekt slechts om een gegeven dat is opgenomen in bijlage I bij dit besluit indien het verzoek gericht is op het verkrijgen van gegevens over een ingeschrevene die bij de grensgemeente een aanvraag indient of namens wie een dergelijke aanvraag wordt ingediend, en de verstrekking van gegevens noodzakelijk is voor het in ontvangst nemen en beoordelen van deze aanvraag\"."@nl ;
        odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
        odrl:operator odrl:eq ;
        odrl:rightOperand apdg:aanvrager-reisdocument ].

apdg:aanvrager-reisdocument a skos:Concept ;
    skos:prefLabel "aanvrager van een reisdocument"@nl ;
    skos:definition "De ingeschrevene die bij de grensgemeente een aanvraag voor een reisdocument indient of namens wie een dergelijke aanvraag wordt ingediend (begripsbepaling onder q van het RAP-besluit)."@nl ;
    skos:inScheme apdg: ;
    dct:source <https://publicaties.rvig.nl/sites/default/files/Besluit/Grensgemeenten/520149%20Autorisatiebesluit%20Gemeente%20Breda%20RAP.pdf> .

