##############################################################################
# UITTREKSEL DOELBINDINGEN 075801-v6 (Burgerzakentaken) — twee cellen uit de
# Aanvullende toelichting autorisatie gemeenten (RvIG), taken 1.27 en 1.29.
##############################################################################

apper:075801-v6-r-burgerlijke-stand-adhoc a odrl:Permission ;
    odrl:uid apper:075801-v6-r-burgerlijke-stand-adhoc ;
    dct:title "Akten burgerlijke stand — verstrekking op verzoek"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/2025-05/Aanvullende%20toelichting%20autorisatie%20gemeenten.pdf> ;
    rdfs:comment "Taakomschrijving in de toelichting (1.29 Burgerlijke stand): \"Voor het opnemen van aktes in registers van de burgerlijke stand als bedoeld in artikel 16a, 17, 18, tweede lid, van Boek 1 van het Burgerlijk Wetboek en het toevoegen van latere vermeldingen in deze registers als bedoeld in artikel 16a, 24 en 24a van Boek 1 van het Burgerlijk Wetboek door de ambtenaren van de burgerlijke stand als bedoeld in artikel 16 van Boek 1 van het Burgerlijk Wetboek, zijn de gegevens uit de Basisregistratie Personen nodig.\""@nl ;
    skos:editorialNote "Cel uit de Aanvullende toelichting autorisatie gemeenten (RvIG, mei 2025) — het door RvIG gepubliceerde taken- en doelbindingenoverzicht bij de gemeentelijke autorisaties; voor Burgerzakentaken is dit de gevonden doelbindingsbron (een los besluitdocument is er niet). De rubrieken per taak zijn niet uitgesplitst; als doelwit staat de Tabel-35-gegevensset van deze versie. Een WAARLANGS-refinement ontbreekt."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de burgerzakentaak waarvoor de toelichting de verstrekking beschrijft."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:burgerlijke-stand ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; de tabelregel van deze versie autoriseert alleen verstrekking op verzoek."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhoc ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit de toelichting."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:persoon-akte-burgerlijke-stand ] ] ;
    odrl:target apset:075801-v6-adhoc .

apper:075801-v6-r-volmacht-verkiezingen-adhoc a odrl:Permission ;
    odrl:uid apper:075801-v6-r-volmacht-verkiezingen-adhoc ;
    dct:title "Volmachtverlening verkiezingen — verstrekking op verzoek"@nl ;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking ;
    prov:hadPrimarySource <https://publicaties.rvig.nl/sites/default/files/2025-05/Aanvullende%20toelichting%20autorisatie%20gemeenten.pdf> ;
    rdfs:comment "Taakomschrijving in de toelichting (1.27 Volmachtverlening verkiezingen): \"Voor het behandelen van een schriftelijk verzoek om bij volmacht te stemmen als bedoeld in artikel L8 van de Kieswet, zijn de gegevens uit de Basisregistratie Personen nodig.\""@nl ;
    skos:editorialNote "Cel uit de Aanvullende toelichting autorisatie gemeenten (RvIG, mei 2025) — het door RvIG gepubliceerde taken- en doelbindingenoverzicht bij de gemeentelijke autorisaties; voor Burgerzakentaken is dit de gevonden doelbindingsbron (een los besluitdocument is er niet). De rubrieken per taak zijn niet uitgesplitst; als doelwit staat de Tabel-35-gegevensset van deze versie. Een WAARLANGS-refinement ontbreekt."@nl ;
    odrl:action [ rdf:value odrl:distribute ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "WAAROM — de burgerzakentaak waarvoor de toelichting de verstrekking beschrijft."@nl ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdoel:volmachtverlening-verkiezingen ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "HOE — het koppelvlak; de tabelregel van deze versie autoriseert alleen verstrekking op verzoek."@nl ;
            odrl:leftOperand odrl:deliveryChannel ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apkan:adhoc ] ;
        odrl:refinement [ a odrl:Constraint ;
            rdfs:comment "OVER WIE — de doelgroep uit de toelichting."@nl ;
            odrl:leftOperand apaanbod:doelgroepVanIngeschrevene ;
            odrl:operator odrl:eq ;
            odrl:rightOperand apdg:gemachtigde-volmacht ] ] ;
    odrl:target apset:075801-v6-adhoc .

apdoel:volmachtverlening-verkiezingen a skos:Concept, apnl:Verwerkingsdoel ;
    dct:title "Volmachtverlening verkiezingen"@nl ;
    rdfs:label "Volmachtverlening verkiezingen"@nl ;
    skos:prefLabel "Volmachtverlening verkiezingen"@nl ;
    dct:source <https://wetten.overheid.nl/BWBR0004627> ;
    skos:inScheme apdoel:register .

apdg:gemachtigde-volmacht a skos:Concept ;
    skos:prefLabel "gemachtigde"@nl ;
    skos:definition "De kiezer die door een volmachtverlener is gemachtigd om bij volmacht te stemmen (artikel L8 Kieswet); de gemeente controleert diens gegevens in de BRP."@nl ;
    skos:inScheme apdg: ;
    dct:source <https://publicaties.rvig.nl/sites/default/files/2025-05/Aanvullende%20toelichting%20autorisatie%20gemeenten.pdf> .

