odrl:distribute a skos:Concept;
    skos:prefLabel "verstrekken"@nl;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-distribute>;
    skos:broader odrl:use;
    skos:inScheme <https://standaarden.overheid.nl/odrl-ap-nl/>;
    skos:definition "De asset of kopieën daarvan aan derden beschikbaar stellen."@nl.

odrl:use a skos:Concept;
    skos:prefLabel "gebruiken"@nl.

brp:sleutelrubriek a <http://www.w3.org/2002/07/owl#ObjectProperty>;
    rdfs:label "Sleutelrubriek"@nl.

brp:SpontaanPlaatsingAfnemersindicatie a brp:ConditioneleVerstrekking;
    rdfs:label "Automatisch afnemersindicatie plaatsen"@nl.

brp:afnemersindicatie a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
    rdfs:label "Afnemersindicatie"@nl.

brp:conditioneleVerstrekking a <http://www.w3.org/2002/07/owl#ObjectProperty>;
    rdfs:label "Conditionele verstrekking"@nl.

apper:510149-v12-spontaan a odrl:Permission;
    dct:title "Spontane verstrekking"@nl;
    odrl:uid apper:510149-v12-spontaan;
    brp:medium brp:MediumNetwerk;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking, brpaut:510149-v12;
    odrl:action brp:spontaneVerstrekking;
    odrl:target apset:510149-v12-spontaan;
    skos:editorialNote "Regelinhoud van deze vervallen besluitversie, overgenomen uit haar eigen regel in de autorisatietabel (Tabel 35). De kanalen, rubrieken, voorwaarderegels en verstrekkingskenmerken zijn dus die van tóén, niet die van de geldende versie. Wat ontbreekt is de DOELBINDING: doelen staan alleen in het besluitdocument van destijds en zijn voor vervallen versies niet beschikbaar — deze permissions zijn kanaal-permissions zonder odrl:purpose-refinement."@nl;
    brp:conditioneleVerstrekking brp:SpontaanPlaatsingAfnemersindicatie.

apcon:510149-v12-selectie-c1 a odrl:LogicalConstraint;
    rdfs:label "Voorwaarde autorisatiebesluit 510149, versie 12 (selectieverstrekking)"@nl;
    brp:voorwaarderegel "KNV 06.08.10 ENVWD (16.09.10 GA1 0758) ENVWD (KNV 16.18.10 OFVWD (16.18.10 GD1 19.89.20 - 00000000))";
    prov:wasDerivedFrom brpaut:510149-v12;
    odrl:and _:n3-282.

_:n3-283 a odrl:Constraint;
    rdfs:comment "Datum overlijden is niet aanwezig"@nl;
    odrl:leftOperand brprub:datumOverlijdenOverlijden;
    odrl:operator brp:knv.

_:n3-285 a odrl:Constraint;
    rdfs:comment "Gemeente van inschrijving gelijk aan 0758"@nl;
    odrl:leftOperand brprub:gemeenteVanInschrijvingTijdelijkVerblijf;
    odrl:operator brp:ga1;
    odrl:rightOperand "0758".

_:n3-287 a odrl:LogicalConstraint;
    odrl:or _:n3-288.

_:n3-289 a odrl:Constraint;
    rdfs:comment "Einddatum geldigheid is niet aanwezig"@nl;
    odrl:leftOperand brprub:einddatumGeldigheidTijdelijkVerblijf;
    odrl:operator brp:knv.

_:n3-291 a odrl:Constraint;
    rdfs:comment "Einddatum geldigheid groter dan Selectiedatum − 0 dagen"@nl;
    odrl:leftOperand brprub:einddatumGeldigheidTijdelijkVerblijf;
    odrl:operator brp:gd1;
    odrl:rightOperand "P0D"^^xsd:duration;
    odrl:rightOperandReference brprub:selectiedatumSysteem.

apper:510149-v12-selectie a odrl:Permission;
    dct:title "Selectieverstrekking"@nl;
    odrl:uid apper:510149-v12-selectie;
    brp:berichtaanduiding brp:BerichtaanduidingVulbericht;
    brp:medium brp:MediumAnders;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking, brpaut:510149-v12;
    odrl:action _:n3-292;
    odrl:target apset:510149-v12-selectie;
    odrl:constraint apcon:510149-v12-selectie-c1;
    skos:editorialNote "Regelinhoud van deze vervallen besluitversie, overgenomen uit haar eigen regel in de autorisatietabel (Tabel 35). De kanalen, rubrieken, voorwaarderegels en verstrekkingskenmerken zijn dus die van tóén, niet die van de geldende versie. Wat ontbreekt is de DOELBINDING: doelen staan alleen in het besluitdocument van destijds en zijn voor vervallen versies niet beschikbaar — deze permissions zijn kanaal-permissions zonder odrl:purpose-refinement."@nl.

_:n3-293 a odrl:Constraint;
    rdfs:comment "Selectie wordt elke 3 maanden herhaald"@nl;
    odrl:leftOperand odrl:timeInterval;
    odrl:operator odrl:eq;
    odrl:rightOperand "P3M"^^xsd:duration.

_:n3-294 a odrl:Constraint;
    rdfs:comment "Selectie mag pas vanaf deze datum"@nl;
    odrl:leftOperand odrl:dateTime;
    odrl:operator odrl:gteq;
    odrl:rightOperand "2024-09-12"^^xsd:date.

brp:adresVraag a odrl:Action;
    rdfs:label "Adresvraag"@nl;
    rdfs:comment "De afnemer mag gegevens opvragen van alle ingeschrevenen op een\nbepaald adres. Dit is een variant van brp:adHocVerstrekking waarbij gezocht\nwordt op adreskenmerken in plaats van op persoonskenmerken."@nl;
    rdfs:seeAlso <https://www.rvig.nl/sites/default/files/2024-12/Logisch%20Ontwerp%20BRP%202025.Q1.pdf#search=Adresvraagbevoegdheid>, brp:adHocVerstrekking;
    odrl:includedIn brp:adHocVerstrekking.

brp:adHocVerstrekking a odrl:Action;
    rdfs:label "Ad hoc gegevensverstrekking"@nl;
    rdfs:comment "Verstrekking op verzoek van de afnemer. De afnemer stuurt een\nzoekvraag (bijv. op BSN, naam+geboortedatum, of adres) en ontvangt de\ngeautoriseerde rubrieken van PL'en die aan de brp:voorwaarderegel voldoen.\nDit is het koppelvlak dat door de HaalCentraal BRP Bevragen API wordt\ngeimplementeerd."@nl;
    rdfs:seeAlso brp:adHocPlaatsing, brp:voorwaarderegel, brp:adresVraag, <https://www.rvig.nl/sites/default/files/2024-12/Logisch%20Ontwerp%20BRP%202025.Q1.pdf#search=Ad%20hoc%20gegevensverstrekking>;
    odrl:includedIn odrl:distribute.

apper:510149-v12-adhoc a odrl:Permission;
    dct:title "Verstrekking op verzoek"@nl;
    odrl:uid apper:510149-v12-adhoc;
    brp:medium brp:MediumNetwerk;
    prov:wasDerivedFrom apaanbod:systematischeVerstrekking, brpaut:510149-v12;
    odrl:action brp:adHocPlaatsing, brp:adresVraag, brp:adHocVerstrekking;
    odrl:target apset:510149-v12-adhoc;
    skos:editorialNote "Regelinhoud van deze vervallen besluitversie, overgenomen uit haar eigen regel in de autorisatietabel (Tabel 35). De kanalen, rubrieken, voorwaarderegels en verstrekkingskenmerken zijn dus die van tóén, niet die van de geldende versie. Wat ontbreekt is de DOELBINDING: doelen staan alleen in het besluitdocument van destijds en zijn voor vervallen versies niet beschikbaar — deze permissions zijn kanaal-permissions zonder odrl:purpose-refinement."@nl.

apper:verzoek-2022-0000375797 a odrl:Permission;
    dct:title "Verstrekking uit de basisregistratie personen"@nl;
    odrl:assignee brpafn:520149;
    odrl:uid apper:verzoek-2022-0000375797;
    rdfs:comment "Minimale regel van het verzoek: verstrekking uit de BRP aan de indiener. Kanaal, gegevens en doel zijn niet uit de besluittekst af te leiden en worden niet geclaimd."@nl;
    odrl:action odrl:distribute;
    odrl:target apb:gbav.

brpafn:520149 a brp:Afnemer;
    rdfs:label "Gemeente Breda/Uitgifte reisdocumenten niet-ingezetenen"@nl.

apset:520149-v1-adhoc a odrl:AssetCollection;
    dct:title "Gegevensset Gemeente Breda/Uitgifte reisdocumenten niet-ingezetenen — verstrekking op verzoek"@nl;
    prov:wasDerivedFrom brpaut:520149-v1;
    dct:description "De gegevens die Gemeente Breda/Uitgifte reisdocumenten niet-ingezetenen via verstrekking op verzoek mag ontvangen, volgens autorisatietabelregel 520149 (Tabel 35)."@nl;
    skos:editorialNote "Kanaalbrede rubriekenset, niet per doel uitgesplitst; de doelspecifieke inperking (bijlage-join uit de besluit-PDF) is een vervolgstap."@nl.

