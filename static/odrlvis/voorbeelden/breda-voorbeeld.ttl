brp:spontaneVerstrekking a odrl:Action;
    rdfs:label "Spontane gegevensverstrekking"@nl;
    rdfs:comment "Push-gebaseerde verstrekking van persoonsgegevens. Wanneer een\nof meer brp:sleutelrubriek elementen op een persoonslijst (PL) wijzigen, en de\nPL voldoet aan de brp:voorwaarderegel van de afnemer, worden automatisch\ngegevens verstrekt.\n\nAfhankelijk van de instelling (brp:conditioneleVerstrekking) wordt ofwel\nautomatisch een afnemersindicatie op de PL geplaatst, ofwel een conditioneel\ngegevensbericht verstuurd."@nl;
    rdfs:seeAlso brp:voorwaarderegel, brp:sleutelrubriek, brp:conditioneleVerstrekking, <https://www.rvig.nl/sites/default/files/2024-12/Logisch%20Ontwerp%20BRP%202025.Q1.pdf#search=Spontane%20gegevensverstrekking>;
    odrl:includedIn odrl:distribute.

brp:selectieGegevensVerstrekking a odrl:Action;
    rdfs:label "Selectie: gegevensverstrekking"@nl;
    rdfs:comment "Gegevens van alle persoonslijsten die aan de brp:voorwaarderegel\nvoldoen worden geselecteerd en verstrekt aan de brp:Afnemer."@nl;
    odrl:includedIn brp:selectieVerstrekking.

brprub:selectiedatumSysteem a odrl:Asset, brp:Rubriek;
